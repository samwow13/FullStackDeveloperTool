<Window x:Class="FullStackLauncher.GitCommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commit all &amp; push" Width="700" Height="560" MinWidth="480" MinHeight="440"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Icon="/Assets/launcher.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,18">
            <TextBlock x:Name="BranchRoute" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                       AutomationProperties.Name="Branch and push destination"/>
        </ScrollViewer>
        <StackPanel x:Name="DestinationEditor" Grid.Row="1" Margin="0,0,0,12">
            <Label Content="Destination _branch" Target="{Binding ElementName=TargetBranchBox}"
                   Foreground="{StaticResource TextBrush}" Padding="0,0,0,6"/>
            <TextBox x:Name="TargetBranchBox" MaxLength="240" TextChanged="TargetBranch_Changed"
                     HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Destination branch"/>
        </StackPanel>
        <ScrollViewer x:Name="ReviewDetails" Grid.Row="2" MaxHeight="100" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="RecoveryText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FFD391" Margin="0,0,0,8"/>
                <TextBlock x:Name="ActionDetails" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="Validation" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FFACA9"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="MessageValidation" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FFACA9"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <Label x:Name="MessageLabel" Grid.Row="3" Content="Commit _message" Target="{Binding ElementName=MessageBox}"
               Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" Padding="0,0,0,10"/>
        <TextBox x:Name="MessageBox" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                 Padding="12" VerticalScrollBarVisibility="Auto" TextChanged="Message_Changed"
                 AutomationProperties.Name="Commit message"/>
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageLength" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,8,0"
                       AutomationProperties.Name="Commit message character count" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Cancel" IsCancel="True" Margin="12,0,10,0"/>
                <Button x:Name="Submit" Content="Commit all &amp; push" Click="Submit_Click"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
