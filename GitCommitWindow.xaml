<Window x:Class="FullStackLauncher.GitCommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commit and push" Width="700" Height="700" MinWidth="480" MinHeight="440"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Icon="/Assets/launcher.ico">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <TextBlock x:Name="Headline" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>
                <TextBlock x:Name="Introduction" TextWrapping="Wrap" Margin="0,0,0,17"/>
                <Border x:Name="RecoveryNotice" Visibility="Collapsed" Background="#302819" BorderBrush="#7E653A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,17">
                    <TextBlock x:Name="RecoveryText" TextWrapping="Wrap" Foreground="#FFD391"/>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Current branch" Style="{StaticResource Hint}" FontSize="12"/>
                        <TextBlock x:Name="CurrentBranch" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <StackPanel x:Name="CreationHistory">
                            <TextBlock Text="Last created branch · retained Git history" Style="{StaticResource Hint}" FontSize="12"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LastCreatedBranch" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="UseLastCreated" Grid.Column="1" Content="Use _last created" Click="UseLastCreated_Click" Padding="10,6" Visibility="Collapsed" ToolTip="Fill the destination with the last known created branch. Only the current branch or a new branch name can be used."/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="DestinationEditor">
                    <Label Content="Destination _branch" Target="{Binding ElementName=TargetBranchBox}"/>
                    <TextBox x:Name="TargetBranchBox" MaxLength="240" TextChanged="TargetBranch_Changed" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Destination branch"/>
                    <TextBlock Text="Use the current branch or enter a new branch name. Switching to another existing branch is not part of this action." Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel x:Name="DestinationReview" Visibility="Collapsed">
                    <TextBlock Text="Destination branch" Style="{StaticResource Hint}" FontSize="12"/>
                    <TextBlock x:Name="TargetBranchReview" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="Chosen in the Git workspace. Close this review to change the branch field." Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Validation" TextWrapping="Wrap" Foreground="#FFACA9" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="BranchPreview" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0"/>
                <TextBlock x:Name="Destination" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                <TextBlock x:Name="Repository" TextWrapping="Wrap" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,16"/>
                <Border Background="#172A29" BorderBrush="#346259" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <TextBlock x:Name="Scope" TextWrapping="Wrap"/>
                </Border>
                <Border x:Name="AgentSummaryNotice" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="AgentSummaryInfo" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Expander Header="Pending agent changes" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0">
                            <TextBlock x:Name="AgentSummaryText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </Expander>
                        <Button x:Name="UseAgentSummaries" Content="Use _agent summary message" Click="UseAgentSummaries_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <CheckBox x:Name="IncludeAgentSummaries" Content="These agent changes are included in this commit" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"
                                  Checked="IncludeAgentSummaries_Changed" Unchecked="IncludeAgentSummaries_Changed"/>
                        <TextBlock x:Name="AgentSummaryHint" Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MessageLength" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"
                           AutomationProperties.Name="Commit message character count" AutomationProperties.LiveSetting="Polite"/>
                <Expander x:Name="MessagePreview" Header="Review or edit commit _message" Foreground="{StaticResource TextBrush}" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <Label Content="Commit _message" Target="{Binding ElementName=MessageBox}"/>
                        <TextBox x:Name="MessageBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Message_Changed" AutomationProperties.Name="Commit message"/>
                        <TextBlock x:Name="MessageHint" Text="A message is already prepared. Once you edit it, changing the destination branch keeps your message." Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,0"/>
                        <TextBlock x:Name="MessageValidation" TextWrapping="Wrap" Foreground="#FFACA9" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="_Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="Submit" Content="Commit all &amp; push" Click="Submit_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
