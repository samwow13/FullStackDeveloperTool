<Window x:Class="FullStackLauncher.GitCommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commit all &amp; push" Width="620" Height="470" MinWidth="440" MinHeight="380"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner" Icon="/Assets/launcher.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Commit all &amp; push" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock x:Name="Destination" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                <TextBlock x:Name="Repository" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14"/>
                <Label Content="Commit _message" Target="{Binding ElementName=MessageBox}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,6"/>
                <TextBox x:Name="MessageBox" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                         VerticalScrollBarVisibility="Auto" TextChanged="Message_Changed" AutomationProperties.Name="Commit message"/>
                <TextBlock x:Name="Scope" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="Submit" Content="Commit all &amp; push" Click="Submit_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
