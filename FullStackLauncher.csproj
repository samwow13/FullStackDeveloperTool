<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FullStackLauncher</AssemblyName>
    <RootNamespace>FullStackLauncher</RootNamespace>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <RemoteCompanionPayloadDirectory>$(MSBuildProjectDirectory)\RemoteCompanion\publish\install-agent-payload</RemoteCompanionPayloadDirectory>
    <!-- Local data must never become implicit compile, resource, or content items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;artifacts\**;portable\**;publish\**;**\bin\**;**\obj\**;**\TestResults\**;**\node_modules\**;**\.git\**;**\.vs\**;**\monitor-runtime\**;**\api-runtime\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\.env;**\.env.*;**\secrets.json*;**\appsettings.Local.json*;**\appsettings.*.Local.json*;**\database-connections\**;**\database-connections*.dat*;**\api-secrets\**;**\api-secrets*.dat*;**\*.pfx;**\*.p12;**\*.key;**\*.pem</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\launcher*.json*;**\*.settings.json*;**\*.local.json*;**\*.settings.local.json;**\*.local.settings.json;**\*.json.bak;**\*.json.*.bak;**\*.json.*.tmp;**\codex-monitor.settings.json*;**\*.codex-crew-reset.json*;**\project-tasks.json*;**\*.project-tasks.json*;**\window-snip-targets.json*;**\*.window-snip-targets.json*</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\codex-reply-inbox.json*;**\*.codex-reply-inbox.json*;**\codex-agent-prompts.json*;**\*.codex-agent-prompts.json*;**\codex-agent-chats\**;**\*.codex-agent-chats\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\codex-project-associations.json*;**\*.codex-project-associations.json*</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\codex-agent-keep-awake\**;**\*.codex-agent-keep-awake\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\codex-agent-waiting\**;**\*.codex-agent-waiting\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\*.codex-crew-mute.json*;**\codex-crew-mute.dat*</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);RemoteCompanion\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\azure-devops-tokens\**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\dashboard-resume.dat*;**\*.dashboard-resume.dat*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Assets\launcher.ico" />
    <Resource Include="Assets\launcher.ico" />
    <None Update="CodexAlerts.cmd" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Include="launcher.settings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Remove="BrowserCaptureExtension\**" />
    <EmbeddedResource Include="BrowserCaptureExtension\manifest.json" LogicalName="FullStackLauncher.BrowserCaptureExtension.manifest.json" />
    <EmbeddedResource Include="BrowserCaptureExtension\background.js" LogicalName="FullStackLauncher.BrowserCaptureExtension.background.js" />
    <EmbeddedResource Include="BrowserCaptureExtension\options.html" LogicalName="FullStackLauncher.BrowserCaptureExtension.options.html" />
    <EmbeddedResource Include="BrowserCaptureExtension\options.js" LogicalName="FullStackLauncher.BrowserCaptureExtension.options.js" />
    <EmbeddedResource Include="BrowserCaptureExtension\README.md" LogicalName="FullStackLauncher.BrowserCaptureExtension.README.md" />
    <EmbeddedResource Include="$(RemoteCompanionPayloadDirectory)\FullStackRemoteCompanion.exe" LogicalName="FullStackLauncher.RemoteCompanion.exe" />
    <RemoteCompanionPayloadSource Include="RemoteCompanion\*.cs;RemoteCompanion\RemoteCompanion.csproj;CompanionProtocol\RemoteProtocol.cs;Services\WindowsUserSecretProtection.cs;Assets\launcher.ico" />
  </ItemGroup>
  <Target Name="PrepareRemoteCompanionPayload" BeforeTargets="PrepareResources"
          Inputs="@(RemoteCompanionPayloadSource)"
          Outputs="$(RemoteCompanionPayloadDirectory)\FullStackRemoteCompanion.exe">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\RemoteCompanion\RemoteCompanion.csproj&quot; --configuration $(Configuration) --runtime win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:PublishTrimmed=false -p:DebugType=None -p:DebugSymbols=false --output &quot;$(RemoteCompanionPayloadDirectory)&quot; --nologo" />
  </Target>
</Project>
