<Window x:Class="FullStackLauncher.ChangeDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change DB" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="720" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Loaded="Window_Loaded"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DatabaseHelp" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DatabaseLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="0,0,0,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DatabaseConnectionPicker" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="#111923" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemFrame" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemFrame" Property="Background" Value="#29374B" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemFrame" Property="Background" Value="#203C3B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PickerButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PickerFrame" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="3">
                                            <TextBlock Text="▾" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,8,32,8"
                                              VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="ServiceNameText" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="Local API configuration" Style="{StaticResource DatabaseHelp}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,5,0">
                    <Expander Header="API location" IsExpanded="False" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock x:Name="SourceFolderText" Style="{StaticResource DatabaseHelp}" />
                            <TextBlock x:Name="SourceProjectText" Style="{StaticResource DatabaseHelp}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Expander>
                    <StackPanel x:Name="EditorPanel" IsEnabled="False">
                        <Label Content="_Connection key" Target="{Binding ElementName=ConnectionKeyBox}" Style="{StaticResource DatabaseLabel}" />
                        <ComboBox x:Name="ConnectionKeyBox" SelectionChanged="ConnectionKey_SelectionChanged" Style="{StaticResource DatabaseConnectionPicker}"
                                  AutomationProperties.Name="Database connection configuration key" />
                        <TextBlock x:Name="ConnectionSourceText" Style="{StaticResource DatabaseHelp}" Margin="0,6,0,14"
                                   ToolTip="Uses standard .NET configuration. Custom providers are unsupported." />
                        <Label Content="_Database name" Target="{Binding ElementName=DatabaseNameBox}" Style="{StaticResource DatabaseLabel}" />
                        <TextBox x:Name="DatabaseNameBox" TextChanged="DatabaseName_TextChanged"
                                 AutomationProperties.Name="Database name" ToolTip="Changes only Database or Initial Catalog in the connection string." />
                        <TextBlock x:Name="DatabaseNameHint" Style="{StaticResource DatabaseHelp}" Margin="0,6,0,14"
                                   Text="Changing this name keeps the host, credentials and other connection options." />
                        <Label x:Name="ConnectionValueLabel" Content="Connection _string" Target="{Binding ElementName=ConnectionPasswordBox}"
                               Style="{StaticResource DatabaseLabel}" />
                        <PasswordBox x:Name="ConnectionPasswordBox" PasswordChanged="Connection_PasswordChanged" MinHeight="38"
                                     Foreground="{DynamicResource TextBrush}" Background="#111923"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="10,8"
                                     AutomationProperties.Name="Database connection string, masked" />
                        <TextBox x:Name="RevealedConnectionBox" Visibility="Collapsed" TextChanged="Connection_TextChanged"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="38" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Revealed database connection string" />
                        <CheckBox x:Name="RevealCheckBox" Content="_Reveal connection string" Foreground="{DynamicResource TextBrush}"
                                  Margin="0,9,0,14" Checked="Reveal_Changed" Unchecked="Reveal_Changed"
                                  AutomationProperties.Name="Reveal database connection string" />
                    </StackPanel>
                    <TextBlock x:Name="LegacyDisclosureText" Visibility="Collapsed" Style="{StaticResource DatabaseHelp}" Margin="0,0,0,12"
                               Text="Saving copies reviewed Local settings into encrypted launcher configuration. Original .NET user-secrets file remains unchanged and plaintext." />
                    <TextBlock Style="{StaticResource DatabaseHelp}"
                               Text="Save writes encrypted launcher Local configuration, restarts the API, then confirms the saved database setting was discovered. API source, appsettings and ordinary dotnet configuration stay unchanged. No database migration runs." />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
                <ProgressBar x:Name="OperationProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceBrush}"
                             AutomationProperties.Name="Database change operation in progress" />
                <TextBlock x:Name="StatusText" Style="{StaticResource DatabaseHelp}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ReloadButton" Content="Re_load" Click="Reload_Click" MinWidth="90" Margin="0,0,10,0"
                        AutomationProperties.Name="Reload Local database configuration" />
                <Button x:Name="CancelButton" Content="_Cancel" Click="Cancel_Click" MinWidth="90" Margin="0,0,10,0"
                        AutomationProperties.Name="Cancel database change" />
                <Button x:Name="SaveButton" Content="_Save &amp; restart" Click="Save_Click" MinWidth="150" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Save database connection and restart API" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
