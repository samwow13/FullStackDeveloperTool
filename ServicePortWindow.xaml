<Window x:Class="FullStackLauncher.ServicePortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change port" Icon="/Assets/launcher.ico"
        Width="460" MinWidth="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ServiceHeading" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label Content="_Port" Target="{Binding ElementName=PortBox}" Foreground="{StaticResource TextBrush}"
                   Padding="0,0,12,0" VerticalAlignment="Center"/>
            <TextBox x:Name="PortBox" Width="110" MaxLength="5" AutomationProperties.Name="Frontend port"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,12,0,14" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="_Cancel" Click="CancelClick" MinWidth="82" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="_Save" Click="SaveClick" IsDefault="True" MinWidth="82" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
