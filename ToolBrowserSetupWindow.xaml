<Window x:Class="FullStackLauncher.ToolBrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser login setup" Icon="pack://application:,,,/Assets/launcher.ico" Width="620" Height="420" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Browser login filling" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock Text="1. Open Chrome or Edge Extensions and enable Developer mode.&#10;2. Load unpacked using this folder, or reload your existing extension.&#10;3. In extension Options, save this pairing code.&#10;4. Pair one profile in the selected browser. Automatic requires one paired profile overall."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
                <Label Content="Extension folder" Foreground="{DynamicResource MutedBrush}" Padding="0"/>
                <TextBox x:Name="FolderText" IsReadOnly="True" Margin="0,6,0,8" AutomationProperties.Name="Browser extension folder"/>
                <Button Content="Open folder" Click="OpenFolder_Click" HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,14"/>
                <Label Content="Pairing code" Foreground="{DynamicResource MutedBrush}" Padding="0"/>
                <TextBox x:Name="PairingCodeText" IsReadOnly="True" Margin="0,6,0,8" AutomationProperties.Name="Private browser pairing code"/>
                <Button Content="Copy pairing code" Click="CopyCode_Click" HorizontalAlignment="Left" Padding="10,6"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="Close" IsCancel="True" IsDefault="True" MinWidth="90" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </Grid>
</Window>
