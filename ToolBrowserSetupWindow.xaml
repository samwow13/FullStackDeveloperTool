<Window x:Class="FullStackLauncher.ToolBrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser extension setup" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="650" Height="620" MinWidth="470" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/SetupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Connect your browser" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Set up a Chrome or Edge profile for browser source capture, frontend links, and saved login filling."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14"/>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,16">
                    <TextBlock x:Name="ConnectionStatusText" Text="Preparing browser extension…" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" AutomationProperties.LiveSetting="Polite"/>
                </Border>
                <Label Content="_Browser" Target="{Binding ElementName=BrowserPicker}" Padding="0"
                       Foreground="{DynamicResource MutedBrush}"/>
                <ComboBox x:Name="BrowserPicker" DisplayMemberPath="Name" SelectionChanged="BrowserPicker_SelectionChanged"
                          Margin="0,6,0,4" MaxWidth="330" HorizontalAlignment="Left" MinWidth="245"
                          Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Browser for extension setup"/>
                <TextBlock x:Name="BrowserHelpText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
                <TextBlock Text="1. Load the extension" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Open Extensions, turn on Developer mode, then choose Load unpacked and paste the copied folder. If already installed, click its Reload button."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,9"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button x:Name="OpenExtensionsButton" Content="Open _Extensions" Click="OpenExtensions_Click"
                            IsEnabled="False" Padding="10,7" Margin="0,0,8,6"/>
                    <Button x:Name="CopyFolderButton" Content="Copy _folder" Click="CopyFolder_Click"
                            IsEnabled="False" Padding="10,7" Margin="0,0,8,6"/>
                    <Button x:Name="OpenFolderButton" Content="Open folder" Click="OpenFolder_Click"
                            IsEnabled="False" Padding="10,7" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="2. Pair with Launcher" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Copy the pairing code, open the pairing page, then paste and save it there. Keep this setup window open while the browser connects."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,9"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="CopyCodeButton" Content="Copy pairing _code" Click="CopyCode_Click"
                            IsEnabled="False" Padding="10,7" Margin="0,0,8,6"/>
                    <Button x:Name="OpenOptionsButton" Content="Open _pairing page" Click="OpenOptions_Click"
                            IsEnabled="False" Padding="10,7" Margin="0,0,0,6"/>
                </WrapPanel>
                <Expander x:Name="DetailsExpander" Header="Advanced: folder and pairing code" IsExpanded="False"
                          Expanded="Details_Expanded" Collapsed="Details_Collapsed"
                          Foreground="{DynamicResource MutedBrush}">
                    <StackPanel Margin="0,9,0,0">
                        <Label Content="Extension folder" Foreground="{DynamicResource MutedBrush}" Padding="0"/>
                        <TextBox x:Name="FolderText" IsReadOnly="True" Margin="0,5,0,10"
                                 HorizontalScrollBarVisibility="Auto" Foreground="{DynamicResource TextBrush}"
                                 AutomationProperties.Name="Browser extension folder"/>
                        <Label Content="Private pairing code" Foreground="{DynamicResource MutedBrush}" Padding="0"/>
                        <TextBox x:Name="PairingCodeText" IsReadOnly="True" Margin="0,5,0,0"
                                 HorizontalScrollBarVisibility="Auto" Foreground="{DynamicResource TextBrush}"
                                 AutomationProperties.Name="Private browser pairing code"/>
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True" MinWidth="85"/>
        </StackPanel>
    </Grid>
</Window>
