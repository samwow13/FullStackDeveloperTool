<Window x:Class="FullStackLauncher.GitWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git workspace" Width="980" Height="760" MinWidth="760" MinHeight="540"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Icon="/Assets/launcher.ico"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="0,8,0,5"/></Style>
        <Style TargetType="TabControl">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TabPanel IsItemsHost="True" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Frame" Background="#223549" BorderBrush="#3A516C" BorderThickness="1" CornerRadius="6" Padding="16,9" Margin="0,0,8,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#203C3B"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="MinRowHeight" Value="32"/>
            <Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#111923"/><Setter Property="AlternatingRowBackground" Value="#1D2938"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="None"/>
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293B50"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285D55"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/></Style>
        <Style x:Key="CodeReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Padding" Value="14,8"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,3,0,0"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ProjectTitle}" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Refresh local status" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" ToolTip="Refresh local status. Fetch to update the remote comparison."/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,12">
            <StackPanel>
                <Grid IsEnabled="{Binding IsIdle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <StackPanel><Label Content="_Folder" Target="{Binding ElementName=FolderPicker}" Padding="0,0,0,5"/><ComboBox x:Name="FolderPicker" ItemsSource="{Binding Folders}" DisplayMemberPath="Display" SelectionChanged="Folder_Changed" AutomationProperties.Name="Project or service folder"/></StackPanel>
                    <StackPanel Grid.Column="2"><Label Content="_Remote" Target="{Binding ElementName=RemotePicker}" Padding="0,0,0,5"/><ComboBox x:Name="RemotePicker" ItemsSource="{Binding Remotes}" DisplayMemberPath="Name" SelectionChanged="Remote_Changed" AutomationProperties.Name="Git remote"/></StackPanel>
                </Grid>
                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding BranchLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,18,0" MaxWidth="330" TextTrimming="CharacterEllipsis" ToolTip="{Binding BranchLabel}"/>
                    <TextBlock Grid.Column="1" Text="{Binding RepositoryLabel}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RepositoryLabel}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding OperationLabel}" Foreground="#FFBC8B" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="2" IsEnabled="{Binding IsIdle}">
            <TabItem x:Name="WorkTab" Header="_Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding ComparisonLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Changed files" Style="{StaticResource Hint}"/><TextBlock Text="{Binding ChangedFilesLabel}" Style="{StaticResource Metric}"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" ToolTip="Tracked text in your working tree compared with the last fetched remote branch. Includes local commits and edits; excludes untracked and binary file contents."><StackPanel><TextBlock Text="Lines added" Style="{StaticResource Hint}"/><TextBlock Text="{Binding AddedLinesLabel}" Style="{StaticResource Metric}" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" ToolTip="Tracked text in your working tree compared with the last fetched remote branch. Includes local commits and edits; excludes untracked and binary file contents."><StackPanel><TextBlock Text="Lines removed" Style="{StaticResource Hint}"/><TextBlock Text="{Binding RemovedLinesLabel}" Style="{StaticResource Metric}" Foreground="#FFACA9"/></StackPanel></Border>
                        </Grid>
                        <TextBlock Text="{Binding ComparisonDetail}" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,18"/>
                        <Border Style="{StaticResource Card}" BorderBrush="#346259" Background="#172A29" Margin="0,0,0,18">
                            <StackPanel>
                                <Button Content="Commit all &amp; push…" Click="CommitAllPush_Click" IsEnabled="{Binding CanCommitAllPush}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,11" FontSize="15" ToolTip="Enter a commit message, then stage every change, commit, and push to the selected remote." ToolTipService.ShowOnDisabled="True"/>
                                <TextBlock Text="{Binding CommitAvailabilityText}" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <Button Content="Fetch" Click="Fetch_Click" IsEnabled="{Binding HasRemote}" Style="{StaticResource Action}" ToolTip="Fetch branches and refresh the remote comparison."/>
                            <Button Content="Pull" Click="Pull_Click" IsEnabled="{Binding CanPull}" Style="{StaticResource Action}" ToolTip="Pull the selected remote branch with fast-forward only. Requires a clean working tree."/>
                            <Button Content="Push" Click="Push_Click" IsEnabled="{Binding CanSync}" Style="{StaticResource Action}" ToolTip="Push existing commits to the selected remote."/>
                        </WrapPanel>
                        <TextBlock Text="{Binding RemoteSummary}" Style="{StaticResource Hint}" Margin="0,2,0,18"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Label Content="_Merge into current branch" Target="{Binding ElementName=MergePicker}" Padding="0,0,0,7"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MergePicker" ItemsSource="{Binding MergeBranches}" DisplayMemberPath="DisplayLabel" SelectionChanged="MergeSelection_Changed" AutomationProperties.Name="Branch to merge" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Merge…" Click="Merge_Click" IsEnabled="{Binding CanMerge}" Margin="10,0,0,0" ToolTip="Merge the selected local or last-fetched remote branch. Requires a clean working tree." ToolTipService.ShowOnDisabled="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="_Branches">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
                    <Label Content="Branch _name" Target="{Binding ElementName=BranchName}" Padding="0,0,0,5"/>
                    <TextBox x:Name="BranchName" TextChanged="BranchName_Changed" MaxLength="240" AutomationProperties.Name="Branch name"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Create branch" Click="CreateBranch_Click" Style="{StaticResource Action}" IsEnabled="{Binding CanCreateNamedBranch}"/>
                        <Button Content="Switch branch" Click="SwitchBranch_Click" Style="{StaticResource Action}" IsEnabled="{Binding CanSwitchNamedBranch}"/>
                        <Button Content="Check online" Click="CheckBranch_Click" Style="{StaticResource Action}" IsEnabled="{Binding HasRemote}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding BranchPresence}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding BranchActionText}" Style="{StaticResource Hint}" Margin="0,5,0,12"/>
                    <DataGrid x:Name="BranchesGrid" ItemsSource="{Binding Branches}" SelectionMode="Single" SelectionChanged="Branch_Changed" Height="270" AutomationProperties.Name="Local and remote branches">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Current" Binding="{Binding CurrentLabel}" Width="80"/>
                            <DataGridTextColumn Header="Branch" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding LocationLabel}" Width="130"/>
                            <DataGridTextColumn Header="Upstream" Binding="{Binding Upstream}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem x:Name="SetupTab" Header="Repository set_up">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Initialize repository" FontSize="17" FontWeight="SemiBold"/>
                            <Label Content="_Initial branch" Target="{Binding ElementName=InitialBranch}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="InitialBranch" Text="main" IsEnabled="{Binding CanInitialize}"/>
                                <Button Grid.Column="1" Content="Initialize" Click="Initialize_Click" IsEnabled="{Binding CanInitialize}" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Remote connection" FontSize="17" FontWeight="SemiBold"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><Label Content="Remote na_me" Target="{Binding ElementName=RemoteName}"/><TextBox x:Name="RemoteName" Text="origin" MaxLength="160" TextChanged="RemoteDraft_Changed"/></StackPanel>
                        <StackPanel Grid.Column="2"><Label Content="Clone _URL" Target="{Binding ElementName=RemoteUrl}"/><TextBox x:Name="RemoteUrl" MaxLength="2048" TextChanged="RemoteDraft_Changed"/></StackPanel>
                    </Grid>
                    <TextBlock Text="HTTPS or SSH URL without credentials. Uses your existing Git sign-in." Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,10"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="Save remote…" Click="SaveRemote_Click" IsEnabled="{Binding IsRepository}" Style="{StaticResource Action}"/>
                        <Button Content="Copy repository URL" Click="CopyUrl_Click" IsEnabled="{Binding CanCopyUrl}" Style="{StaticResource Action}"/>
                    </WrapPanel>
                    <Expander Header="Azure DevOps">
                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Requires Azure CLI with the azure-devops extension and an authenticated account." Style="{StaticResource Hint}" FontSize="12"/>
                                <Label Content="_Organization URL" Target="{Binding ElementName=AzureOrganization}"/><TextBox x:Name="AzureOrganization" MaxLength="250" ToolTip="https://dev.azure.com/your-organization"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><Label Content="Azure _project" Target="{Binding ElementName=AzureProject}"/><TextBox x:Name="AzureProject" MaxLength="250"/></StackPanel>
                                    <StackPanel Grid.Column="2"><Label Content="Repositor_y name" Target="{Binding ElementName=AzureRepository}"/><TextBox x:Name="AzureRepository" MaxLength="250"/></StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Find repository" Click="AzureLookup_Click" Style="{StaticResource Action}"/>
                                    <Button Content="Create &amp; connect…" Click="AzureCreate_Click" Style="{StaticResource Action}" IsEnabled="{Binding IsRepository}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="_Activity"><TextBox Text="{Binding ActivityText, Mode=OneWay}" Style="{StaticResource CodeReadout}" TextWrapping="Wrap" AutomationProperties.Name="Git command activity"/></TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
            <Button Grid.Column="1" Content="Cancel operation" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Close" Click="Close_Click" IsEnabled="{Binding IsIdle}"/>
        </Grid>
    </Grid>
</Window>
