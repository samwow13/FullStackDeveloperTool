<Window x:Class="FullStackLauncher.GitWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git workspace" Width="980" Height="760" MinWidth="760" MinHeight="540"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Icon="/Assets/launcher.ico"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="0,8,0,5"/></Style>
        <Style TargetType="TabControl">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TabPanel IsItemsHost="True" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="Frame" Background="#223549" BorderBrush="#3A516C" BorderThickness="1" CornerRadius="6" Padding="16,9" Margin="0,0,8,0">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#203C3B"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="MinRowHeight" Value="32"/>
            <Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#111923"/><Setter Property="AlternatingRowBackground" Value="#1D2938"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="None"/>
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293B50"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285D55"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/></Style>
        <Style x:Key="CodeReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="FontFamily" Value="Cascadia Code, Consolas"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Padding" Value="14,8"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,3,0,0"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ProjectTitle}" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding GitHeaderActionsVisibility}">
                <Button Content="_Config" Click="Config_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" ToolTip="Choose the project folder and active remote, reconnect, or add GitHub and Azure DevOps connections."/>
                <Button Content="Refresh local status" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" ToolTip="Refresh local status. Fetch to update the remote comparison."/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13" Margin="0,0,0,12" Visibility="{Binding BranchHeaderVisibility}">
            <StackPanel>
                <TextBlock Text="{Binding PublishBranchCaption}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PublishBranchLabel}" Visibility="{Binding PublishBranchReadoutVisibility}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PublishBranchTooltip}" VerticalAlignment="Center"/>
                    <TextBox x:Name="PublishBranchName" Text="{Binding PublishBranchDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding PublishBranchEditorVisibility}" IsEnabled="{Binding CanEditPublishBranch}" MaxLength="240" HorizontalScrollBarVisibility="Auto" Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" FontSize="16" Padding="8,5" KeyDown="PublishBranchName_KeyDown" AutomationProperties.Name="Branch for next commit all and push" ToolTip="{Binding PublishBranchTooltip}"/>
                    <Button x:Name="PublishBranchEdit" Grid.Column="1" Click="PublishBranchEdit_Click" IsEnabled="{Binding CanEditPublishBranch}" Width="32" Height="32" Padding="7" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" ToolTip="{Binding PublishBranchEditLabel}" AutomationProperties.Name="{Binding PublishBranchEditLabel}">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16">
                            <Path.Style><Style TargetType="Path">
                                <Setter Property="Data" Value="M 3,11 L 2,15 L 6,14 L 14,6 L 11,3 Z M 9,5 L 12,8"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsEditingPublishBranch}" Value="True"><Setter Property="Data" Value="M 2,8 L 6,12 L 14,3"/></DataTrigger></Style.Triggers>
                            </Style></Path.Style>
                        </Path>
                    </Button>
                </Grid>
                <WrapPanel Visibility="{Binding PublishBranchEditorVisibility}" Margin="0,8,0,0">
                    <Button Content="Switch branch" Click="SwitchBranch_Click" IsEnabled="{Binding CanSwitchNamedBranch}" Style="{StaticResource Action}" ToolTip="{Binding BranchActionText}"/>
                    <Button Content="Create branch" Click="CreateBranch_Click" IsEnabled="{Binding CanCreateNamedBranch}" Style="{StaticResource Action}" ToolTip="{Binding BranchActionText}"/>
                </WrapPanel>
                <TextBlock Text="{Binding OperationLabel}" Foreground="#FFBC8B" TextWrapping="Wrap" Margin="0,6,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OperationLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <TabControl x:Name="WorkspaceTabs" Grid.Row="2" IsEnabled="{Binding IsIdle}" Visibility="{Binding WorkspaceVisibility}" SelectionChanged="WorkspaceTab_Changed">
            <TabItem x:Name="WorkTab" Header="_Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{Binding ComparisonLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Changed files" Style="{StaticResource Hint}"/><TextBlock Text="{Binding ChangedFilesLabel}" Style="{StaticResource Metric}"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" ToolTip="{Binding LineTotalsTooltip}"><StackPanel><TextBlock Text="Lines added" Style="{StaticResource Hint}"/><TextBlock Text="{Binding AddedLinesLabel}" Style="{StaticResource Metric}" Foreground="{StaticResource AccentBrush}"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" ToolTip="{Binding LineTotalsTooltip}"><StackPanel><TextBlock Text="Lines removed" Style="{StaticResource Hint}"/><TextBlock Text="{Binding RemovedLinesLabel}" Style="{StaticResource Metric}" Foreground="#FFACA9"/></StackPanel></Border>
                        </Grid>
                        <TextBlock Text="{Binding ComparisonDetail}" Style="{StaticResource Hint}" FontSize="12" Margin="0,8,0,18"/>
                        <Border Style="{StaticResource Card}" BorderBrush="#346259" Background="#172A29" Margin="0,0,0,18">
                            <StackPanel>
                                <Border x:Name="PublishFeedbackCard" Visibility="Collapsed" Background="#102923" BorderBrush="#386C5E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                                        Loaded="PublishFeedback_Loaded" Unloaded="PublishFeedback_Unloaded" IsVisibleChanged="PublishFeedback_IsVisibleChanged">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                            <Canvas x:Name="PublishBurst" Width="64" Height="64" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Canvas.RenderTransform><ScaleTransform x:Name="PublishBurstScale"/></Canvas.RenderTransform>
                                                <Line X1="32" Y1="4" X2="32" Y2="10" Stroke="#9FFFE0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="50" Y1="13" X2="54" Y2="9" Stroke="#C2DACF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="54" Y1="32" X2="60" Y2="32" Stroke="#67E7C1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="50" Y1="50" X2="54" Y2="54" Stroke="#E1D7A4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="32" Y1="54" X2="32" Y2="60" Stroke="#9FFFE0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="14" Y1="50" X2="10" Y2="54" Stroke="#C2DACF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="4" Y1="32" X2="10" Y2="32" Stroke="#67E7C1" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="10" Y1="10" X2="14" Y2="14" Stroke="#E1D7A4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                            <Grid x:Name="PublishWorkingIcon">
                                                <Ellipse Width="46" Height="46" Stroke="#284B40" StrokeThickness="3"/>
                                                <Path Data="M 32,9 A 23,23 0 0 1 55,32" Stroke="#78E7C5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.RenderTransform><RotateTransform x:Name="PublishSpinnerRotate" CenterX="32" CenterY="32"/></Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                            <Grid x:Name="PublishSuccessIcon" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform><ScaleTransform x:Name="PublishSuccessScale"/></Grid.RenderTransform>
                                                <Ellipse Width="46" Height="46" Fill="#203E33" Stroke="#76E5BD" StrokeThickness="1.5"/>
                                                <Path Data="M 21,32 L 29,40 L 44,24" Stroke="#A4FFE0" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Grid>
                                            <Grid x:Name="PublishUnconfirmedIcon" Visibility="Collapsed">
                                                <Ellipse Width="46" Height="46" Fill="#3D3020" Stroke="#C7A36C" StrokeThickness="1.5"/>
                                                <TextBlock Text="!" FontSize="30" FontWeight="SemiBold" Foreground="#FFE0A9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Grid>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="PublishFeedbackHeading" FontSize="19" FontWeight="SemiBold" Foreground="#BBFCE5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                            <TextBlock x:Name="PublishFeedbackDestination" Foreground="#A9C8BD" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="100" Margin="0,8,0,0">
                                                <TextBlock x:Name="PublishFeedbackDetail" Foreground="#D9EEE7" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                            <StackPanel x:Name="PublishLinkPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Hyperlink x:Name="PublishLink" Click="PublishLinkOpen_Click" Foreground="#BBFCE5" Cursor="Hand" ToolTip="Open this link in Chrome" AutomationProperties.Name="Open after-push link in Chrome">
                                                        <Run x:Name="PublishLinkText"/>
                                                    </Hyperlink>
                                                </TextBlock>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button x:Name="PublishLinkOpen" Content="Open Azure" Click="PublishLinkOpen_Click" Style="{StaticResource PrimaryButton}" Padding="16,9" Margin="0,0,8,0" ToolTip="Open the saved link in Chrome"/>
                                                    <Button Content="Copy link" Click="PublishLinkCopy_Click" Padding="12,9" AutomationProperties.Name="Copy after-push link"/>
                                                </WrapPanel>
                                                <TextBlock x:Name="PublishLinkStatus" Foreground="#D9EEE7" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="PublishFeedbackDismiss" Grid.Column="2" Content="Dismiss" Click="PublishFeedbackDismiss_Click" VerticalAlignment="Top" Padding="9,5" Margin="12,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Dismiss publish result" ToolTip="Hide this result. Git history stays available."/>
                                    </Grid>
                                </Border>
                                <WrapPanel>
                                    <Button Content="Commit all &amp; push…" Click="CommitAllPush_Click" IsEnabled="{Binding CanCommitAllPush}" Style="{StaticResource PrimaryButton}" Padding="20,11" FontSize="15" Margin="0,0,10,8" ToolTip="{Binding CommitAvailabilityText}" ToolTipService.ShowOnDisabled="True"/>
                                    <WrapPanel>
                                        <Button Content="Merge Locally" Click="SyncRelease_Click" IsEnabled="{Binding CanPrepareSync}" Padding="20,11" FontSize="15" Margin="0,0,10,8" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Merge Locally">
                                            <Button.ToolTip><StackPanel MaxWidth="420"><TextBlock Text="{Binding MergeTargetLabel}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding PowerAvailabilityText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Button.ToolTip>
                                        </Button>
                                        <Button Content="Git-only conflict test" Click="CheckReleaseMerge_Click" IsEnabled="{Binding CanCheckReleaseMerge}" Padding="14,11" FontSize="15" Margin="0,0,0,8" ToolTip="Confirm the remote source branch, then immediately compare your current committed branch with its latest remote commit. Show incoming commits, conflicts and details here. Runs without waiting for agents. Does not merge, stage, commit, push or change local files. Uncommitted edits are excluded." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Test release merge conflicts with Git only"/>
                                    </WrapPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding ReleaseSourceLabel}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" BorderBrush="#A07850" Background="#30291F" Visibility="{Binding SyncRecoveryVisibility}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="{Binding SyncRecoverySummary}" TextWrapping="Wrap" Foreground="#FFE0BC"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Conflicts / recovery details…" Click="SyncDetails_Click" Style="{StaticResource Action}"/>
                                    <Button Content="Clear merge tracking…" Click="DismissSync_Click" IsEnabled="{Binding CanDismissSync}" Style="{StaticResource Action}" ToolTip="Clear only the launcher's record after Git has no active operation. Files, branches and commits stay in place."/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <Button Content="Fetch" Click="Fetch_Click" IsEnabled="{Binding HasRemote}" Style="{StaticResource Action}" ToolTip="Fetch branches and refresh the remote comparison."/>
                            <Button Content="Pull" Click="Pull_Click" IsEnabled="{Binding CanPull}" Style="{StaticResource Action}" ToolTip="Pull the selected remote branch with fast-forward only. Requires a clean working tree."/>
                            <Button Content="Push" Click="Push_Click" IsEnabled="{Binding CanSync}" Style="{StaticResource Action}" ToolTip="Push existing commits to the selected remote."/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="BranchesTab" Header="_Branches">
                <Grid Visibility="{Binding BranchesContentVisibility}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BranchListCaption}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding BranchListTooltip}"/>
                        <ComboBox Grid.Column="1" Width="160" SelectedIndex="{Binding BranchViewIndex, Mode=TwoWay}" AutomationProperties.Name="Branch location" ToolTip="Show branches from the active remote or branches stored locally.">
                            <ComboBoxItem Content="Remote branches"/>
                            <ComboBoxItem Content="Local branches"/>
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="BranchesGrid" Grid.Row="1" ItemsSource="{Binding VisibleBranches}" SelectionMode="Single" SelectionChanged="Branch_Changed" MinHeight="100" AutomationProperties.Name="{Binding BranchListCaption}" ToolTip="{Binding BranchListTooltip}">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="BranchCurrentColumn" Header="Current" Binding="{Binding CurrentLabel}" Width="80" Visibility="Collapsed"/>
                            <DataGridTextColumn Header="Branch" Binding="{Binding Name}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Name}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="History" Binding="{Binding LocationLabel}" Width="130"/>
                            <DataGridTextColumn x:Name="BranchUpstreamColumn" Header="Upstream" Binding="{Binding Upstream}" Width="220" Visibility="Collapsed"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Upstream}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{Binding BranchListEmptyMessage}" Style="{StaticResource Hint}" Visibility="{Binding BranchListEmptyVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextAlignment="Center" IsHitTestVisible="False"/>
                    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding SelectedBranchComparisonLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding SelectedBranchComparisonDetail}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Commit history…" Click="BranchHistory_Click" IsEnabled="{Binding CanShowBranchHistory}" VerticalAlignment="Center" ToolTip="{Binding BranchHistoryTooltip}" ToolTipService.ShowOnDisabled="True"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding SetupVisibility}" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsIdle}">
                    <StackPanel Margin="0,0,8,0">
                        <Grid Margin="0,0,0,20" Visibility="{Binding ConfigFolderVisibility}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><Label Content="_Repo / folder" Target="{Binding ElementName=FolderPicker}" Padding="0,0,0,5"/>
                                <ComboBox x:Name="FolderPicker" ItemsSource="{Binding Folders}" DisplayMemberPath="Label" SelectionChanged="Folder_Changed" ToolTip="{Binding SelectedItem.Directory, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Repository or setup folder in Git Config">
                                    <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Directory}"/></Style></ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Visibility="{Binding ConfigRemoteVisibility}" MinWidth="180"><Label Content="Active _remote" Target="{Binding ElementName=RemotePicker}" Padding="0,0,0,5"/><ComboBox x:Name="RemotePicker" ItemsSource="{Binding Remotes}" DisplayMemberPath="Name" SelectionChanged="Remote_Changed" IsEnabled="{Binding CanSelectRemote}" AutomationProperties.Name="Active Git remote in Config" ToolTip="Choose the active remote for this workspace. Connection setup drafts must be completed or canceled first."/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding SetupProgress}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding SetupTitle}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SetupDescription}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ChoiceStepVisibility}" MaxWidth="540" HorizontalAlignment="Left">
                            <Button x:Name="ExistingRepositoryChoice" Content="Existing online repository" Click="ExistingRepository_Click" HorizontalContentAlignment="Left" Padding="18,16" FontSize="17" Margin="0,0,0,12"/>
                            <Button Content="New repository" Click="NewRepository_Click" HorizontalContentAlignment="Left" Padding="18,16" FontSize="17"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding LocalStepVisibility}" MaxWidth="540" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding LocalSetupMessage}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <StackPanel Visibility="{Binding CanInitialize, Converter={StaticResource BoolToVisibility}}">
                                <Label Content="_Initial branch" Target="{Binding ElementName=InitialBranch}"/>
                                <TextBox x:Name="InitialBranch" Text="main" MaxLength="240" AutomationProperties.Name="Initial branch name"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ConnectionsStepVisibility}">
                            <Label Content="Connections for this _repository" Target="{Binding ElementName=ConnectionPicker}" Padding="0,0,0,8"/>
                            <ListBox x:Name="ConnectionPicker" ItemsSource="{Binding Remotes}" SelectionMode="Single" SelectionChanged="Connection_Changed" MinHeight="100" MaxHeight="220" Background="#111923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5" AutomationProperties.Name="Connections for this repository">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding FetchUrl}" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button Content="_Use selected connection" Click="UseConnection_Click" Style="{StaticResource Action}"/>
                                <Button Content="_Reconnect selected…" Click="Reconnect_Click" Style="{StaticResource Action}"/>
                                <Button Content="_Add connection…" Click="AddConnection_Click" Style="{StaticResource Action}"/>
                                <Button Content="After-push _link…" Click="PostPushLinkConfig_Click" Style="{StaticResource Action}" ToolTip="Customize the link opened in Chrome after a successful push on the selected connection."/>
                            </WrapPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding ReleaseSourceLabel}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                <Button Content="Change release _branch…" Click="ChangeReleaseBranch_Click" IsEnabled="{Binding CanChangeReleaseBranch}" Style="{StaticResource Action}" ToolTip="Choose the release source for the active remote. Saving this choice does not merge or push." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Change release branch in Config"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ProviderStepVisibility}" MaxWidth="540" HorizontalAlignment="Left">
                            <Button x:Name="GitHubChoice" Click="GitHubProvider_Click" HorizontalContentAlignment="Stretch" Padding="18,15" Margin="0,0,0,12" AutomationProperties.Name="Choose GitHub">
                                <StackPanel>
                                    <AccessText Text="_GitHub" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Click="AzureProvider_Click" HorizontalContentAlignment="Stretch" Padding="18,15" AutomationProperties.Name="Choose Azure DevOps">
                                <StackPanel>
                                    <AccessText Text="_Azure DevOps" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Visibility="{Binding DestinationStepVisibility}">
                            <Button Content="Open provider…" Click="CreateOnlineRepository_Click" Visibility="{Binding CreateOnlineVisibility}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding DestinationHint}" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                            <Label Content="Repository clone _URL" Target="{Binding ElementName=RemoteUrl}"/>
                            <TextBox x:Name="RemoteUrl" MaxLength="2048" TextChanged="RemoteDraft_Changed" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Repository clone URL"/>
                            <TextBlock Text="Use the repository's HTTPS or SSH clone URL. Do not include a password or access token." Style="{StaticResource Hint}" FontSize="12" Margin="0,7,0,12"/>
                            <Expander Header="Advanced" Margin="0,6,0,0"><StackPanel Margin="0,8,0,0">
                                <Label Content="Connection _name" Target="{Binding ElementName=RemoteName}"/>
                                <TextBox x:Name="RemoteName" Text="origin" MaxLength="160" TextChanged="RemoteDraft_Changed" AutomationProperties.Name="Connection name"/>
                            </StackPanel></Expander>
                        </StackPanel>
                        <StackPanel Visibility="{Binding AuthenticationStepVisibility}">
                            <TextBlock Text="{Binding AuthDestination}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button x:Name="SetupSignIn" Content="{Binding SignInLabel}" Click="SignIn_Click" Style="{StaticResource Action}" AutomationProperties.Name="Sign in to repository provider"/>
                                <Button Content="_Verify connection" Click="VerifyConnection_Click" Style="{StaticResource Action}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding AuthenticationMessage}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/>
                            <Expander Header="Connection help" Margin="0,16,0,0"><TextBlock Text="{Binding AuthenticationHint}" Style="{StaticResource Hint}" Margin="0,10,0,0"/></Expander>
                            <Expander Header="Use a different Azure account" Visibility="{Binding AzureAccountHelpVisibility}" Margin="0,16,0,0">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBox Text="{Binding AzureAccountHelpText, Mode=OneWay}" Style="{StaticResource CodeReadout}" TextWrapping="Wrap" MaxHeight="200" AutomationProperties.Name="Azure account selection instructions"/>
                                    <Button Content="Open account guide" Click="AccountHelp_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ReviewStepVisibility}">
                            <Border Background="#111923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <TextBlock Text="{Binding SetupReview}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding CloneReviewStepVisibility}">
                            <Border Background="#111923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <TextBlock Text="{Binding CloneReviewText}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding CompleteStepVisibility}">
                            <TextBlock Text="{Binding CompletionMessage}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="0,18,0,0" IsEnabled="{Binding IsIdle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="_Use local workspace" Click="LocalWorkspace_Click" IsEnabled="{Binding IsRepository}" Visibility="{Binding UseLocalVisibility}" Margin="0,0,12,0"/>
                    <Button Grid.Column="2" Content="_Back" Click="SetupBack_Click" IsEnabled="{Binding CanSetupBack}" Visibility="{Binding SetupBackVisibility}" Margin="0,0,8,0"/>
                    <Button x:Name="SetupContinue" Grid.Column="3" Content="{Binding SetupNextLabel}" Click="SetupNext_Click" IsEnabled="{Binding CanSetupNext}" Visibility="{Binding SetupContinueVisibility}" Style="{StaticResource PrimaryButton}" MinWidth="105"/>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20" MaxWidth="460" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="{Binding RepositorySelectionVisibility}">
            <StackPanel>
                <TextBlock Text="Select which repo" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ComboBox x:Name="RepositoryPicker" ItemsSource="{Binding RepositoryChoices}" DisplayMemberPath="Display" SelectionChanged="RepositorySelection_Changed" IsEnabled="{Binding IsIdle}" ToolTip="{Binding SelectedItem.Detail, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Select which repository">
                    <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></ComboBox.ItemContainerStyle>
                </ComboBox>
                <TextBlock Text="Some folders could not be checked." Style="{StaticResource Hint}" Visibility="{Binding RepositoryDiscoveryWarningVisibility}" ToolTip="{Binding RepositoryDiscoveryWarning}" FontSize="12" Margin="0,8,0,0"/>
                <Button Content="_Open repo" Click="OpenRepository_Click" IsEnabled="{Binding CanOpenSelectedRepository}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0" AutomationProperties.Name="Open selected repository"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Visibility="{Binding GitLoadingVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding GitLoadingText}" AutomationProperties.LiveSetting="Polite">
            <Grid Width="38" Height="38" Margin="0,0,0,14">
                <Ellipse Stroke="#293B50" StrokeThickness="3"/>
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 19,1.5 A 17.5,17.5 0 0 1 36.5,19" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                    <Path.Style><Style TargetType="Path"><Style.Triggers>
                        <DataTrigger Binding="{Binding AnimateGitLoading}" Value="True">
                            <DataTrigger.EnterActions><BeginStoryboard x:Name="LoadingSpinAnimation"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="LoadingSpinAnimation"/></DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers></Style></Path.Style>
                </Path>
            </Grid>
            <TextBlock Text="{Binding GitLoadingText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Visibility="{Binding GitFailureVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
            <TextBlock Text="Couldn't load Git" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="{Binding GitLoadFailure}" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,10,0,18"/>
            <Button Content="_Retry" Click="RetryGit_Click" IsEnabled="{Binding CanRetryGit}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" MinWidth="105" AutomationProperties.Name="Retry loading Git"/>
            <StackPanel Visibility="{Binding TrustFailureVisibility}" Margin="0,20,0,0">
                <TextBlock Text="{Binding TrustFailureMessage}" TextWrapping="Wrap"/>
                <Button Content="Trust this folder…" Click="TrustFolder_Click" IsEnabled="{Binding CanTrustFolder}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="64" Visibility="{Binding GitStatusVisibility}"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
                <Expander Header="Error details" Visibility="{Binding GitErrorVisibility}" IsExpanded="False" Margin="0,5,0,0">
                    <TextBox Text="{Binding LatestErrorDetails, Mode=OneWay}" Style="{StaticResource CodeReadout}" TextWrapping="Wrap" MaxHeight="140" Margin="0,6,0,0" AutomationProperties.Name="Latest Git operation error details"/>
                </Expander>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel operation" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Close" Click="Close_Click" IsEnabled="{Binding IsIdle}"/>
        </Grid>
    </Grid>
</Window>
