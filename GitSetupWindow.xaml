<Window x:Class="FullStackLauncher.GitSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git setup" Width="640" MinWidth="520" SizeToContent="Height"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" Icon="/Assets/launcher.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ProjectTitle}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="Force refresh" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" ToolTip="Read the current local Git status again."/>
        </Grid>
        <ContentControl x:Name="WorkflowContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="64" Visibility="{Binding GitStatusVisibility}">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
                <Expander Header="Error details" Visibility="{Binding GitErrorVisibility}" Margin="0,5,0,0">
                    <TextBox Text="{Binding LatestErrorDetails, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="120" Margin="0,6,0,0" AutomationProperties.Name="Latest Git operation error details"/>
                </Expander>
                <Button Content="Trust this folder…" Click="Trust_Click" IsEnabled="{Binding CanTrustFolder}" Visibility="{Binding CachedTrustFailureVisibility}" ToolTip="{Binding TrustFailureMessage}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel operation" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Close" Click="Close_Click" IsEnabled="{Binding IsIdle}"/>
        </Grid>
    </Grid>
</Window>
