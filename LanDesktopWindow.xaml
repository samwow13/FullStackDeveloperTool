<Window x:Class="FullStackLauncher.LanDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion desktop" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="1280" Height="800" MinWidth="850" MinHeight="480"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/SetupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DesktopControlSwitch" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="FocusFrame" Padding="7,7" CornerRadius="5" BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Track" Width="30" Height="17" CornerRadius="9" Background="#29374B" BorderBrush="#73839A" BorderThickness="1" Margin="0,0,7,0">
                                    <Ellipse x:Name="Thumb" Width="11" Height="11" Fill="#A6B4C9" HorizontalAlignment="Left" Margin="2,0"/>
                                </Border>
                                <TextBlock x:Name="Label" Text="Control off" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#69E2C0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#0C2925"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Label" Property="Text" Value="Control on"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
            <WrapPanel VerticalAlignment="Center">
                <ComboBox x:Name="MonitorBox" Width="220" DisplayMemberPath="Label" SelectedValuePath="Id" IsEnabled="False" Margin="0,0,6,0" SelectionChanged="Monitor_Changed" AutomationProperties.Name="Remote monitor"/>
                <Button x:Name="NextMonitorButton" Content="Next monitor" IsEnabled="False" Click="NextMonitor_Click" Padding="10,7" Margin="0,0,12,0"/>
                <ComboBox x:Name="ProfileBox" Width="204" SelectedIndex="0" IsEnabled="False" SelectionChanged="Profile_Changed" Margin="0,0,8,0" AutomationProperties.Name="Stream quality and frame rate" ToolTip="Frame rates are upper limits. Actual displayed FPS and received JPEG bandwidth appear below.">
                    <ComboBoxItem Content="Balanced · 30 FPS target" ToolTip="Up to 30 frames per second; maximum width 1920 pixels; JPEG quality 85."/>
                    <ComboBoxItem Content="Smooth · 60 FPS target" ToolTip="Up to 60 frames per second; maximum width 1920 pixels; JPEG quality 80."/>
                    <ComboBoxItem Content="Sharp · 4K / 30 FPS target" ToolTip="Up to 30 frames per second; maximum width 3840 pixels; JPEG quality 92."/>
                </ComboBox>
                <CheckBox x:Name="ControlSwitch" IsChecked="False" IsEnabled="False" Style="{StaticResource DesktopControlSwitch}" Checked="Control_Checked" Unchecked="Control_Unchecked" Margin="0,0,8,0" AutomationProperties.Name="Enable remote mouse and keyboard control" ToolTip="Enable, then click the desktop to focus input. Esc releases all remote input. Windows shortcuts remain subject to local Windows handling."/>
                <Button x:Name="SendEscapeButton" Content="Send Esc" IsEnabled="False" Click="SendEscape_Click" Padding="10,7" Margin="0,0,6,0" ToolTip="Send one Escape press to the remote PC. The physical Esc key always releases local control."/>
                <Button x:Name="SizeButton" Content="100%" Click="Size_Click" Padding="10,7" Margin="0,0,6,0" ToolTip="Show stream pixels at actual size with scrolling, or fit the window."/>
                <Button x:Name="FullscreenButton" Content="Full screen" Click="Fullscreen_Click" Padding="10,7" ToolTip="Toggle full screen. Esc releases control; press Esc again to leave full screen."/>
            </WrapPanel>
        </Border>
        <Border x:Name="Viewport" Grid.Row="1" Background="#080B10" Focusable="True" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                AutomationProperties.Name="Remote desktop viewport" PreviewMouseDown="Viewport_MouseDown" PreviewMouseUp="Viewport_MouseUp" PreviewMouseMove="Viewport_MouseMove" PreviewMouseWheel="Viewport_MouseWheel"
                LostMouseCapture="Viewport_LostMouseCapture" LostKeyboardFocus="Viewport_LostKeyboardFocus">
            <Grid>
                <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CanContentScroll="False" ScrollChanged="ImageScroll_Changed">
                    <Image x:Name="DesktopImage" Stretch="Uniform" Focusable="False" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="LowQuality"/>
                </ScrollViewer>
                <TextBlock x:Name="ConnectingText" Text="Opening companion desktop…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Connecting…" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="MetricsText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" ToolTip="Displayed frames per second; received JPEG payload megabits per second, excluding TLS and protocol overhead."/>
            </Grid>
        </Border>
    </Grid>
</Window>
