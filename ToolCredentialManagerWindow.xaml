<Window x:Class="FullStackLauncher.ToolCredentialManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login profiles" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="640" Height="460" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CredentialProfileRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Login profiles" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                       ToolTip="Stored in Windows Credential Manager. Credential saves and deletions apply immediately. Tool assignment applies when you save tools."/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="_Refresh" Click="Refresh_Click" Padding="12,7"/>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
                <ListBox x:Name="ProfilesList" ItemContainerStyle="{StaticResource CredentialProfileRow}"
                         SelectionChanged="Profiles_SelectionChanged" AutomationProperties.Name="Saved login profiles">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel ToolTip="{Binding Details}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyHint" Text="No saved login profiles" Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <WrapPanel x:Name="ActionsPanel" ToolTip="Credential saves and deletions apply immediately in Windows Credential Manager. Tool assignment applies when you save tools.">
                <Button x:Name="AddButton" Content="_Add…" Click="Add_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Button x:Name="EditButton" Content="_Edit…" Click="Edit_Click" Padding="12,7" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="DeleteButton" Content="_Delete…" Click="Delete_Click" Padding="12,7" IsEnabled="False" Style="{StaticResource DangerButton}"/>
            </WrapPanel>
            <StackPanel x:Name="WorkPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <ProgressBar Height="3" IsIndeterminate="True" AutomationProperties.Name="Credential operation in progress"/>
                <TextBlock x:Name="WorkText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#38272F" BorderBrush="#66404C"
                    BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12,0,0">
                <TextBlock x:Name="ErrorText" Foreground="#FFACA9" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.Name="Login profile error" AutomationProperties.LiveSetting="Assertive"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" MinWidth="86" Margin="0,0,8,0"/>
            <Button x:Name="UseButton" Content="_Use selected" IsDefault="True" Click="UseSelected_Click" MinWidth="116"
                    IsEnabled="False" Style="{StaticResource PrimaryButton}" ToolTipService.ShowOnDisabled="True"/>
        </StackPanel>
    </Grid>
</Window>
