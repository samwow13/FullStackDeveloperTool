<Window x:Class="FullStackLauncher.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project settings" Icon="pack://application:,,,/Assets/launcher.ico" Width="1000" Height="800" MinWidth="810" MinHeight="660"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Make this project yours" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Save folders and commands for web services, console apps, and local tools."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.75*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Project name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ProjectNameBox" AutomationProperties.Name="Project name" MinHeight="34" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Project root folder" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseRoot_Click" Margin="8,0,0,0" Padding="12,6" />
                    <TextBox x:Name="RootPathBox" AutomationProperties.Name="Project root folder" MinHeight="34" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="SettingsLocationText" Style="{StaticResource HelpText}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="APPS &amp; SERVICES" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,12" Foreground="{DynamicResource MutedBrush}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="＋ Add service" Click="AddService_Click" Margin="0,0,0,7" />
                        <Button Content="＋ Add console app" Click="AddConsoleApp_Click" Margin="0,0,0,7" />
                        <Button x:Name="RemoveServiceButton" Content="Remove selected" Click="RemoveService_Click" />
                    </StackPanel>
                    <ListBox x:Name="ServicesList" SelectionChanged="ServicesList_SelectionChanged"
                             AutomationProperties.Name="Project services" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="18,10,18,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="EmptyServiceHint" Text="Add an app or service to configure its working folder and command." VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ServiceForm" Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Service name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Service name" LostFocus="ServiceName_LostFocus" MinHeight="32" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ServiceKindBox" IsEditable="True" Text="{Binding Kind, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                              SourceUpdated="ServiceKind_SourceUpdated" MinHeight="32" AutomationProperties.Name="App or service type">
                                        <ComboBoxItem Content="Console" />
                                        <ComboBoxItem Content=".NET" />
                                        <ComboBoxItem Content="Angular" />
                                        <ComboBoxItem Content="Node.js" />
                                        <ComboBoxItem Content="Custom" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Working folder" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseService_Click" Margin="8,0,0,0" Padding="12,6" />
                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Service working folder" MinHeight="32" />
                            </DockPanel>
                            <TextBlock Text="Relative to the project root. Services need separate folders; one service folder cannot contain another." Style="{StaticResource HelpText}" />
                            <TextBlock Text="Start command" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="StartCommandBox" Text="{Binding StartCommand, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Start command" FontFamily="Consolas" MinHeight="34" />
                            <StackPanel x:Name="ConsoleCommandHelp" Visibility="Collapsed" Margin="0,3,0,0">
                                <Button Content="Use executable…" Click="BrowseExecutable_Click" HorizontalAlignment="Left" Margin="0,5,0,3" Padding="12,6"
                                        ToolTip="Choose an executable to run directly. Existing arguments on a direct executable command are kept." />
                                <TextBlock Text="Include arguments in the command. Console apps do not need a local URL." Style="{StaticResource HelpText}" />
                                <TextBlock Style="{StaticResource HelpText}" FontFamily="Consolas">
                                    <Run Text="dotnet run -- --mode quick" /><LineBreak />
                                    <Run Text="&quot;C:\Tools\Worker.exe&quot; --mode quick" />
                                </TextBlock>
                                <TextBlock Text="For dotnet run, everything after -- is passed to your app, including a target executable path if your app accepts one."
                                           Style="{StaticResource HelpText}" />
                            </StackPanel>
                            <Expander x:Name="OptionalCommandsExpander" Header="Optional clean / setup commands" IsExpanded="True"
                                      Margin="0,14,0,5" Foreground="{DynamicResource TextBrush}">
                                <StackPanel Margin="0,0,0,5">
                                    <TextBlock Text="Clean command (optional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CleanCommand, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Clean command" FontFamily="Consolas" MinHeight="34" />
                                    <TextBlock Text="Setup / restore command (optional)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SetupCommand, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Setup command" FontFamily="Consolas" MinHeight="34" />
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="Commands are trusted Windows shell commands, executed in the working folder. Only save commands you trust."
                                       Style="{StaticResource HelpText}" />
                            <StackPanel x:Name="WebSettingsPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Expected local URL" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expected local URL" MinHeight="34" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Open UI path" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding UiPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Open UI path" MinHeight="34" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Example: http://localhost:5170 and /swagger. The launcher also detects local listening URLs from service output."
                                           Style="{StaticResource HelpText}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Changes are saved only when you choose Save project." Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" MinWidth="95" Margin="0,0,10,0" />
                <Button Content="Save project" Click="Save_Click" IsDefault="True" MinWidth="125" Background="{DynamicResource AccentBrush}" Foreground="#0C2925" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
