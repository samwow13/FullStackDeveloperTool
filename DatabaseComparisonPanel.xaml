<UserControl x:Class="FullStackLauncher.DatabaseComparisonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Panel_Loaded" Unloaded="Panel_Unloaded" DataContextChanged="Panel_DataContextChanged"
             Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="0,10,0,0">
        <TextBlock Text="LOCAL VS DEPLOYED SCHEMA" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
        <TextBlock Text="Choose the local and deployed databases, then save them as a comparison set. Checks read schema metadata only."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>

        <TextBlock Text="Local API connection" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        <ComboBox x:Name="LocalConnectionPicker" DisplayMemberPath="Label" SelectionChanged="Endpoint_Changed"
                  AutomationProperties.Name="Local API database connection" Margin="0,3,0,8"/>

        <TextBlock Text="Deployed connection" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        <DockPanel Margin="0,3,0,8" LastChildFill="True">
            <Button x:Name="AddConnectionButton" DockPanel.Dock="Right" Content="Add connection…" Click="AddConnection_Click" Margin="6,0,0,0" Padding="7,4"
                    ToolTip="Save a verified remote PostgreSQL or SQL Server connection in the encrypted connection library"/>
            <ComboBox x:Name="ProductionConnectionPicker" DisplayMemberPath="Label" SelectionChanged="Endpoint_Changed"
                      AutomationProperties.Name="Deployed database connection"/>
        </DockPanel>

        <TextBlock Text="Deployed database name" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
        <DockPanel Margin="0,3,0,8" LastChildFill="True">
            <Button x:Name="ListDatabasesButton" DockPanel.Dock="Right" Content="List databases" Click="ListDatabases_Click"
                    Margin="6,0,0,0" Padding="7,4" ToolTip="Read databases visible to this production role"/>
            <ComboBox x:Name="ProductionDatabasePicker" IsEditable="True" IsTextSearchEnabled="False"
                      AutomationProperties.Name="Deployed database name"/>
        </DockPanel>

        <WrapPanel Margin="0,0,0,8">
            <Button x:Name="SaveTargetButton" Content="Save comparison set" Click="SaveTarget_Click" Padding="9,5" Margin="0,0,6,5"/>
            <Button x:Name="CompareButton" Content="Compare schemas" Click="Compare_Click" Padding="9,5" Margin="0,0,6,5"
                    Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Padding="9,5" Margin="0,0,6,5" Visibility="Collapsed"/>
            <Button x:Name="RefreshButton" Content="Refresh connections" Click="Refresh_Click" Padding="9,5" Margin="0,0,6,5"/>
            <Button x:Name="RestoreSavedSetButton" Content="Restore saved set" Click="RestoreSavedSet_Click"
                    Padding="9,5" Margin="0,0,6,5" Visibility="Collapsed"
                    ToolTip="Discard unsaved database choices and reload the saved comparison set"/>
        </WrapPanel>

        <Border Background="#121A25" BorderBrush="#303D50" BorderThickness="1" CornerRadius="5" Padding="11">
            <StackPanel>
                <TextBlock x:Name="ComparisonVerdict" Text="No schema comparison yet." Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SchemaSummary" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                <TextBlock x:Name="MigrationSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                <TextBlock x:Name="ComparedAt" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
