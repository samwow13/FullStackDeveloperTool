<Window x:Class="FullStackLauncher.DatabaseAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FullStackLauncher"
        Title="Database · Accounts" Width="1200" Height="930" MinWidth="950" MinHeight="730"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Icon="/Assets/launcher.ico" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="0,9,0,4"/></Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="10,8"/><Setter Property="MaxLength" Value="1024"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#111923"/><Setter Property="AlternatingRowBackground" Value="#1D2938"/>
            <Setter Property="AlternationCount" Value="2"/><Setter Property="MinRowHeight" Value="36"/>
            <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
        </Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293B50"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="9,8"/></Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="7,5"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285D55"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Database accounts" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="View users, change passwords, and add accounts directly in the database you choose." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid x:Name="ConnectionInputs" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <local:DatabaseEndpointPicker x:Name="Endpoint"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Connect directly to PostgreSQL" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <TextBlock Text="Choose a saved connection and database to load all users, including administrators and inactive accounts." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button x:Name="ConnectButton" Content="Connect / refresh accounts" Click="Connect_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"/>
                    <Button x:Name="ReloadButton" Content="Reload connections" Click="Reload_Click" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="SchemaText" Text="Account tables are detected when you connect." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="#382E20" BorderBrush="#9A7438" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,12">
            <StackPanel>
                <TextBlock x:Name="TargetText" Text="Choose a database, then connect to load its accounts." Foreground="#FFDDA0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="Changes apply directly to the displayed database, including production when selected." Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel><Button x:Name="NewButton" DockPanel.Dock="Right" Content="+ New account" Click="New_Click" Margin="8,0,0,6"/><TextBlock Text="ACCOUNTS" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <TextBox x:Name="Search" Grid.Row="1" TextChanged="Search_Changed" AutomationProperties.Name="Search accounts by name, role or status" ToolTip="Search by username, display name, email, role, project or status" Margin="0,0,0,8"/>
                <DataGrid x:Name="AccountGrid" Grid.Row="2" SelectionChanged="Account_Changed" AutomationProperties.Name="Database accounts">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding UserName}" Width="140"/>
                        <DataGridTextColumn x:Name="DisplayNameColumn" Header="Display name" Binding="{Binding DisplayName}" Width="170" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="EmailColumn" Header="Email" Binding="{Binding Email}" Width="190" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="105"/>
                        <DataGridTextColumn x:Name="ProjectColumn" Header="Project" Binding="{Binding ProjectName}" Width="150" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="CountText" Grid.Row="3" Text="No accounts loaded." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Editor">
                        <TextBlock x:Name="EditorHeading" Text="New account" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel x:Name="CreateFields">
                            <Label Content="_Username" Target="{Binding ElementName=UserNameInput}"/><TextBox x:Name="UserNameInput" MaxLength="256" TextChanged="Input_Changed"/>
                            <StackPanel x:Name="DisplayNameFields" Visibility="Collapsed">
                                <Label Content="_Display name" Target="{Binding ElementName=DisplayNameInput}"/><TextBox x:Name="DisplayNameInput" MaxLength="128" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <StackPanel x:Name="EmailFields" Visibility="Collapsed">
                                <Label Content="_Email" Target="{Binding ElementName=EmailInput}"/><TextBox x:Name="EmailInput" MaxLength="256" TextChanged="Input_Changed"/>
                            </StackPanel>
                            <Label Content="_Role" Target="{Binding ElementName=RolePicker}"/>
                            <ComboBox x:Name="RolePicker" SelectionChanged="Role_Changed"/>
                            <Label x:Name="ProjectLabel" Content="Assigned project (required for customers)" Target="{Binding ElementName=AssignmentPicker}"/>
                            <ComboBox x:Name="AssignmentPicker" DisplayMemberPath="Name" SelectionChanged="InputSelection_Changed" AutomationProperties.Name="Assigned active project"/>
                            <TextBlock x:Name="RoleNotice" Text="Connect to load the roles available in this database." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="ExistingFields" Visibility="Collapsed">
                            <TextBlock x:Name="SelectedDetails" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                            <Label Content="_Action" Target="{Binding ElementName=ActionPicker}"/>
                            <ComboBox x:Name="ActionPicker" SelectedIndex="0" SelectionChanged="Action_Changed"><ComboBoxItem Content="Set password"/><ComboBoxItem Content="Remove account"/></ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="PasswordFields">
                            <Label Content="New _password" Target="{Binding ElementName=PasswordInput}"/><PasswordBox x:Name="PasswordInput" PasswordChanged="Password_Changed"/>
                            <Label Content="Repeat password" Target="{Binding ElementName=RepeatPasswordInput}"/><PasswordBox x:Name="RepeatPasswordInput" PasswordChanged="Password_Changed"/>
                            <TextBlock Text="At least 12 characters, with uppercase, lowercase, a number and a symbol." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ActionNotice" TextWrapping="Wrap" Foreground="#FFDDA0" Margin="0,12,0,0"/>
                        <Label Content="Type the database target to confirm" Target="{Binding ElementName=TargetConfirmation}"/>
                        <TextBox x:Name="ConfirmationHint" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="TargetConfirmation" TextChanged="Input_Changed" AutomationProperties.Name="Confirm database target" Margin="0,6,0,0"/>
                        <StackPanel x:Name="AccountConfirmationFields" Visibility="Collapsed">
                            <Label Content="Type the selected username to confirm" Target="{Binding ElementName=AccountConfirmation}"/>
                            <TextBox x:Name="AccountConfirmation" TextChanged="Input_Changed" AutomationProperties.Name="Confirm account username"/>
                        </StackPanel>
                        <Button x:Name="ApplyButton" Content="Create account" Click="Apply_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel operation" Click="Cancel_Click" Margin="12,0,0,0"/>
            <TextBlock x:Name="StatusText" Text="Choose a connection to begin." TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
