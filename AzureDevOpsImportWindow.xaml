<Window x:Class="FullStackLauncher.AzureDevOpsImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Integrate from DevOps or Git" Icon="/Assets/launcher.ico"
        Width="600" MinWidth="510" MinHeight="260" SizeToContent="Height" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/SetupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HelpText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderBrush" Value="#5B6B80"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource SurfaceBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource CardBrush}"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
            <Style x:Key="InlinePencil" TargetType="Button" BasedOn="{StaticResource RowAction}">
                <Setter Property="Content" Value="&#xE70F;"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="IsEnabled" Value="{Binding CanEdit}"/>
            </Style>
            <Style x:Key="RowCell" TargetType="Border">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                <Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style x:Key="RowValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
            </Style>
            <Style x:Key="FieldCommand" TargetType="Button" BasedOn="{StaticResource RowAction}">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <DataTemplate x:Key="RepositorySummary">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="2.4*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Repository.Name}" ToolTip="{Binding Repository.Name}" FontWeight="SemiBold"
                               Style="{StaticResource RowValue}" Margin="8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding StartingBranch}" ToolTip="{Binding StartingBranch}"
                               Style="{StaticResource RowValue}" Margin="8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding FeatureBranch}" ToolTip="{Binding FeatureBranch}"
                               Style="{StaticResource RowValue}" Margin="8,0"/>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="RepositoryHeaders">
                <Grid Background="{StaticResource SurfaceBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="2.4*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Repository" Style="{StaticResource HelpText}" Margin="8,10"/>
                    <TextBlock Grid.Column="1" Text="Starting branch" Style="{StaticResource HelpText}" Margin="8,10"/>
                    <TextBlock Grid.Column="2" Text="Feature branch" Style="{StaticResource HelpText}" Margin="8,10"/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Text="Workspace" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                    FontSize="18" Width="38" Height="38" Padding="0" Click="Settings_Click"
                    AutomationProperties.Name="Azure DevOps connection settings" Visibility="Collapsed"/>
        </Grid>
        <Popup x:Name="ConfigPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
               AllowsTransparency="True" StaysOpen="False" Opened="ConfigPopup_Opened" Closed="ConfigPopup_Closed">
            <Border x:Name="ConfigBorder" Width="420" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"
                    PreviewKeyDown="Config_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <Label Content="_Project URL" Target="{Binding ElementName=ProjectUrlBox}"/>
                    <TextBox x:Name="ProjectUrlBox" TextChanged="ProjectUrl_Changed"
                             AutomationProperties.Name="Azure DevOps project URL in connection settings"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="CheckButton" Content="_Check connection" Click="Check_Click" Margin="0,0,8,6"/>
                        <Button x:Name="SignInButton" Content="_Sign in &amp; load" Click="SignIn_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>
        <ScrollViewer x:Name="PageScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <StackPanel x:Name="ConnectionPage">
                    <Label Content="_Project URL" Target="{Binding ElementName=InlineProjectUrlBox}"/>
                    <TextBox x:Name="InlineProjectUrlBox" TextChanged="ProjectUrl_Changed"
                             AutomationProperties.Name="Azure DevOps project URL"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="InlineCheckButton" Content="_Check connection" Click="Check_Click" Margin="0,0,8,6"/>
                        <Button x:Name="InlineSignInButton" Content="_Sign in &amp; load" Click="SignIn_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="WorkspacePage" Visibility="Collapsed">
                    <Label Content="_Workspace name" Target="{Binding ElementName=WorkspaceNameBox}"/>
                    <TextBox x:Name="WorkspaceNameBox" TextChanged="WorkspaceName_Changed" MaxLength="120"
                             AutomationProperties.Name="Workspace name" Margin="0,0,0,16"/>
                    <Button x:Name="StartRepositoryButton" Content="_Add repository" Click="StartRepository_Click"
                            HorizontalAlignment="Left" Margin="0,0,0,18"/>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="EmptyRepositoriesText" Text="Repositories appear here after you add them."
                                       Style="{StaticResource HelpText}" TextAlignment="Center" Margin="16,46"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Grid x:Name="WorkspaceRepositoryHeaders" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1"><TextBlock Text="Repository" Style="{StaticResource HelpText}" Margin="8,10"/></Border>
                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1"><TextBlock Text="Starting branch" Style="{StaticResource HelpText}" Margin="8,10"/></Border>
                                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1"><TextBlock Text="Feature branch" Style="{StaticResource HelpText}" Margin="8,10"/></Border>
                                <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"/>
                            </Grid>
                            <ItemsControl x:Name="SelectedRepositoriesList" AutomationProperties.Name="Workspace repositories and branches">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid PreviewKeyDown="InlineEditor_PreviewKeyDown">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource RowCell}">
                                                    <Grid>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsRepositoryEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Selection.Repository.Name}" ToolTip="{Binding Selection.Repository.Name}" Style="{StaticResource RowValue}" FontWeight="SemiBold"/>
                                                            <Button Grid.Column="1" Style="{StaticResource InlinePencil}" Tag="Repository" Click="EditField_Click"
                                                                    ToolTip="Edit repository" AutomationProperties.Name="Edit repository"/>
                                                        </Grid>
                                                        <Grid Visibility="{Binding IsRepositoryEditing, Converter={StaticResource VisibleWhenTrue}}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                                            <ComboBox x:Name="InlineRepositorySearch" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                                                      Text="{Binding DraftRepositorySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      ItemsSource="{Binding RepositoryChoices}" DisplayMemberPath="Name"
                                                                      SelectedItem="{Binding SelectedRepository, Mode=OneWay}" SelectionChanged="InlineRepository_Changed"
                                                                      TextBoxBase.TextChanged="InlineRepositorySearch_Changed" IsEnabled="{Binding CanSearchRepositories}"
                                                                      MinHeight="30" FontSize="12" Margin="0,0,4,0" MaxDropDownHeight="160"
                                                                      AutomationProperties.Name="Search repositories"/>
                                                            <Button Grid.Column="1" Content="&#xE73E;" Click="SaveInlineEdit_Click" IsEnabled="{Binding CanSave}"
                                                                    Style="{StaticResource FieldCommand}" ToolTip="Save (Enter)" AutomationProperties.Name="Save repository"/>
                                                            <Button Grid.Column="2" Content="&#xE711;" Click="CancelInlineEdit_Click" IsEnabled="{Binding CanCancel}"
                                                                    Style="{StaticResource FieldCommand}" ToolTip="Cancel (Escape)" AutomationProperties.Name="Cancel repository edit"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource RowCell}">
                                                    <Grid>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsStartingBranchEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding StartingBranchDisplay}" ToolTip="{Binding StartingBranchDisplay}" Style="{StaticResource RowValue}"/>
                                                            <Button Grid.Column="1" Style="{StaticResource InlinePencil}" Tag="StartingBranch" Click="EditField_Click"
                                                                    ToolTip="Edit starting branch" AutomationProperties.Name="Edit starting branch"/>
                                                        </Grid>
                                                        <Grid Visibility="{Binding IsStartingBranchEditing, Converter={StaticResource VisibleWhenTrue}}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                                            <ComboBox x:Name="InlineBranchSearch" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                                                      Text="{Binding DraftStartingBranchSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      ItemsSource="{Binding StartingBranchChoices}" SelectedItem="{Binding SelectedStartingBranch, Mode=OneWay}"
                                                                      SelectionChanged="InlineBranch_Changed" TextBoxBase.TextChanged="InlineBranchSearch_Changed"
                                                                      IsEnabled="{Binding CanSearchBranches}" MinHeight="30" FontSize="12" Margin="0,0,4,0" MaxDropDownHeight="160"
                                                                      AutomationProperties.Name="Search starting branches"/>
                                                            <Button Grid.Column="1" Content="&#xE73E;" Click="SaveInlineEdit_Click" IsEnabled="{Binding CanSave}"
                                                                    Style="{StaticResource FieldCommand}" ToolTip="Save (Enter)" AutomationProperties.Name="Save starting branch"/>
                                                            <Button Grid.Column="2" Content="&#xE711;" Click="CancelInlineEdit_Click" IsEnabled="{Binding CanCancel}"
                                                                    Style="{StaticResource FieldCommand}" ToolTip="Cancel (Escape)" AutomationProperties.Name="Cancel starting branch edit"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource RowCell}">
                                                    <Grid>
                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsFeatureBranchEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Selection.FeatureBranch}" ToolTip="{Binding Selection.FeatureBranch}" Style="{StaticResource RowValue}"/>
                                                            <Button Grid.Column="1" Style="{StaticResource InlinePencil}" Tag="FeatureBranch" Click="EditField_Click"
                                                                    ToolTip="Edit feature branch" AutomationProperties.Name="Edit feature branch"/>
                                                        </Grid>
                                                        <Grid Visibility="{Binding IsFeatureBranchEditing, Converter={StaticResource VisibleWhenTrue}}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                                            <TextBox x:Name="InlineFeatureBox" Text="{Binding DraftFeatureBranch, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding CanEditFeatureBranch}" MinHeight="30" MaxLength="250" FontSize="12" Margin="0,0,4,0"
                                                                     AutomationProperties.Name="New feature branch"/>
                                                            <Button Grid.Column="1" Content="&#xE73E;" Click="SaveInlineEdit_Click" IsEnabled="{Binding CanSave}"
                                                                    Style="{StaticResource FieldCommand}" ToolTip="Save (Enter)" AutomationProperties.Name="Save feature branch"/>
                                                            <Button Grid.Column="2" Content="&#xE711;" Click="CancelInlineEdit_Click" IsEnabled="{Binding CanCancel}"
                                                                    Style="{StaticResource FieldCommand}" ToolTip="Cancel (Escape)" AutomationProperties.Name="Cancel feature branch edit"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="3" Padding="4,6" MinHeight="44">
                                                    <Button Content="Remove" Click="RemoveRepository_Click" IsEnabled="{Binding CanEdit}" Style="{StaticResource RowAction}"
                                                            VerticalAlignment="Center" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="RepositoryPage" Visibility="Collapsed">
                    <TextBlock x:Name="SourceProjectText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Label Content="_Repository" Target="{Binding ElementName=RepositoryBox}"/>
                    <ComboBox x:Name="RepositoryBox" DisplayMemberPath="Name" IsEnabled="False"
                              SelectionChanged="Repository_Changed" AutomationProperties.Name="Azure DevOps repository"/>
                </StackPanel>
                <StackPanel x:Name="BranchesPage" Visibility="Collapsed">
                    <TextBlock x:Name="BranchRepositoryText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Label Content="_Starting branch" Target="{Binding ElementName=BranchBox}"/>
                    <ComboBox x:Name="BranchBox" IsEnabled="False" SelectionChanged="Branch_Changed"
                              AutomationProperties.Name="Starting branch" Margin="0,0,0,18"/>
                    <Label Content="_Feature branch" Target="{Binding ElementName=FeatureBranchBox}"/>
                    <TextBox x:Name="FeatureBranchBox" Text="feature/DefaultNameReplaceMe" TextChanged="FeatureBranch_Changed"
                             AutomationProperties.Name="New feature branch" MaxLength="250"/>
                </StackPanel>
                <StackPanel x:Name="ReviewPage" Visibility="Collapsed">
                    <TextBox x:Name="ReviewFolderText" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Workspace destination" Margin="0,0,0,16"/>
                    <ContentControl Content="Repositories" ContentTemplate="{StaticResource RepositoryHeaders}" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="ReviewRepositoriesList" AutomationProperties.Name="Repositories to clone">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <StackPanel>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RepositorySummary}"/>
                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource HelpText}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                         AutomationProperties.Name="Azure DevOps operation in progress" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource HelpText}" AutomationProperties.LiveSetting="Polite"/>
            <TextBox x:Name="ErrorDetailsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" MaxHeight="130" Visibility="Collapsed" Margin="0,8,0,0"
                     Foreground="#FFACA9" AutomationProperties.Name="Operation error details"/>
            <Button x:Name="CheckExitButton" Content="Check process _exit" Click="CheckExit_Click"
                    Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel>
                <Button x:Name="BackButton" Content="_Back" Click="Back_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button x:Name="CancelOperationButton" Content="Cancel operation" Click="CancelOperation_Click" Visibility="Collapsed"/>
            </WrapPanel>
            <WrapPanel Grid.Column="1">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="80" Margin="0,0,8,0"/>
                <Button x:Name="NextButton" Content="_Next" Click="Next_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="AddRepositoryButton" Content="_Add repository" Click="AddRepository_Click"
                        Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="ChooseFolderButton" Content="Choose _folder…" Click="ChooseFolder_Click" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}" ToolTip="Choose the folder containing your new workspace."/>
                <Button x:Name="CloneButton" Content="_Clone &amp; download" Click="Clone_Click" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
