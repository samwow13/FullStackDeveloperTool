<UserControl x:Class="FullStackLauncher.DatabaseBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#111923"/><Setter Property="AlternatingRowBackground" Value="#1D2938"/>
            <Setter Property="AlternationCount" Value="2"/><Setter Property="BorderBrush" Value="#42546D"/>
            <Setter Property="GridLinesVisibility" Value="All"/><Setter Property="HorizontalGridLinesBrush" Value="#334255"/>
            <Setter Property="VerticalGridLinesBrush" Value="#42546D"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionMode" Value="Extended"/><Setter Property="SelectionUnit" Value="Cell"/>
            <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/><Setter Property="MinColumnWidth" Value="45"/>
            <Setter Property="RowHeight" Value="31"/><Setter Property="ColumnHeaderHeight" Value="33"/>
            <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#293B50"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#536981"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="ToolTip" Value="Drag the divider to resize. Drag a header to reorder. Click to sort."/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="9,6"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285D55"/><Setter Property="Foreground" Value="White"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="RelatedTableButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="#203C3B"/>
            <Setter Property="BorderBrush" Value="#397767"/>
        </Style>
        <Style x:Key="CopyMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <Grid TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource MutedBrush}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuFrame" Property="Background" Value="#30465C"/><Setter TargetName="MenuFrame" Property="BorderBrush" Value="#536981"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Background="#223549" CornerRadius="5,5,0,0" Padding="12,7" Margin="0,0,5,0" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#203C3B"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#397767"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#536981"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DatabaseTitle" Text="PostgreSQL" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ServerText" Text="Choose an existing connection" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Accounts…" Click="DatabaseAccounts_Click" Margin="0,0,6,0" Style="{StaticResource SmallButton}" ToolTip="View database users, set passwords, and add or remove accounts directly"/>
                    <Button Content="Compare &amp; migrate…" Click="DatabaseTools_Click" Margin="0,0,6,0" Style="{StaticResource SmallButton}" ToolTip="Compare two PostgreSQL schemas and review migrations for a selected target"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,6,0" Style="{StaticResource SmallButton}"/>
                    <Button x:Name="ChangeConnectionButton" Content="Connection…" Click="ChangeConnection_Click" Margin="0,0,6,0" Style="{StaticResource SmallButton}"/>
                    <Button x:Name="RefreshSchemaButton" Content="↻ Refresh" Click="RefreshSchema_Click" IsEnabled="False" Style="{StaticResource SmallButton}" ToolTip="Refresh tables and the selected view"/>
                    <Button Content="Hide" Click="HideDatabase_Click" Style="{StaticResource SmallButton}" Margin="6,0,0,0" ToolTip="Hide the database explorer; restore it with the Database section button" AutomationProperties.Name="Hide database explorer"/>
                </WrapPanel>
            </Grid>
            <StackPanel x:Name="ConnectionSettings" Grid.Row="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0"><Label Content="_Connection" Target="{Binding ElementName=ConnectionPicker}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,4" FontSize="10"/><ComboBox x:Name="ConnectionPicker" DisplayMemberPath="Label" SelectionChanged="Connection_SelectionChanged" AutomationProperties.Name="PostgreSQL connection" Padding="6,4" FontSize="11"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0"><Label Content="_Database" Target="{Binding ElementName=DatabasePicker}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,4" FontSize="10"/><ComboBox x:Name="DatabasePicker" SelectionChanged="Database_SelectionChanged" AutomationProperties.Name="Existing PostgreSQL databases" Padding="6,4" FontSize="11"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="AddConnectionButton" Content="Add connection…" Click="AddConnection_Click" Style="{StaticResource SmallButton}" Margin="0,0,6,0"/>
                        <Button x:Name="RefreshButton" Content="Reload connections" Click="Refresh_Click" Style="{StaticResource SmallButton}"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ConnectionNotice" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,7">
                    <Button x:Name="ToggleTablesButton" DockPanel.Dock="Left" Content="‹ Hide tables" Click="ToggleTables_Click" Padding="8,4" FontSize="10" Margin="0,0,10,0" ToolTip="Hide or restore the table navigator to give the results more room"/>
                    <TextBlock x:Name="ColumnsHeading" Text="Select a table" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TablesColumn" Width="205" MinWidth="150" MaxWidth="360"/><ColumnDefinition x:Name="TablesSplitterColumn" Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="TablesPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="TablesHeading" Text="TABLES / VIEWS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TableFilter" Grid.Row="1" TextChanged="TableFilter_TextChanged" AutomationProperties.Name="Filter tables by schema or name" ToolTip="Filter by schema or table name" Margin="0,0,0,6" Padding="7,4"/>
                        <ListBox x:Name="TableList" Grid.Row="2" SelectionChanged="Table_SelectionChanged" AutomationProperties.Name="Database tables and views" Background="#111923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,0,0,2"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <GridSplitter x:Name="TablesSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#334255" Cursor="SizeWE" ToolTip="Drag to resize the table navigator" AutomationProperties.Name="Resize table navigator"/>
                    <TabControl x:Name="TableTabs" Grid.Column="2" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" SelectionChanged="TableTabs_SelectionChanged">
                        <TabItem x:Name="SchemaTab" Header="_Columns">
                            <ScrollViewer x:Name="ColumnsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,6,0,0">
                                <DataGrid x:Name="ColumnGrid" CurrentCellChanged="Column_CurrentCellChanged" AutomationProperties.Name="PostgreSQL column definitions">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45" ElementStyle="{StaticResource GridText}"/>
                                        <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="165" ElementStyle="{StaticResource GridText}"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="145" ElementStyle="{StaticResource GridText}"/>
                                        <DataGridTextColumn Header="Nullable" Binding="{Binding Nullable}" Width="80" ElementStyle="{StaticResource GridText}"/>
                                        <DataGridTextColumn Header="Default / expression" Binding="{Binding DefaultExpression}" Width="200" ElementStyle="{StaticResource GridText}"/>
                                        <DataGridTextColumn Header="Generation" Binding="{Binding Generation}" Width="155" ElementStyle="{StaticResource GridText}"/>
                                        <DataGridTextColumn Header="Constraints" Binding="{Binding Constraints}" Width="270" ElementStyle="{StaticResource GridText}"/>
                                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="190" ElementStyle="{StaticResource GridText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Expander Header="Column details · select cells and press Ctrl+C to copy" Margin="0,6,0,0">
                                    <DockPanel Margin="0,6,0,0">
                                        <Button x:Name="CopyColumnButton" DockPanel.Dock="Right" Content="Copy definition" Click="CopyColumn_Click" IsEnabled="False" Style="{StaticResource SmallButton}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        <TextBox x:Name="ColumnDetail" Text="Select a column for its definition and constraints." IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="115" FontSize="11" AutomationProperties.Name="Selected column definition"/>
                                    </DockPanel>
                                </Expander>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="RowsTab" Header="Top _10 rows" AutomationProperties.Name="Top 10 rows">
                            <ScrollViewer x:Name="RowsViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,6,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="RefreshRowsButton" Content="↻ Query" Click="RefreshRows_Click" IsEnabled="False" Style="{StaticResource SmallButton}" Margin="0,0,8,0" ToolTip="Query up to ten rows again"/>
                                        <Button x:Name="CopyCellButton" Content="Copy cell" Click="CopyCell_Click" IsEnabled="False" Style="{StaticResource SmallButton}" Margin="0,0,6,0" ToolTip="Copy the active cell's displayed value; SQL NULL is copied as \N"/>
                                        <Button x:Name="CopyRowButton" Content="Copy row" Click="CopyRow_Click" IsEnabled="False" Style="{StaticResource SmallButton}" Margin="0,0,6,0" ToolTip="Copy the active row with column headers as tab-separated text"/>
                                        <Button x:Name="CopyResultsButton" Content="Copy results" Click="CopyResults_Click" IsEnabled="False" Style="{StaticResource SmallButton}" ToolTip="Copy all displayed preview rows with headers as tab-separated text"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RowsStatus" Text="Select a table to preview up to ten rows." Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </DockPanel>
                                <DataGrid x:Name="RowsGrid" CurrentCellChanged="Rows_CurrentCellChanged" SelectedCellsChanged="Rows_SelectedCellsChanged" PreviewMouseRightButtonDown="Rows_PreviewMouseRightButtonDown" AutomationProperties.Name="Top ten table rows" ToolTip="Ctrl+C copies selected cells. NULL displays ∅ and copies as \N. Empty strings display two quotes. Preview values are limited to 4,096 characters. Drag headers or dividers to reorder or resize columns.">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Background="#223044" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Opened="RowsContextMenu_Opened">
                                            <MenuItem x:Name="CopyCellMenu" Style="{StaticResource CopyMenuItem}" Header="Copy cell" Click="CopyCell_Click"/>
                                            <MenuItem x:Name="CopySelectionMenu" Style="{StaticResource CopyMenuItem}" Header="Copy selection" InputGestureText="Ctrl+C" Click="CopySelection_Click"/>
                                            <MenuItem x:Name="CopyRowMenu" Style="{StaticResource CopyMenuItem}" Header="Copy row with headers" Click="CopyRow_Click"/>
                                            <Separator/>
                                            <MenuItem x:Name="CopyResultsMenu" Style="{StaticResource CopyMenuItem}" Header="Copy results with headers" Click="CopyResults_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                                <Expander x:Name="CellDetailExpander" Header="Selected cell" IsExpanded="False" Margin="0,6,0,0">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="CellDetailHeading" Text="Select a cell to inspect its value." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CellDetail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="40" MaxHeight="105" FontFamily="Consolas" FontSize="11" AutomationProperties.Name="Selected cell value, read only and copyable"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock x:Name="ClipboardStatus" Visibility="Collapsed"/>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="RelationshipsTab" Header="_Relationships">
                            <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock x:Name="RelationshipsStatus" Text="Select a table to see its foreign key relationships." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border x:Name="RelationshipEmptyState" Visibility="Collapsed" Background="#1B2939" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="No relationships yet" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                                <TextBlock Text="No declared foreign keys connect this table to tables visible to your database role. You can keep browsing or refresh after adding a relationship." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    <StackPanel x:Name="RelationshipContent" Visibility="Collapsed">
                                        <Border Background="#1B2939" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <TextBlock Text="Foreign key (child) → referenced key (parent). Click a table to explore it. 0..1 = optional one; 0..many = any number. Multiplicities describe schema rules, not row counts. Only declared foreign keys between visible tables are shown; names and view dependencies are not inferred." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Border>
                                        <ItemsControl x:Name="RelationshipsList">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Background="#172432" BorderBrush="#3C526B" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Heading}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <Button Tag="{Binding Relationship.SourceTable}" Click="RelatedTable_Click" Style="{StaticResource RelatedTableButton}" Margin="0,0,7,6" ToolTip="Explore the referencing table"><TextBlock Text="{Binding Relationship.SourceTable.DisplayName}" TextWrapping="Wrap" MaxWidth="330"/></Button>
                                                            <TextBlock Text="{Binding Multiplicity}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,6"/>
                                                            <Button Tag="{Binding Relationship.TargetTable}" Click="RelatedTable_Click" Style="{StaticResource RelatedTableButton}" Margin="0,0,0,6" ToolTip="Explore the referenced table"><TextBlock Text="{Binding Relationship.TargetTable.DisplayName}" TextWrapping="Wrap" MaxWidth="330"/></Button>
                                                        </WrapPanel>
                                                        <TextBox Text="{Binding Relationship.ColumnMapping, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="8,6" AutomationProperties.Name="Foreign key column pairs"/>
                                                        <TextBlock Text="{Binding Behavior}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                                        <TextBlock Text="{Binding ValidationNote}" Foreground="#F0C987" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <Expander Header="Constraint details" Margin="0,6,0,0">
                                                            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" AutomationProperties.Name="Foreign key constraint definition"/>
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="Select a project to find its database connections." Foreground="{StaticResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Border>
</UserControl>
