<Window x:Class="FullStackLauncher.InstalledDesktopAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose desktop app" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="660" Height="510" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="InstalledAppRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="ToolTip" Value="{Binding FileName}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Installed desktop apps" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Padding="10,7" Margin="8,0,0,0"
                    AutomationProperties.Name="Refresh installed apps"/>
            <Label DockPanel.Dock="Left" Content="_Search" Target="{Binding ElementName=SearchInput}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Padding="0,0,10,0"/>
            <TextBox x:Name="SearchInput" MinHeight="34" TextChanged="Search_TextChanged" AutomationProperties.Name="Search installed apps"
                     ToolTip="Search app names or installation paths."/>
        </DockPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar x:Name="DiscoveryProgress" Height="3" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <ListBox x:Name="AppsList" Grid.Row="3" SelectionChanged="Apps_SelectionChanged" MouseDoubleClick="Apps_MouseDoubleClick"
                 ItemContainerStyle="{StaticResource InstalledAppRow}" AutomationProperties.Name="Installed desktop apps, alphabetical"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button Content="Choose executable…" Click="ChooseExecutable_Click" Padding="10,7" HorizontalAlignment="Left"
                    ToolTip="Choose an app that was not detected, including portable apps." AutomationProperties.Name="Choose another app executable"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" MinWidth="86" Margin="0,0,8,0"/>
                <Button x:Name="UseSelectedButton" Content="Use selected" Click="UseSelected_Click" IsDefault="True" IsEnabled="False" MinWidth="105"
                        Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Use selected installed app"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
