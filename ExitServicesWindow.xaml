<Window x:Class="FullStackLauncher.ExitServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit Full Stack Launcher" Width="640" Height="470" MinWidth="430" MinHeight="360"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize" Icon="/Assets/launcher.ico"
        AutomationProperties.Name="Choose whether to leave apps running before exiting">
    <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="EXIT LAUNCHER" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Leave apps running?" FontSize="27" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Your apps can keep running after Full Stack Launcher closes. Choose what happens to these active apps."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="RunningCount" FontWeight="SemiBold" Margin="0,0,0,10"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <ListBox x:Name="RunningServices" MaxHeight="175" MinHeight="48"
                                 AutomationProperties.Name="Active apps across all projects"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,7"/>
                                    <Setter Property="Margin" Value="0,0,0,3"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Top" Margin="0,6,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <TextBlock Text="Leave running keeps these apps active. The launcher will check their status when you reopen it."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,16,0,0" Margin="0,20,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="_Leave running &amp; exit" Click="LeaveRunning_Click"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                        AutomationProperties.Name="Leave running and exit"
                        AutomationProperties.HelpText="Close the launcher and keep the listed apps running."/>
                <Button Content="_Force stop &amp; exit" Click="ForceStop_Click"
                        Style="{StaticResource DangerButton}" Margin="0,0,8,8"
                        AutomationProperties.Name="Force stop and exit"
                        AutomationProperties.HelpText="Force stop the listed apps before closing the launcher."/>
                <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" Click="Cancel_Click"
                        MinWidth="84" Margin="0,0,0,8" AutomationProperties.Name="Cancel exit"
                        AutomationProperties.HelpText="Keep the launcher open without stopping any apps."/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
