<Window x:Class="FullStackLauncher.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="800" SizeToContent="Height" MinWidth="660" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/SetupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
            <Style x:Key="HelpText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderBrush" Value="#5B6B80"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0,8,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse x:Name="Outline" Fill="#111923" Stroke="#A6B4C9" StrokeThickness="1.5"/>
                                        <Ellipse x:Name="Dot" Fill="{StaticResource TextBrush}" Margin="4" Visibility="Collapsed"/>
                                    </Grid>
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                                      VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Outline" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Outline" Property="StrokeThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="StepText" Text="STEP 1 OF 3 · FOLDER" Style="{StaticResource HelpText}" FontWeight="SemiBold"/>
            <TextBlock x:Name="PageTitleText" Text="Choose your project folder" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,6"/>
            <TextBlock x:Name="IntroHelpText" Text="Select the top-level folder containing your project. We use it to find your services."
                       Style="{StaticResource HelpText}"/>
        </StackPanel>
        <ScrollViewer x:Name="PageScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Border x:Name="SourcePage" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <Button x:Name="LocalSourceButton" Click="LocalSource_Click" HorizontalContentAlignment="Left"
                                Padding="16" Margin="0,0,0,12" AutomationProperties.Name="Use local folder">
                            <StackPanel>
                                <TextBlock Text="Use local folder" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Add a project already on this computer." Style="{StaticResource HelpText}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemoteSourceButton" Click="RemoteSource_Click" HorizontalContentAlignment="Left"
                                Padding="16" AutomationProperties.Name="Integrate from DevOps or Git">
                            <StackPanel>
                                <TextBlock Text="Integrate from DevOps or Git" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Import an Azure DevOps repository and choose its branch. Other Git providers are coming next."
                                           Style="{StaticResource HelpText}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="FolderPage" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Project root folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RootPathBox" AutomationProperties.Name="Project root folder"
                                     TextChanged="RootPath_Changed" VerticalContentAlignment="Center"/>
                            <Button x:Name="BrowseRootButton" Grid.Column="1" Content="Browse…" Click="BrowseRoot_Click"
                                    Margin="8,0,0,0" AutomationProperties.Name="Browse project root folder"/>
                        </Grid>
                        <TextBlock x:Name="RootFolderHelpText" Text="Project type and working folders are detected when you continue."
                                   Style="{StaticResource HelpText}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="ServicesPage" Visibility="Collapsed">
                    <TextBlock x:Name="SelectedRootText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,14" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Project type" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <RadioButton x:Name="FullStackType" Content="Angular Full Stack" GroupName="ProjectType"
                                             IsChecked="True" Checked="ProjectType_Changed" Margin="0,0,24,0"
                                             AutomationProperties.Name="Angular Full Stack"/>
                                <RadioButton x:Name="ConsoleType" Content="Console project" GroupName="ProjectType"
                                             Checked="ProjectType_Changed" Margin="0,0,24,0" AutomationProperties.Name="Console project"/>
                                <RadioButton x:Name="FlutterDartType" Content="Flutter / Dart app" GroupName="ProjectType"
                                             Checked="ProjectType_Changed" AutomationProperties.Name="Flutter or Dart app"/>
                            </WrapPanel>
                            <TextBlock x:Name="TypeDetectionText" Style="{StaticResource HelpText}" Margin="0,4,0,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="Project name" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                            <TextBox x:Name="ProjectNameBox" AutomationProperties.Name="Project name"/>
                            <StackPanel x:Name="FlutterTargetPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock Text="Run target" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="FlutterTargetBox" SelectedIndex="0" AutomationProperties.Name="Flutter run target">
                                    <ComboBoxItem Content="Windows desktop"/>
                                    <ComboBoxItem Content="Web server"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DiscoveryPanel" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan again" Click="Scan_Click"
                                        Margin="10,0,0,0" AutomationProperties.Name="Scan project folder again"/>
                                <StackPanel>
                                    <TextBlock x:Name="DiscoveryTitleText" Text="Detected services" Foreground="{StaticResource TextBrush}"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ScanStatusText" Style="{StaticResource HelpText}" Margin="0,4,0,0"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="ApiFolderLabel" Text="API folder" Style="{StaticResource FieldLabel}"/>
                            <Grid x:Name="ApiFolderPanel" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ApiDirectoryBox" IsEditable="True"
                                          SelectionChanged="ServiceFolder_SelectionChanged" AutomationProperties.Name="Backend API working folder"/>
                                <Button x:Name="BrowseApiButton" Grid.Column="1" Content="Browse…" Click="BrowseApi_Click"
                                        Margin="8,0,0,0" AutomationProperties.Name="Browse backend API working folder"/>
                            </Grid>
                            <TextBlock x:Name="ApiFolderHelp" Text="Contains the API .csproj file." Style="{StaticResource HelpText}" Margin="0,0,0,14"/>
                            <TextBlock x:Name="AppFolderLabel" Text="Angular app folder" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="FrontendDirectoryBox" IsEditable="True"
                                          SelectionChanged="ServiceFolder_SelectionChanged" AutomationProperties.Name="Angular frontend working folder"/>
                                <Button x:Name="BrowseAppButton" Grid.Column="1" Content="Browse…" Click="BrowseFrontend_Click"
                                        Margin="8,0,0,0" AutomationProperties.Name="Browse Angular frontend working folder"/>
                            </Grid>
                            <TextBlock x:Name="AppFolderHelp" Text="Contains angular.json and package.json." Style="{StaticResource HelpText}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="ManualConfigurationWarning" Foreground="#FFD18A" TextWrapping="Wrap"
                                       Visibility="Collapsed" Margin="0,0,0,10"/>
                            <Expander Header="Scan details" Foreground="{StaticResource TextBrush}">
                                <ItemsControl x:Name="ScanNotesList" AutomationProperties.Name="Scan notes" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource HelpText}" Margin="0,0,0,5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ConsoleFolderText" Text="Review the console command and arguments next."
                               Style="{StaticResource HelpText}" Visibility="Collapsed" Margin="0,4,0,0"/>
                    <TextBlock x:Name="DatabaseHelpText" Text="Database details appear automatically from Local API configuration."
                               ToolTip="Connected means the database setting was discovered in this API's Local configuration."
                               Style="{StaticResource HelpText}" Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NextStepText" Text="Next: detect services." Style="{StaticResource HelpText}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="8,0,8,0"/>
                <Button x:Name="BackButton" Content="Back" Click="Back_Click" Visibility="Collapsed" MinWidth="84" Margin="0,0,8,0"/>
                <Button x:Name="ContinueButton" Content="Continue" Click="Continue_Click" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" MinWidth="128"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
