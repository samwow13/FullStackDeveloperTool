<Window x:Class="FullStackLauncher.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="820" Height="700" MinWidth="650" MinHeight="590"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="NEW PROJECT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Add a project" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,5"/>
            <TextBlock x:Name="IntroHelpText" Text="Choose a project type and folder. Review commands before saving."
                       Style="{StaticResource HelpText}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Project type" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FullStackType" Content="Full Stack Webapp" GroupName="ProjectType"
                                         IsChecked="True" Checked="ProjectType_Changed" Margin="0,0,24,0"
                                         AutomationProperties.Name="Full Stack Webapp"/>
                            <RadioButton x:Name="ConsoleType" Content="Console project" GroupName="ProjectType"
                                         Checked="ProjectType_Changed" AutomationProperties.Name="Console project"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Project name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ProjectNameBox" AutomationProperties.Name="Project name" MinHeight="34" Margin="0,0,0,14"/>
                        <TextBlock Text="Project root folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RootPathBox" AutomationProperties.Name="Project root folder"
                                     TextChanged="RootPath_Changed" MinHeight="34" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseRoot_Click"
                                    Margin="8,0,0,0" AutomationProperties.Name="Browse project root folder"/>
                        </Grid>
                        <TextBlock x:Name="RootFolderHelpText" Text="Choose the folder for your project. Paths may also be typed."
                                   Style="{StaticResource HelpText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="DiscoveryPanel" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button x:Name="ScanButton" DockPanel.Dock="Right" Content="Scan folder" Click="Scan_Click"
                                    Margin="10,0,0,0" AutomationProperties.Name="Scan project folder"/>
                            <StackPanel>
                                <TextBlock Text="Detected services" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Confirm each working folder before continuing." Style="{StaticResource HelpText}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="ScanStatusText" Style="{StaticResource HelpText}" Margin="0,0,0,12"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="Backend API folder" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ApiDirectoryBox" IsEditable="True" MinHeight="35"
                                      SelectionChanged="ServiceFolder_SelectionChanged"
                                      AutomationProperties.Name="Backend API working folder"/>
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseApi_Click"
                                    Margin="8,0,0,0" AutomationProperties.Name="Browse backend API working folder"/>
                        </Grid>
                        <TextBlock Text="Folder containing the API .csproj. You can type or browse when discovery misses it."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,14"/>
                        <TextBlock Text="Angular frontend folder" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="FrontendDirectoryBox" IsEditable="True" MinHeight="35"
                                      SelectionChanged="ServiceFolder_SelectionChanged"
                                      AutomationProperties.Name="Angular frontend working folder"/>
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseFrontend_Click"
                                    Margin="8,0,0,0" AutomationProperties.Name="Browse Angular frontend working folder"/>
                        </Grid>
                        <TextBlock Text="Folder containing angular.json and package.json. You can type or browse when discovery misses it."
                                   Style="{StaticResource HelpText}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="ManualConfigurationWarning" Foreground="#FFD18A" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ExistingFolderWarning" Foreground="#FFD18A" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,8"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="OpenSavedProjectButton" Content="View saved project"
                                Click="OpenSavedProject_Click" Visibility="Collapsed"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                AutomationProperties.Name="View saved project that uses these folders"/>
                        <ItemsControl x:Name="ScanNotesList" AutomationProperties.Name="Scan notes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource HelpText}" Margin="0,0,0,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NextStepText" Text="Next: review service commands and save project." Style="{StaticResource HelpText}"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" MinWidth="94" Margin="0,0,8,0"/>
                <Button x:Name="ContinueButton" Content="Continue" Click="Continue_Click" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" MinWidth="112"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
