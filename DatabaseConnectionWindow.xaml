<Window x:Class="FullStackLauncher.DatabaseConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save database connection" Width="660" Height="760" MinWidth="500" MinHeight="400"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" Icon="/Assets/launcher.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Add a database server" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Save work and home servers in one connection list. Credentials are encrypted for your Windows user, separate from launcher settings. Connecting verifies access without changing database data." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                <StackPanel x:Name="ConnectionFields">
                    <Label Content="_Label" Target="{Binding ElementName=ConnectionLabel}" Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="ConnectionLabel" MaxLength="100" ToolTip="A name such as Work reporting or Home development"/>
                    <Label Content="Database _type" Target="{Binding ElementName=ProviderPicker}" Foreground="{StaticResource TextBrush}"/>
                    <ComboBox x:Name="ProviderPicker" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="Database type">
                        <ComboBoxItem Content="PostgreSQL"/><ComboBoxItem Content="Microsoft SQL Server (SSMS)"/>
                    </ComboBox>
                    <CheckBox x:Name="AdvancedMode" Content="Use a connection string" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,12,0,4"/>
                    <StackPanel x:Name="StructuredFields">
                        <Label Content="_Server" Target="{Binding ElementName=ServerInput}" Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="ServerInput" MaxLength="512"/>
                        <TextBlock x:Name="ServerHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <StackPanel x:Name="PortFields">
                            <Label Content="_Port" Target="{Binding ElementName=PortInput}" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="PortInput" Text="5432" MaxLength="5"/>
                        </StackPanel>
                        <Label Content="_Database (optional)" Target="{Binding ElementName=DatabaseInput}" Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="DatabaseInput" MaxLength="128"/>
                        <TextBlock Text="Leave blank to use the login's default database. You can choose another database after connecting." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <StackPanel x:Name="AuthenticationFields" Visibility="Collapsed">
                            <Label Content="_Authentication" Target="{Binding ElementName=AuthenticationPicker}" Foreground="{StaticResource TextBrush}"/>
                            <ComboBox x:Name="AuthenticationPicker" SelectedIndex="0" SelectionChanged="Options_Changed" AutomationProperties.Name="SQL Server authentication">
                                <ComboBoxItem Content="Windows authentication (current Windows user)"/><ComboBoxItem Content="SQL Server authentication (username and password)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="CredentialFields">
                            <Label Content="_Username" Target="{Binding ElementName=UsernameInput}" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="UsernameInput" MaxLength="256"/>
                            <Label Content="Pass_word" Target="{Binding ElementName=PasswordInput}" Foreground="{StaticResource TextBrush}"/>
                            <PasswordBox x:Name="PasswordInput" MaxLength="4096" Padding="10,8" Foreground="{StaticResource TextBrush}" Background="#111923" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="CertificateFields">
                            <Label Content="_Root certificate path (optional)" Target="{Binding ElementName=RootCertificateInput}" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="RootCertificateInput" MaxLength="1024"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="AdvancedFields" Visibility="Collapsed">
                        <Label Content="_Connection string" Target="{Binding ElementName=ConnectionString}" Foreground="{StaticResource TextBrush}"/>
                        <PasswordBox x:Name="ConnectionString" MaxLength="32768" Padding="10,8" Foreground="{StaticResource TextBrush}" Background="#111923" BorderBrush="{StaticResource BorderBrush}"/>
                        <TextBlock x:Name="FormatHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SecurityHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/>
                <TextBlock Text="Both database types support browsing and same-type schema comparison. Application account editing and migration application currently support PostgreSQL only." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="#FFACA9" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Connect &amp; save" Click="Add_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
