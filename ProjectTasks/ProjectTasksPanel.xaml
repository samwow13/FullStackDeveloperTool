<UserControl x:Class="FullStackLauncher.ProjectTasks.ProjectTasksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="TaskCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TaskAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </UserControl.Resources>
    <Border Padding="22">
    <ScrollViewer x:Name="PanelScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="790" Height="{Binding ViewportHeight, ElementName=PanelScroller}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PROJECT NOTES &amp; QUEUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding ProjectName}" FontSize="25" FontWeight="SemiBold" Margin="0,7,12,3" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ProjectFolder}" Style="{StaticResource TaskCaption}" ToolTip="{Binding ProjectFolder}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <Button Content="Codex connection…" Click="CodexConnection_Click" IsEnabled="{Binding HasProject}" Margin="0,0,0,7"/>
                <Button Content="Reload notes" Command="{Binding ReloadCommand}" ToolTip="Reload saved notes after changes in another launcher. Unsaved drafts stay here for review."/>
                <TextBlock Text="Follows the dashboard project" Style="{StaticResource TaskCaption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#203631" BorderBrush="#397767" BorderThickness="1" CornerRadius="8" Padding="13,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Prepare your next tasks" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Capture notes, choose their order, and prepare a queue. Automatic execution is unavailable. Open Codex connection to explicitly run a separate, bounded connection check." TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*" MinWidth="420"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*" MinWidth="330"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0.8*" MinHeight="90"/><RowDefinition Height="Auto"/><RowDefinition Height="1.1*" MinHeight="165"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Notes" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding NoteCount}" Style="{StaticResource TaskCaption}"/></StackPanel>
                    <Button Grid.Column="1" Content="+ New note" Command="{Binding NewNoteCommand}" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="No notes yet. Start with a task name and a description below." Style="{StaticResource TaskCaption}" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Visibility><Binding Path="Notes.Count"><Binding.Converter><local:EmptyCountVisibilityConverter xmlns:local="clr-namespace:FullStackLauncher.ProjectTasks"/></Binding.Converter></Binding></TextBlock.Visibility>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" AutomationProperties.Name="Project notes" Padding="4">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Bullet}" Foreground="{StaticResource AccentBrush}" FontSize="17"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preview}" Style="{StaticResource TaskCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,8,0,3">
                    <Button Content="↑" Style="{StaticResource TaskAction}" Command="{Binding MoveNoteUpCommand}" AutomationProperties.Name="Move note up"/>
                    <Button Content="↓" Style="{StaticResource TaskAction}" Command="{Binding MoveNoteDownCommand}" AutomationProperties.Name="Move note down"/>
                    <Button Content="{Binding CompleteLabel}" Style="{StaticResource TaskAction}" Command="{Binding ToggleCompleteCommand}"/>
                    <Button Content="Add to queue →" Style="{StaticResource TaskAction}" Command="{Binding AddToQueueCommand}" ToolTip="Save note edits first. Adding to the queue does not start execution." ToolTipService.ShowOnDisabled="True"/>
                    <Button Content="Delete note" Style="{StaticResource TaskAction}" Click="DeleteNote_Click" IsEnabled="{Binding HasSelectedNote}" Foreground="#FFACA9"/>
                </WrapPanel>
                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13" IsEnabled="{Binding CanEdit}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{Binding EditorHeading}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DockPanel Grid.Row="1" LastChildFill="True">
                            <Label Content="Task _name" Target="{Binding ElementName=NoteName}" Foreground="{StaticResource MutedBrush}" Padding="0,8,10,0"/>
                            <TextBox x:Name="NoteName" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" ToolTip="Optional. The first nonempty description line supplies the initial name."/>
                        </DockPanel>
                        <Label Grid.Row="2" Content="_Description / Codex prompt" Target="{Binding ElementName=NotePrompt}" Foreground="{StaticResource MutedBrush}" Padding="0,9,0,5"/>
                        <TextBox x:Name="NotePrompt" Grid.Row="3" Text="{Binding EditorPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" MaxLength="100000" AutomationProperties.Name="Note description and Codex prompt"/>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="4" Margin="0,9,0,0">
                    <Button Content="_Save note" Command="{Binding SaveNoteCommand}" Style="{StaticResource PrimaryButton}" Padding="13,8" Margin="0,0,7,0"/>
                    <Button Content="Discard draft" Command="{Binding DiscardDraftCommand}" Padding="12,8"/>
                </WrapPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Queue" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding QueueCount}" Style="{StaticResource TaskCaption}"/>
                    <TextBlock Text="{Binding QueueStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,0"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="Add a saved note to prepare your first queue item." Style="{StaticResource TaskCaption}" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Visibility><Binding Path="Queue.Count"><Binding.Converter><local:EmptyCountVisibilityConverter xmlns:local="clr-namespace:FullStackLauncher.ProjectTasks"/></Binding.Converter></Binding></TextBlock.Visibility>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueue, Mode=TwoWay}" AutomationProperties.Name="Project task queue" Padding="4">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Options}" Style="{StaticResource TaskCaption}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,8,0,3">
                    <Button Content="↑" Style="{StaticResource TaskAction}" Command="{Binding MoveQueueUpCommand}" AutomationProperties.Name="Move queue item up"/>
                    <Button Content="↓" Style="{StaticResource TaskAction}" Command="{Binding MoveQueueDownCommand}" AutomationProperties.Name="Move queue item down"/>
                    <Button Content="{Binding ItemEnabledLabel}" Style="{StaticResource TaskAction}" Command="{Binding ToggleItemCommand}"/>
                    <Button Content="Remove from queue" Style="{StaticResource TaskAction}" Command="{Binding RemoveFromQueueCommand}"/>
                </WrapPanel>
                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="325">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Queue item settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Refresh models" Command="{Binding RefreshModelsCommand}" FontSize="11" Padding="8,6"/>
                        </Grid>
                        <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource TaskCaption}" Margin="0,8,0,8"/>
                        <Label Content="_Model" Target="{Binding ElementName=ModelChoice}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,5"/>
                        <ComboBox x:Name="ModelChoice" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChooseModel}"/>
                        <Label Content="_Thinking level" Target="{Binding ElementName=EffortChoice}" Foreground="{StaticResource MutedBrush}" Padding="0,8,0,5"/>
                        <ComboBox x:Name="EffortChoice" ItemsSource="{Binding Efforts}" SelectedItem="{Binding SelectedEffort, Mode=TwoWay}" DisplayMemberPath="Id" IsEnabled="{Binding CanChooseModel}" ToolTip="{Binding SelectedEffort.Description}"/>
                        <TextBlock Text="{Binding SavedQueueOptions}" Style="{StaticResource TaskCaption}" Margin="0,8,0,8"/>
                        <TextBlock Text="Assigned queue folder" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding AssignedFolder}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <StackPanel Visibility="{Binding FolderChanged, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                            <TextBlock Text="The project folder changed. The queue still uses its saved folder." TextWrapping="Wrap" Foreground="#FFD78A" FontSize="11"/>
                            <Button Content="Use current project folder" Command="{Binding UseCurrentFolderCommand}" FontSize="11" Padding="8,6" Margin="0,7,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding DraftStatus}" Style="{StaticResource TaskCaption}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding StorePath}" Style="{StaticResource TaskCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StorePath}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Save all drafts" Command="{Binding SaveAllDraftsCommand}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
    </Border>
</UserControl>
