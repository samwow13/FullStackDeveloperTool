<UserControl x:Class="FullStackLauncher.ProjectTasks.ProjectTasksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}" Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="TaskCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TaskAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="TaskPopupAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="QueueSettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#29374B"/>
            <Setter Property="BorderBrush" Value="#3A4B63"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#254D48"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Padding="22">
    <ScrollViewer x:Name="PanelScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="PanelScroller_ScrollChanged">
    <Grid MinHeight="740">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PROJECT NOTES &amp; QUEUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding ProjectName}" FontSize="25" FontWeight="SemiBold" Margin="0,7,12,3" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ProjectFolder}" Style="{StaticResource TaskCaption}" ToolTip="{Binding ProjectFolder}"/>
                <TextBlock Text="Follows the dashboard project" Style="{StaticResource TaskCaption}" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                <ToggleButton x:Name="QueueSettingsToggle" Width="42" Height="42"
                              VerticalAlignment="Top" Style="{StaticResource QueueSettingsToggleStyle}"
                              AutomationProperties.Name="Queue settings" AutomationProperties.HelpText="Show Codex connection, model, thinking level, delay between tasks, and assigned queue folder"
                              ToolTip="Queue settings and Codex connection">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19"/>
                </ToggleButton>
            </Grid>
            <Popup x:Name="QueueSettingsPopup" PlacementTarget="{Binding ElementName=QueueSettingsToggle}"
                   Placement="Custom" StaysOpen="True" AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=QueueSettingsToggle, Mode=TwoWay}" Opened="QueueSettings_Opened">
                <Border x:Name="QueueSettingsContent" Width="430" Background="{StaticResource SurfaceBrush}" DataContext="{Binding DataContext, ElementName=QueueSettingsToggle}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="13"
                        Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyDown="QueueSettings_KeyDown"
                        AutomationProperties.Name="Queue settings panel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="440">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="QUEUE SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="×" Click="CloseQueueSettings_Click" FontSize="15" Padding="7,2"
                                        AutomationProperties.Name="Close queue settings" ToolTip="Close queue settings"/>
                            </Grid>
                            <Button Content="Codex connection…" Click="CodexConnection_Click" IsEnabled="{Binding HasProject}"
                                    HorizontalAlignment="Left" FontSize="11" Padding="9,6" Margin="0,8,0,12"
                                    ToolTip="Open connection check and saved diagnostic history"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Codex model" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Refresh models" Command="{Binding RefreshModelsCommand}" FontSize="11" Padding="8,6"/>
                            </Grid>
                            <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource TaskCaption}" Margin="0,8,0,6"/>
                            <Button Content="Use Codex default" Command="{Binding UseCodexDefaultCommand}" FontSize="11" Padding="8,6" HorizontalAlignment="Left"
                                    ToolTip="Save the model and thinking level returned by the current Codex catalog." ToolTipService.ShowOnDisabled="True"/>
                            <Label Content="_Model" Target="{Binding ElementName=DefaultModelChoice}" Foreground="{StaticResource MutedBrush}" Padding="0,8,0,5"/>
                            <ComboBox x:Name="DefaultModelChoice" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedDefaultModel, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChooseDefaultModel}"/>
                            <Label Content="_Thinking level" Target="{Binding ElementName=DefaultEffortChoice}" Foreground="{StaticResource MutedBrush}" Padding="0,8,0,5"/>
                            <ComboBox x:Name="DefaultEffortChoice" ItemsSource="{Binding DefaultEfforts}" SelectedItem="{Binding SelectedDefaultEffort, Mode=TwoWay}" DisplayMemberPath="Id" IsEnabled="{Binding CanChooseDefaultModel}" ToolTip="{Binding SelectedDefaultEffort.Description}"/>
                            <TextBlock Text="{Binding DefaultOptionsStatus}" Style="{StaticResource TaskCaption}" Margin="0,8,0,11"/>
                            <Label Content="_Delay between tasks (minutes)" Target="{Binding ElementName=QueueDelayMinutes}" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,5"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="QueueDelayMinutes" Text="{Binding QueueDelayMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}" VerticalContentAlignment="Center" MaxLength="5"
                                         AutomationProperties.Name="Delay between tasks in minutes"/>
                                <Button Grid.Column="1" Content="Save delay" Command="{Binding SaveQueueDelayCommand}" FontSize="11" Padding="9,6" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Wait after a task completes successfully before starting the next task in this project's queue. 0 starts immediately. Changing the saved delay also adjusts a current wait."
                                       Style="{StaticResource TaskCaption}"/>
                            <TextBlock Text="{Binding QueueDelayStatus}" Style="{StaticResource TaskCaption}" Margin="0,6,0,11" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="Assigned queue folder" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding AssignedFolder}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <Border Visibility="{Binding FolderChanged, Converter={StaticResource BoolToVisibility}}"
                                    Background="#292721" BorderBrush="#735A38" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="FOLDER CHANGED" FontSize="10" FontWeight="Bold" Foreground="#FFD78A"/>
                                    <TextBlock Text="The project folder changed. The queue still uses its saved folder." TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                    <Button Content="Use current project folder" Command="{Binding UseCurrentFolderCommand}" FontSize="11" Padding="8,6" Margin="0,7,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Visibility="{Binding HasLegacyPredecessor, Converter={StaticResource BoolToVisibility}}"
                                    Background="#292721" BorderBrush="#735A38" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="OLD WAIT" FontSize="10" FontWeight="Bold" Foreground="#FFD78A"/>
                                    <TextBlock Text="This queue has an older external wait saved. Pause the queue before clearing it." FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Button Content="Clear old wait" Command="{Binding ClearPredecessorCommand}" FontSize="11" Padding="8,6" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Feedback}" Style="{StaticResource TaskCaption}" Margin="0,11,0,0" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,13">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="CODEX TASKS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActivitySummary}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="12,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button Grid.Column="2" Content="{Binding HistoryButtonLabel}" Click="TaskHistory_Click" FontSize="11" Padding="8,4" Margin="0,0,7,0"
                            IsEnabled="{Binding HasProject}" ToolTip="View archived task activity for this project and clear it all at once."/>
                    <Button Grid.Column="3" Content="All attempts…" Click="QueueAttempts_Click" FontSize="11" Padding="8,4"
                            ToolTip="Inspect saved task and turn IDs, exact outcomes, and review holds."/>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentTaskActivity}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="210" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="7,5" Margin="0,6,7,0" ToolTip="{Binding Detail}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                   FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="View Chat" Click="ViewTaskChat_Click"
                                                FontSize="10" Padding="4,1" Margin="4,0,0,0" MinHeight="20"
                                                AutomationProperties.Name="{Binding Name, StringFormat=View chat for {0}}"
                                                ToolTip="Read this attempt's saved request and Codex conversation so far">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AttemptId}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ToggleButton x:Name="TaskActionsToggle" Grid.Column="3" Content="⋯" Width="23" MinHeight="20"
                                                      FontSize="13" Margin="4,0,0,0" Padding="0" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Actions for {0}}"
                                                      ToolTip="Task actions">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource QueueSettingsToggleStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AttemptId}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                        <Popup PlacementTarget="{Binding ElementName=TaskActionsToggle}" Placement="Bottom"
                                               HorizontalOffset="-145" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                                               IsOpen="{Binding IsChecked, ElementName=TaskActionsToggle, Mode=TwoWay}"
                                               Opened="TaskActions_Opened" Closed="TaskActions_Closed">
                                            <Border Width="170" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="7" Padding="7"
                                                    DataContext="{Binding DataContext, ElementName=TaskActionsToggle}"
                                                    Focusable="True" KeyboardNavigation.TabNavigation="Cycle" KeyDown="TaskActions_KeyDown">
                                                <StackPanel>
                                                    <TextBlock Text="TASK ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="3,2,0,6"/>
                                                    <Button Content="Stop task…" Style="{StaticResource TaskPopupAction}" Click="StopTask_Click"
                                                            Visibility="{Binding CanStop, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Button Content="Re-attempt…" Style="{StaticResource TaskPopupAction}" Click="RetryTask_Click"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Button Content="Review attempt…" Style="{StaticResource TaskPopupAction}" Click="ReviewTask_Click"
                                                            Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Button Content="Move to History" Style="{StaticResource TaskPopupAction}" Click="ArchiveTask_Click"
                                                            Visibility="{Binding CanMoveToHistory, Converter={StaticResource BoolToVisibility}}"/>
                                                    <Button Content="Delete…" Style="{StaticResource TaskPopupAction}" Click="DeleteTask_Click"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                                            Foreground="#FFACA9" ToolTip="Remove tracked activity and abandon any unresolved queue hold. Saved receipt remains in All attempts."/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" MinWidth="520"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.8*" MinWidth="330"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="340"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Notes" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding NoteCount}" Style="{StaticResource TaskCaption}"/></StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Edit selected note" Click="OpenEditor_Click" IsEnabled="{Binding CanEdit}"
                                Visibility="{Binding HasSelectedNote, Converter={StaticResource BoolToVisibility}}" Margin="0,0,7,0"/>
                        <Button Content="+ New note" Click="NewNote_Click" IsEnabled="{Binding CanEdit}"/>
                    </WrapPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="No saved notes yet. Select + New note to write a task and add images." Style="{StaticResource TaskCaption}" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Visibility><Binding Path="Notes.Count"><Binding.Converter><local:EmptyCountVisibilityConverter xmlns:local="clr-namespace:FullStackLauncher.ProjectTasks"/></Binding.Converter></Binding></TextBlock.Visibility>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" MouseDoubleClick="Notes_MouseDoubleClick" AutomationProperties.Name="Project notes" Padding="4">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Notes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Bullet}" Foreground="{StaticResource AccentBrush}" FontSize="17"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Preview}" Style="{StaticResource TaskCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,8,0,3">
                    <Button Content="↑" Style="{StaticResource TaskAction}" Command="{Binding MoveNoteUpCommand}" AutomationProperties.Name="Move note up"/>
                    <Button Content="↓" Style="{StaticResource TaskAction}" Command="{Binding MoveNoteDownCommand}" AutomationProperties.Name="Move note down"/>
                    <Button Content="{Binding CompleteLabel}" Style="{StaticResource TaskAction}" Command="{Binding ToggleCompleteCommand}"/>
                    <Button Content="Add to queue →" Style="{StaticResource TaskAction}" Command="{Binding AddToQueueCommand}" ToolTip="Save note edits first. If the queue is enabled, this item may start immediately after it is added." ToolTipService.ShowOnDisabled="True"/>
                    <Button Content="Delete note" Style="{StaticResource TaskAction}" Click="DeleteNote_Click" IsEnabled="{Binding HasSelectedNote}" Foreground="#FFACA9"/>
                </WrapPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Queue" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding QueueCount}" Style="{StaticResource TaskCaption}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Enable Queue" Style="{StaticResource TaskAction}" Command="{Binding EnableAutoRunCommand}"
                                ToolTip="First eligible item may start immediately. Codex uses the assigned working folder; desktop placement may be under general Tasks."
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button Content="Pause Queue" Style="{StaticResource TaskAction}" Command="{Binding PauseQueueCommand}"
                                ToolTip="Prevent future dispatch. An already submitted task would continue." ToolTipService.ShowOnDisabled="True"/>
                        <Button Content="{Binding GlobalPauseLabel}" Style="{StaticResource TaskAction}" Command="{Binding ToggleGlobalPauseCommand}"
                                ToolTip="Clear resumes any already enabled project queues. This project's queue can be enabled separately." ToolTipService.ShowOnDisabled="True"/>
                    </WrapPanel>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#735A38" BorderThickness="1"
                            CornerRadius="7" Padding="10,8" Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#FFD78A" CornerRadius="2"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="QUEUE STATUS" FontSize="10" FontWeight="Bold" Foreground="#FFD78A"/>
                                <TextBlock Text="{Binding QueueStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="{Binding GlobalPauseStatus}" Foreground="#FFD78A" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <TextBlock Text="Add a saved note to prepare your first queue item." Style="{StaticResource TaskCaption}" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Visibility><Binding Path="Queue.Count"><Binding.Converter><local:EmptyCountVisibilityConverter xmlns:local="clr-namespace:FullStackLauncher.ProjectTasks"/></Binding.Converter></Binding></TextBlock.Visibility>
                        </TextBlock>
                        <ListBox ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueue, Mode=TwoWay}" AutomationProperties.Name="Project task queue" Padding="4" MaxHeight="240">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,8,0,3">
                    <Button Content="↑" Style="{StaticResource TaskAction}" Command="{Binding MoveQueueUpCommand}" AutomationProperties.Name="Move queue item up"/>
                    <Button Content="↓" Style="{StaticResource TaskAction}" Command="{Binding MoveQueueDownCommand}" AutomationProperties.Name="Move queue item down"/>
                    <Button Content="{Binding ItemEnabledLabel}" Style="{StaticResource TaskAction}" Command="{Binding ToggleItemCommand}"/>
                    <Button Content="Retry selected item…" Style="{StaticResource TaskAction}" Click="RetrySelectedItem_Click"
                            IsEnabled="{Binding CanRetrySelectedItem}"
                            ToolTip="Create a new attempt for a confirmed terminal or reviewed held item. Queue stays paused until Enable Queue."
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button Content="Remove from queue" Style="{StaticResource TaskAction}" Command="{Binding RemoveFromQueueCommand}"/>
                </WrapPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding DraftStatus}" Style="{StaticResource TaskCaption}" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding StorePath}" Style="{StaticResource TaskCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StorePath}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Save all drafts" Command="{Binding SaveAllDraftsCommand}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
    </Border>
</UserControl>
