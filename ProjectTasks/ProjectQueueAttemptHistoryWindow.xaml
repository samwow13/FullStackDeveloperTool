<Window x:Class="FullStackLauncher.ProjectTasks.ProjectQueueAttemptHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queue attempts — Full Stack Launcher" Width="940" Height="720"
        MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/launcher.ico" Closing="Window_Closing"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="QUEUE ATTEMPTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Saved queue attempts" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,3"/>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"/>
            <TextBlock Text="Delete removes task tracking and abandons an unresolved queue hold. Saved receipts keep their original outcomes; deleted attempts remain available under Show all."
                       Style="{StaticResource Caption}" Margin="0,5,0,0"/>
            <DockPanel Margin="0,9,0,0">
                <Button DockPanel.Dock="Right" Content="Reload attempts" Click="Reload_Click" Margin="8,0,0,0"/>
                <CheckBox IsChecked="{Binding ShowAllHistory, Mode=TwoWay}" VerticalAlignment="Center"
                          Content="Show completed, reviewed, and deleted attempts" AutomationProperties.Name="Show completed, reviewed, and deleted queue attempts"/>
            </DockPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="245"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.4*" MinWidth="360"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ListBox ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt, Mode=TwoWay}"
                         AutomationProperties.Name="Saved queue attempts" Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,4">
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Attempt details" FontSize="16" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" MaxHeight="230"
                                 AutomationProperties.Name="Selected queue attempt details"/>
                        <TextBlock Text="{Binding ActionHint}" Style="{StaticResource Caption}" Margin="0,2,0,8"/>
                        <WrapPanel>
                            <Button Content="Dismiss hold (no submission recorded)…" Click="Dismiss_Click"
                                    IsEnabled="{Binding CanDismissSelected}" Margin="0,0,8,7"/>
                            <Button Content="Review and release hold" Click="Review_Click"
                                    IsEnabled="{Binding CanReviewSelected}" Margin="0,0,8,7"/>
                            <Button Content="Delete tracked attempt…" Click="Delete_Click"
                                    IsEnabled="{Binding CanDeleteSelected}" Foreground="#FFACA9" Margin="0,0,0,7"/>
                        </WrapPanel>
                        <TextBlock Text="Result summary" FontWeight="SemiBold" Margin="0,11,0,4"/>
                        <TextBox Text="{Binding SelectedSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" MaxHeight="105"
                                 AutomationProperties.Name="Selected queue attempt result summary"/>
                        <Expander Header="Saved final response" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}">
                            <TextBox Text="{Binding SelectedFinalResponse, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" MaxHeight="150"
                                     AutomationProperties.Name="Selected queue attempt final response"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,12,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1" Content="Close" Click="Close_Click" Margin="16,0,0,0" VerticalAlignment="Top"/>
            </Grid>
        </Border>
    </Grid>
</Window>
