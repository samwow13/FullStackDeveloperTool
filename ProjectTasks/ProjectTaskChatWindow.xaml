<Window x:Class="FullStackLauncher.ProjectTasks.ProjectTaskChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Chat — Full Stack Launcher" Width="920" Height="760"
        MinWidth="620" MinHeight="470" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/launcher.ico"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="ChatCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ChatReadout" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,13">
            <TextBlock Text="CODEX TASK CHAT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{Binding TaskName}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,3"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TaskIdentity}" Style="{StaticResource ChatCaption}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Saved task request" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Request frozen when this queue attempt was prepared." Style="{StaticResource ChatCaption}"
                           Margin="0,3,0,7"/>
                <TextBox Text="{Binding SavedRequest, Mode=OneWay}" Style="{StaticResource ChatReadout}"
                         MaxHeight="145" AutomationProperties.Name="Saved task request"/>
                <TextBlock Text="{Binding SavedImages}" Style="{StaticResource ChatCaption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="13">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,9">
                    <TextBlock Text="Codex chat" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RefreshDescription}" Style="{StaticResource ChatCaption}" Margin="0,3,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Codex chat history">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource ChatCaption}" Margin="0,4,0,8"/>
                        <ItemsControl ItemsSource="{Binding ChatEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PhaseLabel}" Style="{StaticResource ChatCaption}"
                                                           Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </DockPanel>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,11,0,0" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="_Refresh" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}"
                            Margin="0,0,8,0" AutomationProperties.Name="Refresh Codex chat"/>
                    <Button Content="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
