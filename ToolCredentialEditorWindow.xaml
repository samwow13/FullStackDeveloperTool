<Window x:Class="FullStackLauncher.ToolCredentialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login profile" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CredentialLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="CredentialKindChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="#203C3B"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#34695F"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel x:Name="FieldsPanel">
                    <Label Content="_Name" Target="{Binding ElementName=NameInput}" Style="{StaticResource CredentialLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameInput" MinHeight="36" MaxLength="80" TextChanged="Field_Changed" AutomationProperties.Name="Login profile name"/>
                    <Label Content="Type" Style="{StaticResource CredentialLabel}"/>
                    <Grid KeyboardNavigation.TabNavigation="Once">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <RadioButton x:Name="WindowsKind" GroupName="CredentialKind" Content="Windows _account"
                                     Style="{StaticResource CredentialKindChoice}" Checked="Kind_Checked" AutomationProperties.Name="Windows account"/>
                        <RadioButton x:Name="WebsiteKind" Grid.Column="2" GroupName="CredentialKind" Content="Website _login"
                                     Style="{StaticResource CredentialKindChoice}" Checked="Kind_Checked" AutomationProperties.Name="Website login"/>
                    </Grid>
                    <StackPanel x:Name="OriginPanel">
                        <Label Content="Website _origin" Target="{Binding ElementName=OriginInput}" Style="{StaticResource CredentialLabel}"/>
                        <TextBox x:Name="OriginInput" MinHeight="36" MaxLength="2048" TextChanged="Field_Changed"
                                 ToolTip="Exact website origin, for example https://example.com. HTTPS is required except loopback HTTP. Do not include a path, query, or fragment."
                                 AutomationProperties.Name="Exact website origin"/>
                    </StackPanel>
                    <Label Content="_User name" Target="{Binding ElementName=UserNameInput}" Style="{StaticResource CredentialLabel}"/>
                    <TextBox x:Name="UserNameInput" MinHeight="36" MaxLength="513" TextChanged="Field_Changed" AutomationProperties.Name="Login user name"/>
                    <Label x:Name="PasswordLabel" Content="_Password" Target="{Binding ElementName=PasswordInput}" Style="{StaticResource CredentialLabel}"/>
                    <PasswordBox x:Name="PasswordInput" MinHeight="36" MaxLength="1280" PasswordChanged="Password_Changed" AutomationProperties.Name="Login password"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <ProgressBar x:Name="WorkProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Saving login profile"/>
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#38272F" BorderBrush="#66404C"
                    BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFACA9" FontSize="12"
                           AutomationProperties.Name="Credential profile error" AutomationProperties.LiveSetting="Assertive"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="86" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="_Save" IsDefault="True" Click="Save_Click" MinWidth="96"
                    Style="{StaticResource PrimaryButton}"
                    ToolTip="Save this profile immediately in Windows Credential Manager. Tool assignment applies when you save tools."/>
        </StackPanel>
    </Grid>
</Window>
