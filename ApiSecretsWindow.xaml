<Window x:Class="FullStackLauncher.ApiSecretsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API configuration secrets" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="1040" Height="820" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SecretHelp" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SecretLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="API configuration secrets" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="ServiceNameText" Margin="0,5,0,0" Style="{StaticResource SecretHelp}" />
        </StackPanel>
        <Border x:Name="ProfilePanel" Grid.Row="1" Padding="16" Margin="0,0,0,16"
                CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource CardBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock x:Name="ProfileHeadingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProfileHelpText" Margin="0,5,0,0" Style="{StaticResource SecretHelp}" />
                    <TextBlock x:Name="StoreReferenceText" Margin="0,5,0,0" Style="{StaticResource SecretHelp}" />
                    <TextBlock Text="Choosing a store here only changes what you edit. Use the dashboard to activate Local or Prod."
                               Margin="0,5,0,0" Style="{StaticResource SecretHelp}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="LocalButton" Content="Edit _Local" Click="Local_Click" MinWidth="100" Margin="0,0,8,0"
                            AutomationProperties.Name="Edit Local configuration store" />
                    <Button x:Name="ProdButton" Content="Edit _Prod" Click="Prod_Click" MinWidth="100"
                            AutomationProperties.Name="Edit Prod configuration store" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.03*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Configuration keys" Target="{Binding ElementName=SearchBox}" Style="{StaticResource SecretLabel}" />
                    <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="Search_TextChanged" Margin="0,0,0,10"
                             AutomationProperties.Name="Filter configuration keys" ToolTip="Filter by key or appsettings filename" />
                    <Grid Grid.Row="2">
                        <ListBox x:Name="KeysList" SelectionChanged="Keys_SelectionChanged"
                                 AutomationProperties.Name="Configuration keys and override status">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Source}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyKeysText" Text="No keys yet. Add a configuration key in the editor."
                                   Margin="10,18" Style="{StaticResource SecretHelp}" IsHitTestVisible="False" />
                    </Grid>
                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button x:Name="NewButton" Content="＋ _New key" Click="New_Click" Margin="0,0,8,0" />
                        <Button x:Name="ReloadButton" Content="_Reload" Click="Reload_Click" Margin="0,0,8,8" />
                        <Button x:Name="ImportLegacyButton" Content="_Import legacy values" Click="ImportLegacy_Click" Margin="0,0,0,8"
                                AutomationProperties.Name="Import this profile's legacy plaintext values into a draft"
                                ToolTip="Read this profile's original .NET user-secrets into a replacement draft. Save encrypts the copy; the original file remains unchanged." />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EditorPanel" Margin="0,0,6,0">
                        <TextBlock Text="Add or update an override" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
                        <Label Content="Configuration _key" Target="{Binding ElementName=KeyBox}" Style="{StaticResource SecretLabel}" />
                        <TextBox x:Name="KeyBox" TextChanged="Editor_TextChanged" AutomationProperties.Name="Configuration key" />
                        <TextBlock Text="Use colon-separated keys, such as ConnectionStrings:DefaultConnection. A different key adds a separate override."
                                   Style="{StaticResource SecretHelp}" Margin="0,7,0,16" />
                        <Label x:Name="ValueLabel" Content="_Value" Target="{Binding ElementName=ValuePasswordBox}" Style="{StaticResource SecretLabel}" />
                        <PasswordBox x:Name="ValuePasswordBox" PasswordChanged="Value_PasswordChanged" MinHeight="40"
                                     Foreground="{DynamicResource TextBrush}" Background="#111923"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="10,8"
                                     AutomationProperties.Name="Secret value, masked" />
                        <TextBox x:Name="RevealedValueBox" Visibility="Collapsed" TextChanged="Revealed_TextChanged"
                                 MinHeight="40" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="130"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Revealed secret value" />
                        <CheckBox x:Name="RevealCheckBox" Content="Reveal this value" Margin="0,9,0,0"
                                  Foreground="{DynamicResource TextBrush}" Checked="Reveal_Changed" Unchecked="Reveal_Changed" />
                        <TextBlock Text="Values stay masked unless you reveal them. An empty value is a valid override; remove the key to use other configuration sources."
                                   Style="{StaticResource SecretHelp}" Margin="0,10,0,16" />
                        <WrapPanel>
                            <Button x:Name="ApplyButton" Content="_Stage value" Click="Apply_Click" Margin="0,0,8,8"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button x:Name="RemoveButton" Content="_Remove override" Click="Remove_Click" Margin="0,0,0,8"
                                    Style="{StaticResource DangerButton}" />
                        </WrapPanel>
                        <Button x:Name="CancelEditButton" Content="_Undo editor changes" Click="CancelEdit_Click"
                                HorizontalAlignment="Left" Padding="10,6" Margin="0,0,0,12" />
                        <TextBlock x:Name="DraftText" Style="{StaticResource SecretHelp}" />
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="How these values are stored" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Local and Prod overrides are encrypted with Windows DPAPI for your Windows user, outside the repository. Temporary files and backups are encrypted too. Nothing is uploaded to a deployment."
                                           Style="{StaticResource SecretHelp}" />
                                <TextBlock Text="Import legacy values reads only this profile's original .NET user-secrets into a draft. Save creates an encrypted launcher copy. The original plaintext file remains unchanged so direct dotnet commands continue to work; protect that file separately."
                                           Style="{StaticResource SecretHelp}" Margin="0,10,0,0" />
                                <TextBlock Text="Activate or restart the selected profile after saving. Launcher saves do not change configuration used by ordinary dotnet commands. An empty encrypted profile remains authoritative."
                                           Style="{StaticResource SecretHelp}" Margin="0,10,0,0" />
                                <TextBlock x:Name="AppSettingsHint" Style="{StaticResource SecretHelp}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="PendingText" Style="{StaticResource SecretHelp}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CloseButton" Content="_Close" Click="Close_Click" Margin="0,0,10,0" MinWidth="90" />
                <Button x:Name="SaveButton" Content="_Save changes" Click="Save_Click" MinWidth="130"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
