{
  "manifest_version": 3,
  "name": "FullStack Launcher Page Context",
  "version": "1.2.0",
  "description": "Capture selected page context, open launcher frontends, and fill saved website logins on explicit launcher Open actions.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "FullStack Launcher Page Context setup"
  }
}
