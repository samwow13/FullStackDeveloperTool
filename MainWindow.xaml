                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                                <DockPanel Margin="0,0,0,8">
                                                                    <Button DockPanel.Dock="Right" Content="×" HorizontalAlignment="Right" Padding="7,2" FontSize="14"
                                                                            Tag="{Binding ElementName=StatisticsPopup}" Click="CloseStatistics_Click" AutomationProperties.Name="Close statistics"/>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                                </DockPanel>
                                                                <ScrollViewer Grid.Row="1" MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Text="Lines" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding SourceLines.Value}" Foreground="{Binding SourceLines.Foreground}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                                   AutomationProperties.Name="Code lines" AutomationProperties.LiveSetting="Polite" ToolTipService.ShowDuration="30000">
                                                                            <TextBlock.ToolTip><ToolTip><TextBlock Text="{Binding SourceLines.Details}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip>
                                                                        </TextBlock>
                                                                        <Button Grid.Column="2" Content="{Binding SourceLines.CountButtonLabel}" Click="CountServiceLines_Click" IsEnabled="{Binding SourceLines.CanCount}"
                                                                                MinWidth="76" Padding="8,5" FontSize="11" AutomationProperties.Name="{Binding Name, StringFormat=Count source code lines for {0}}"/>
                                                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="3" IsIndeterminate="True" Margin="0,6,0,4" Foreground="{StaticResource AccentBrush}" Background="#111923" BorderThickness="0"
                                                                                     Visibility="{Binding SourceLines.IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Counting code lines"/>
                                                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding SourceLines.Error}" Foreground="#FFD27A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"
                                                                                   Visibility="{Binding SourceLines.HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                                                                        <TextBlock Grid.Row="3" Text="Avg / file" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                                                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SourceLines.AverageValue}" FontSize="14" VerticalAlignment="Center" Margin="0,9,10,0" AutomationProperties.Name="Average lines per file" AutomationProperties.LiveSetting="Polite" ToolTipService.ShowDuration="30000">
                                                                            <TextBlock.ToolTip><ToolTip><TextBlock Text="{Binding SourceLines.Details}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip>
                                                                        </TextBlock>
                                                                        <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="{Binding ShowApiDatabaseLabel, Converter={StaticResource BoolToVisibility}}">
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                            <TextBlock Text="Endpoints" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding ApiEndpoints.Value}" Foreground="{Binding ApiEndpoints.Foreground}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                                       AutomationProperties.Name="API endpoints" AutomationProperties.LiveSetting="Polite" ToolTipService.ShowDuration="30000">
                                                                                <TextBlock.ToolTip><ToolTip><TextBlock Text="{Binding ApiEndpoints.Details}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></TextBlock.ToolTip>
                                                                            </TextBlock>
                                                                            <Button Grid.Column="2" Content="{Binding ApiEndpoints.ButtonLabel}" Click="CountApiEndpoints_Click" IsEnabled="{Binding ApiEndpoints.CanCount}"
                                                                                    MinWidth="76" Padding="8,5" FontSize="11" AutomationProperties.Name="{Binding Name, StringFormat=Count API endpoints for {0}}"/>
                                                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="3" IsIndeterminate="True" Margin="0,6,0,4" Foreground="{StaticResource AccentBrush}" Background="#111923" BorderThickness="0"
                                                                                         Visibility="{Binding ApiEndpoints.IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Counting API endpoints"/>
                                                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ApiEndpoints.Status}" Foreground="#FFD27A" FontSize="11" TextWrapping="Wrap" Margin="0,6,10,0"
                                                                                       Visibility="{Binding ApiEndpoints.HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                                                                            <Button Grid.Row="3" Grid.Column="1" Content="Details…" Click="ApiEndpoints_Click" Padding="0,3" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"
                                                                                    Visibility="{Binding ApiEndpoints.HasResult, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="API endpoint details"/>
                                                                            <Button Grid.Row="3" Grid.ColumnSpan="3" Content="Select branch…" Click="SelectStatisticsBranch_Click" Padding="0,3" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                                                                    Tag="{Binding ElementName=StatisticsPopup}" Visibility="{Binding ApiEndpoints.NeedsBranch, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Select tracked branch for endpoint count"/>
                                                                        </Grid>
                                                                    </Grid>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </Border>
                                                    </Popup>
                                                </WrapPanel>
                                                <Border Grid.Column="1" Background="#111923" CornerRadius="5" Padding="10,5" VerticalAlignment="Top" ToolTip="{Binding Detail}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding StateColor}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CardStatus}" Foreground="{Binding StateColor}" FontWeight="SemiBold" FontSize="12" AutomationProperties.HelpText="{Binding Detail}"/>
                                                    </StackPanel>
                                                </Border>
                                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                                                    <Border Style="{StaticResource ServiceMetadata}" Visibility="{Binding ShowServiceTypeLabel, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding ServiceTypeLabel}" Foreground="#CCD7E7" FontSize="13" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Background="{Binding ConfigurationBackground}" BorderBrush="{Binding ConfigurationBorder}" BorderThickness="1"
                                                            Visibility="{Binding HasApiConfiguration, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding ConfigurationStatus}" Foreground="{Binding ConfigurationColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Background="#3D202A" BorderBrush="#E96B78" BorderThickness="1"
                                                            Visibility="{Binding HasOutputError, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Error in output" Foreground="#FFACA9" FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                        </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Directory}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" Margin="0,8,0,0"
                                                   Visibility="{Binding ShowCommandFolder, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Service working folder"/>
                                        <Border Background="#121A25" CornerRadius="5" Padding="8,6" Margin="0,8,0,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasApiConfiguration}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Command}" FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,2,0,7"
                                                   Visibility="{Binding HasCardDetail, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding ProcessTrackingHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"
                                                   Visibility="{Binding ShowProcessTrackingHint, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Resolve conflict &amp; restart" Click="ResolveConflict_Click" IsEnabled="{Binding CanResolveConflict}"
                                                Margin="0,0,0,8" Padding="8,7" FontSize="11"
                                                ToolTip="Review and stop the processes blocking this service's port, then restart the service.">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                     </StackPanel>
                                     </Expander>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8"
                                        Visibility="{Binding HasVerifiedDatabaseCard, Converter={StaticResource BoolToVisibility}}">
                                    <Expander Style="{StaticResource ServiceCardExpander}" AutomationProperties.Name="{Binding DatabaseCardName}"
                                              AutomationProperties.HelpText="{Binding DatabaseCardDetails}">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DatabaseCardName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/>
                                                        <ToggleButton Content="Change DB" Click="ChangeDatabase_Click" Style="{StaticResource ServiceUtilityToggle}" Padding="9,5" FontSize="11"
                                                                IsEnabled="{Binding CanChangeDatabase}" AutomationProperties.Name="Change API database"
                                                                ToolTip="Change the Local API connection and restart that API." ToolTipService.ShowOnDisabled="True"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Name, StringFormat=Discovered through {0}}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#111923" CornerRadius="5" Padding="10,5" VerticalAlignment="Top" ToolTip="{Binding DatabaseCardDetails}">
                                                    <TextBlock Text="{Binding DatabaseCardStatus}" Foreground="{Binding DatabaseCardStatusColor}" FontWeight="SemiBold" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Margin="29,8,0,0">
                                            <TextBlock Text="{Binding DatabaseCardDetails}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                                <ItemsControl ItemsSource="{Binding FlutterDatabases}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                            <Expander Style="{StaticResource ServiceCardExpander}" AutomationProperties.Name="{Binding Name}"
                                                      AutomationProperties.HelpText="{Binding Details}">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                                            <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#111923" CornerRadius="5" Padding="10,5" VerticalAlignment="Top" ToolTip="{Binding Details}">
                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                                                        </Border>
                                                    </Grid>
                                                </Expander.Header>
                                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="29,8,0,0"/>
                                            </Expander>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                <StackPanel x:Name="EmptyWorkspace" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Room to focus" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Reopen a section above whenever you need it." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16"/>
                    <Button Content="Show services" Click="ShowServices_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <controls:CodexActivityStrip Grid.Row="4" Margin="0,14,0,0" VisibleAgents="{Binding CodexCrewVisibleAgents, Mode=TwoWay}"
                                         WatcherRequested="CodexAlerts_Click"/>
            <Grid Grid.Row="5" Margin="0,14,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"/><TextBlock Grid.Column="1" Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="15,0,0,0"/></Grid>
        </Grid>
        <GridSplitter x:Name="NextCommitSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,24,0,16"
                      Background="{StaticResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      Visibility="Collapsed" Focusable="True" AutomationProperties.Name="Resize next commit panel"/>
        <Border x:Name="NextCommitPanel" Grid.Column="3" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,24,22,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Next commit" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <ToggleButton x:Name="NextCommitSettingsToggle" Style="{StaticResource NextCommitSettingsButton}"
                                      PreviewKeyDown="NextCommitSettingsToggle_PreviewKeyDown" ToolTip="Next commit settings"
                                      AutomationProperties.Name="Next commit settings" AutomationProperties.HelpText="Choose repository and PR sound reminder. Click outside or press Escape to close."/>
                        <Popup x:Name="NextCommitSettingsMenu" PlacementTarget="{Binding ElementName=NextCommitSettingsToggle}" Placement="Bottom" VerticalOffset="6"
                               IsOpen="{Binding IsChecked, ElementName=NextCommitSettingsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="NextCommitSettingsMenu_Opened">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Width="320"
                                    PreviewKeyDown="NextCommitSettingsMenu_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle">
                                <StackPanel>
                                    <TextBlock Text="Next commit settings" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Label Content="_Repository" Target="{Binding ElementName=NextCommitRepositoryPicker}" Padding="0,0,0,5" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    <ComboBox x:Name="NextCommitRepositoryPicker" ItemsSource="{Binding NextCommitRepositories}" SelectedItem="{Binding SelectedNextCommitRepository, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedNextCommitRepository.RepositoryRoot}" AutomationProperties.Name="Next commit repository"/>
                                    <TextBlock Text="{Binding NextCommitStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                                    <TextBlock Text="{Binding NextCommitCharacterCount}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <CheckBox Content="_PR sound reminder" Style="{StaticResource LongRunningTaskCheckBox}"
                                              IsChecked="{Binding NextCommitPrReminderEnabled, Mode=TwoWay}" Margin="0,8,0,0"
                                              AutomationProperties.Name="Enable PR sound reminder for commit message length"
                                              ToolTip="Off by default for each launcher session. First sound after 5 minutes, then every 5 minutes while this panel is visible and the selected commit message exceeds 3,000 characters."/>
                                    <TextBlock Text="Sound every 5 minutes above 3,000 message characters to remind you to make a PR. Counts message text, not code diff size."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource HideSectionButton}" Tag="NextCommit" Click="HideSection_Click" HorizontalAlignment="Right" AutomationProperties.Name="Hide next commit"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Git comparison" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="DashboardGitOptions_Click" Padding="6,4" Background="Transparent"
                                        ToolTip="Git comparison options" AutomationProperties.Name="Git comparison options">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource ServiceToolContextMenu}">
                                            <MenuItem Header="Git-only conflict test" Style="{StaticResource ServiceToolMenuItem}" Click="DashboardGitConflictCheck_Click"
                                                      IsEnabled="{Binding CanRequestDashboardGitCheck}" ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="{Binding DashboardGitConflictSchedule}" AutomationProperties.Name="Queue Git-only conflict test"/>
                                            <MenuItem Header="Details…" Style="{StaticResource ServiceToolMenuItem}" Click="DashboardGitConflictDetails_Click"
                                                      IsEnabled="{Binding HasDashboardGitConflictResult}" ToolTip="Exact compared commits, conflict paths, and Git diagnostics"/>
                                            <Separator Style="{StaticResource ServiceToolMenuSeparator}"/>
                                            <MenuItem Header="Manual only · committed history" Style="{StaticResource ServiceToolMenuItem}" IsEnabled="False"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding DashboardGitComparisonLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Changed files" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitChangedFiles}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" ToolTip="{Binding DashboardGitLineTotalsTooltip}"><TextBlock Text="Lines added" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitAddedLines}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0" ToolTip="{Binding DashboardGitLineTotalsTooltip}"><TextBlock Text="Lines removed" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitRemovedLines}" Foreground="#FFACA9" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DashboardGitComparisonDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       ToolTip="Untracked and binary contents are excluded from line totals. Ahead/behind counts appear when nonzero."/>
                            <TextBlock Text="{Binding DashboardGitConflictStatus}" Foreground="{Binding DashboardGitConflictStatusColor}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasDashboardGitConflictStatus, Converter={StaticResource BoolToVisibility}}"
                                       ToolTip="{Binding DashboardGitConflictSchedule}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding NextCommitStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasNextCommitStatusNotice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding NextCommitDraftHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasNextCommitDraftHint, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="Commit message" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NextCommitLimitStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                   AutomationProperties.Name="{Binding NextCommitLimitStatus}" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers>
                                <DataTrigger Binding="{Binding NextCommitOverLimit}" Value="True"><Setter Property="Foreground" Value="#FFACA9"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <controls:CommitMessagePreview Grid.Row="2" Presentation="{Binding NextCommitPresentation}" ReadRequested="NextCommitMessage_ReadRequested"
                                                   MinHeight="80" AutomationProperties.Name="Next commit message"
                                                   ToolTip="Unread text is mint and underlined. Click the message or press Enter to mark displayed updates read."/>
                </Grid>
                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="Open _Git…" Click="GitWorkspace_Click" Padding="9,6" FontSize="11" Margin="0,0,6,4">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="_Copy message" Click="CopyNextCommit_Click" IsEnabled="{Binding HasNextCommitMessage}" Padding="9,6" FontSize="11" Margin="0,0,6,4"/>
                    <Button Content="Refresh" Click="RefreshNextCommit_Click" Padding="9,6" FontSize="11" Margin="0,0,0,4"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
