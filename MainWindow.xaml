<Window x:Class="FullStackLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FullStackLauncher"
        xmlns:controls="clr-namespace:FullStackLauncher.Controls"
        Title="Full Stack Launcher" Icon="pack://application:,,,/Assets/launcher.ico" Width="1440" Height="980" MinWidth="1060" MinHeight="740"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="ProjectEditWindow_KeyDown">
    <Window.Resources>
        <DataTemplate x:Key="ProjectBranchTemplate">
            <Grid Margin="0,3,0,0" AutomationProperties.Name="{Binding DisplayText}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.ToolTip><ToolTip MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ToolTip></Grid.ToolTip>
                <TextBlock Text="GIT" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="ProjectEditField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#142D2B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="#202B3A"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="Indicator" Text="+" Width="16"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Frame" Property="Background" Value="#203C3B"/><Setter TargetName="Frame" Property="BorderBrush" Value="#397767"/><Setter TargetName="Indicator" Property="Text" Value="✓"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="LongRunningTaskCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame" Width="18" Height="18" VerticalAlignment="Center" Background="#111923" BorderBrush="#8295AF" BorderThickness="1" CornerRadius="3">
                                <Path x:Name="CheckMark" Data="M 3,8 L 6,11 L 13,4" Stroke="#0C2925" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBoxFrame" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#243444"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HideSectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="− Hide"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="ToolTip" Value="Hide this section. Reopen it from the Sections bar."/>
        </Style>
        <Style x:Key="ServiceCardExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Cursor="Hand" ToolTip="Expand or collapse service details" AutomationProperties.Name="{Binding Name, StringFormat=Expand or collapse {0}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="HeaderFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="2,3">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Chevron" Text="›" Foreground="{StaticResource AccentBrush}" FontSize="20" VerticalAlignment="Center"/>
                                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="#243444"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Details" Grid.Row="1" ContentSource="Content" TextElement.Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceToolMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#293F50"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="SidebarPanel" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ProjectsRow" Height="*"/><RowDefinition x:Name="ToolsRow" Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="FULL STACK" FontWeight="Bold" FontSize="21"/>
                    <TextBlock Text="Launcher" Foreground="{StaticResource MutedBrush}" FontSize="19"/>
                    <TextBlock Text="Your local development desk." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24" FontSize="11"/>
                </StackPanel>
                <Grid x:Name="ProjectsPanel" Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                    <Grid>
                        <TextBlock Text="PROJECTS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Add" Padding="7,4" FontSize="10" Click="AddProject_Click" IsEnabled="{Binding CanChangeProject}" ToolTip="Save or cancel edits before adding another project" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource HideSectionButton}" Tag="Projects" Click="HideSection_Click" AutomationProperties.Name="Hide projects"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="+ Console project" Click="AddConsoleProject_Click" IsEnabled="{Binding CanChangeProject}" Padding="8,6" FontSize="11" Margin="0,10,0,6" HorizontalContentAlignment="Left" ToolTip="Add a console app or an executable with command line arguments"/>
                    <ToggleButton Content="{Binding ArchivedProjectsLabel}" Style="{StaticResource SectionToggle}" IsChecked="{Binding ShowArchivedProjects, Mode=OneWay}" Click="ArchiveView_Click" IsEnabled="{Binding CanChangeProject}" Margin="0,0,0,0" AutomationProperties.Name="Show archived projects"/>
                    <TextBlock Text="{Binding ProjectListHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                <ListBox x:Name="ProjectList" Grid.Row="1" ItemsSource="{Binding VisibleProjectItems}" SelectedValuePath="Profile" SelectionChanged="ProjectList_SelectionChanged" IsEnabled="{Binding CanChangeProject}" ToolTip="Save or cancel edits before switching projects" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Saved projects">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Branches}" ItemTemplate="{StaticResource ProjectBranchTemplate}" Margin="0,3,0,0" IsTabStop="False"/>
                            <ItemsControl ItemsSource="{Binding Services}" Margin="0,6,0,0" IsTabStop="False">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,4,0,0" ToolTip="{Binding Detail}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding StateColor}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StateColor}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No services configured" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Services.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <Button Content="{Binding ArchiveProjectLabel}" Click="ArchiveProject_Click" IsEnabled="{Binding CanArchiveProject}" Padding="8,7" FontSize="11" ToolTip="Move this project between Active and Archived while preserving its settings, notes and running apps"/>
                        <Button Content="Remove selected project" Click="RemoveProject_Click" IsEnabled="{Binding CanRemoveProject}" Padding="8,5" FontSize="10" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ToolsPanel" Grid.Row="2" Margin="0,14,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="DEVELOPER TOOLS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource HideSectionButton}" Tag="Tools" Click="HideSection_Click" AutomationProperties.Name="Hide developer tools" HorizontalAlignment="Right"/>
                    </Grid>
                    <ScrollViewer x:Name="ToolsScroller" Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DeveloperTools}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="OpenDeveloperTool_Click" IsEnabled="{Binding CanOpen}" ToolTip="{Binding Detail}" ToolTipService.ShowOnDisabled="True" Padding="11,10" Margin="0,0,0,8" Background="#223549" BorderBrush="#3A516C" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                    <Grid Width="166"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Normal" Margin="0,4,0,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Normal" Margin="0,3,0,0"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="↗" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Manage tools…" Click="ManageTools_Click" Padding="8,5" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                </Grid>
                <StackPanel Grid.Row="3">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,14"/>
                    <TextBlock Text="MADE TO MOVE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Your layout and projects travel with your settings." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="22,24,22,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WORKSPACE / LOCAL PROCESSES" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                    <Button Click="ProjectTitle_Click" IsEnabled="{Binding CanEdit}" ToolTip="Click to rename this project" AutomationProperties.Name="Edit project title" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Margin="0,6,12,4">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="{Binding SelectedProject.Name, TargetNullValue=Choose a project}" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="0,6,12,4">
                        <TextBlock Text="PROJECT NAME" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox x:Name="ProjectNameEditor" Text="{Binding DraftProjectName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectEditField}" FontSize="23" FontWeight="SemiBold" IsEnabled="{Binding CanSaveProjectEdits}" KeyDown="ProjectEditField_KeyDown" AutomationProperties.Name="Project name"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RootPath}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding RootPath}"/>
                    <ItemsControl ItemsSource="{Binding SelectedProjectItem.Branches}" ItemTemplate="{StaticResource ProjectBranchTemplate}" Margin="0,5,12,0" IsTabStop="False"/>
                    <Border Background="#3D202A" BorderBrush="#E96B78" BorderThickness="2" CornerRadius="7" Padding="10,8" Margin="0,10,12,0"
                            Visibility="{Binding HasProductionNotice, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="PRODUCTION CONFIGURATION" Foreground="#FFACA9" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding ProductionNotice}" Foreground="#FFE3E5" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Alerts ▾" Click="CodexAlertsMenu_Click" ToolTip="Codex alerts and always-on-top chat progress" Margin="0,0,8,0">
                        <Button.ContextMenu><ContextMenu>
                            <MenuItem Header="Open Codex alerts" Click="CodexAlerts_Click"/>
                            <Separator/>
                            <MenuItem Header="Show chat progress" Click="CodexOverlayShow_Click"/>
                            <MenuItem Header="Hide chat progress" Click="CodexOverlayHide_Click"/>
                            <MenuItem Header="Clear finished chats" Click="CodexOverlayClear_Click"/>
                        </ContextMenu></Button.ContextMenu>
                    </Button>
                    <ToggleButton x:Name="EditModeToggle" IsChecked="{Binding IsEditing, Mode=OneWay}" Click="EditProject_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0" AutomationProperties.Name="Edit project" ToolTip="Toggle editing; click again to save changes">
                        <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource SectionToggle}">
                            <Setter Property="Content" Value="Edit"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,10"/>
                            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="Editing"/></Trigger></Style.Triggers>
                        </Style></ToggleButton.Style>
                    </ToggleButton>
                    <Button Content="↻" FontSize="19" Padding="11,5" Click="Refresh_Click" ToolTip="Refresh Git branches, process and URL status" AutomationProperties.Name="Refresh status"/>
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="1" Margin="0,18,0,7" VerticalAlignment="Center">
                <TextBlock Text="SECTIONS" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,5"/>
                <ToggleButton x:Name="ProjectsToggle" Content="Projects" Style="{StaticResource SectionToggle}" IsChecked="{Binding ProjectsVisible, Mode=TwoWay}" AutomationProperties.Name="Show projects" ToolTip="Show or hide the saved projects section"/>
                <ToggleButton x:Name="ToolsToggle" Content="Tools" Style="{StaticResource SectionToggle}" IsChecked="{Binding ToolsVisible, Mode=TwoWay}" AutomationProperties.Name="Show developer tools" ToolTip="Show or hide developer tools"/>
                <ToggleButton x:Name="ServicesToggle" Content="Services" Style="{StaticResource SectionToggle}" IsChecked="{Binding ServicesVisible, Mode=TwoWay}" AutomationProperties.Name="Show services" ToolTip="Show or hide services and batch controls"/>
                <ToggleButton x:Name="ConsoleToggle" Content="Console" Style="{StaticResource SectionToggle}" IsChecked="{Binding ConsoleVisible, Mode=TwoWay}" AutomationProperties.Name="Show console" ToolTip="Show or hide live console output"/>
                <ToggleButton x:Name="DatabaseToggle" Content="Database" Style="{StaticResource SectionToggle}" IsChecked="{Binding DatabaseVisible, Mode=TwoWay}" AutomationProperties.Name="Show database" ToolTip="Show or hide the database explorer"/>
                <Button Content="Git…" Click="GitWorkspace_Click" Padding="10,7" FontSize="11" Margin="0,0,6,5" ToolTip="Open repository setup, remotes, branches and the working tree">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="Notes &amp; queue ↗" Click="ProjectTasks_Click" Padding="10,7" FontSize="11" Margin="0,0,6,5" ToolTip="Open notes and the prepared task queue for the selected project"/>
                <Button Content="Reset layout" Click="ResetLayout_Click" Background="Transparent" Foreground="{StaticResource MutedBrush}" Padding="9,7" FontSize="11" Margin="2,0,0,5" ToolTip="Show every section and restore the default panel sizes"/>
                <CheckBox Content="Long Running Task" IsChecked="{Binding LongRunningTaskEnabled, Mode=OneWay}" Click="LongRunningTask_Click"
                          Style="{StaticResource LongRunningTaskCheckBox}" Margin="12,0,6,5"
                          ToolTipService.ShowDuration="30000"
                          AutomationProperties.Name="Long Running Task" AutomationProperties.HelpText="{Binding LongRunningTaskDescription}">
                    <CheckBox.ToolTip><ToolTip MaxWidth="440"><TextBlock Text="{Binding LongRunningTaskDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/></ToolTip></CheckBox.ToolTip>
                </CheckBox>
            </WrapPanel>
            <Border x:Name="BatchControlsPanel" Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="14,10" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Live process and endpoint status" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="▶  Start all" Style="{StaticResource PrimaryButton}" Click="StartAll_Click" IsEnabled="{Binding CanBatch}" Margin="0,0,8,0"/>
                        <Button Content="Restart all" Click="RestartAll_Click" IsEnabled="{Binding CanBatch}" Margin="0,0,8,0"/>
                        <Button Content="■  Force stop all" Style="{StaticResource DangerButton}" Click="StopAll_Click" IsEnabled="{Binding CanStopBatch}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <TextBlock Text="EDIT MODE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,5"/>
                        <Button Content="{Binding EditSaveLabel}" Click="SaveProjectEdits_Click" IsEnabled="{Binding CanSaveProjectEdits}" Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="0,0,8,5"/>
                        <Button Content="Cancel" Click="CancelProjectEdits_Click" IsEnabled="{Binding CanCancelProjectEdits}" Padding="10,6" Margin="0,0,8,5"/>
                        <Button Content="Save &amp; more options…" Click="ProjectDetails_Click" IsEnabled="{Binding CanEditDetails}" ToolTip="Save these edits, then manage paths, commands and services. Stop all project services first." ToolTipService.ShowOnDisabled="True" Padding="10,6" Margin="0,0,0,5"/>
                    </WrapPanel>
                    <TextBlock Text="Highlighted fields are editable. Stop a service to unlock its port. Enter saves · Esc cancels." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasEditError, Converter={StaticResource BoolToVisibility}}" Margin="0,7,0,0">
                        <TextBlock Text="{Binding EditError}" Foreground="#FFACA9" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ServiceConsoleRow" Height="0.35*" MinHeight="140"/>
                    <RowDefinition x:Name="WorkspaceDividerRow" Height="10"/>
                    <RowDefinition x:Name="DatabaseRow" Height="0.65*" MinHeight="270"/>
                </Grid.RowDefinitions>
                <Grid x:Name="ServiceConsoleGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ServicesColumn" Width="0.53*" MinWidth="320"/>
                        <ColumnDefinition x:Name="ConsoleDividerColumn" Width="10"/>
                        <ColumnDefinition x:Name="ConsoleColumn" Width="0.47*" MinWidth="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ServicesPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="SERVICES" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource HideSectionButton}" Tag="Services" Click="HideSection_Click" HorizontalAlignment="Right" AutomationProperties.Name="Hide services"/>
                        </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                    <Border Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="SERVICE NAME" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectEditField}" IsEnabled="{Binding DataContext.CanSaveProjectEdits, RelativeSource={RelativeSource AncestorType=Window}}" KeyDown="ProjectEditField_KeyDown" AutomationProperties.Name="Service name"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Width="90" Visibility="{Binding HasWebEndpoint, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="DESIRED PORT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding DraftPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectEditField}" IsEnabled="{Binding CanEditPort}" KeyDown="ProjectEditField_KeyDown" MaxLength="5" AutomationProperties.Name="Desired port" ToolTip="{Binding PortEditHint}" ToolTipService.ShowOnDisabled="True"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding PortEditHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasWebEndpoint, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Stop service to edit port" Click="StopService_Click" IsEnabled="{Binding CanStop}" Style="{StaticResource DangerButton}" Padding="8,5" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding CanStopForPortEdit, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                    <Expander Style="{StaticResource ServiceCardExpander}" AutomationProperties.Name="{Binding Name}">
                                        <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding DesiredPortLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding ConfigurationStatus}" Foreground="{Binding ConfigurationColor}" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasApiConfiguration, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StateColor}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                        </Expander.Header>
                                    <StackPanel>
                                        <Border Background="{Binding ConfigurationBackground}" BorderBrush="{Binding ConfigurationBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,2"
                                                Visibility="{Binding HasApiConfiguration, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="API CONFIGURATION" Foreground="{Binding ConfigurationColor}" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding ConfigurationStatus}" Foreground="{Binding ConfigurationColor}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5,0,7"/>
                                                <WrapPanel>
                                                    <Button Content="{Binding LocalButtonLabel}" Tag="Local" Click="UseApiConfiguration_Click" IsEnabled="{Binding CanSwitchConfiguration}" Padding="8,6" FontSize="11" Margin="0,0,6,6"/>
                                                    <Button Content="{Binding ProdButtonLabel}" Tag="Prod" Click="UseApiConfiguration_Click" IsEnabled="{Binding CanSwitchConfiguration}" Style="{StaticResource DangerButton}" Padding="8,6" FontSize="11" Margin="0,0,0,6"/>
                                                </WrapPanel>
                                                <Button Content="Manage secrets &amp; settings…" Click="ApiSecrets_Click" IsEnabled="{Binding CanConfigureApi}" Padding="8,6" FontSize="11" HorizontalAlignment="Left"/>
                                                <TextBlock Text="Runs the API here with Local (Development) or Prod (Production) settings. Switching starts or restarts this API." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#121A25" CornerRadius="5" Padding="8,6" Margin="0,8,0,4"><TextBlock Text="{Binding Command}" FontFamily="Cascadia Code, Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/></Border>
                                        <Button Content="{Binding Url}" Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0" Padding="0,3" HorizontalAlignment="Left" IsEnabled="{Binding CanOpen}" Click="OpenUrl_Click" ToolTip="Open this service's live UI in your browser" FontSize="11" Visibility="{Binding HasWebEndpoint, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,2,0,7"/>
                                        <Button Content="Resolve conflict &amp; restart" Click="ResolveConflict_Click" IsEnabled="{Binding CanResolveConflict}"
                                                Margin="0,0,0,8" Padding="8,7" FontSize="11"
                                                ToolTip="Review and stop the processes blocking this service's port, then restart the service.">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <UniformGrid Columns="{Binding ActionColumnCount}">
                                            <Button Content="{Binding StartButtonLabel}" Style="{StaticResource PrimaryButton}" Click="StartService_Click" IsEnabled="{Binding CanStart}" Margin="0,0,5,0" Padding="4,6" FontSize="11"/>
                                            <Button Content="Restart" Click="RestartService_Click" IsEnabled="{Binding CanRestart}" Margin="0,0,5,0" Padding="4,6" FontSize="11"/>
                                            <Button Content="Clean" Click="CleanService_Click" IsEnabled="{Binding CanClean}" Margin="0,0,5,0" Padding="4,6" FontSize="11" ToolTip="{Binding Profile.CleanCommand}" Visibility="{Binding ShowClean, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Setup" Click="SetupService_Click" IsEnabled="{Binding CanSetup}" Margin="0,0,5,0" Padding="4,6" FontSize="11" ToolTip="{Binding Profile.SetupCommand}" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Stop" Click="StopService_Click" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanStop}" Padding="4,6" FontSize="11" ToolTip="Force stop this service and its child processes"/>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding ProcessLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    </Expander>
                                    <WrapPanel Margin="0,10,0,0">
                                        <ToggleButton Content="Console output" Style="{StaticResource SectionToggle}"
                                                      IsChecked="{Binding IsConsoleVisible, Mode=TwoWay}" Margin="0,0,8,0"
                                                      AutomationProperties.Name="{Binding Name, StringFormat=Show console for {0}}"/>
                                        <Button Content="Open in… ▾" Click="OpenServiceTool_Click" Padding="10,7" FontSize="11"
                                                Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                                ToolTip="{Binding Directory, StringFormat=Open this service folder in an installed editor or application: {0}}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Open {0} in an editor}"/>
                                    </WrapPanel>
                                    <controls:ConsoleOutput ItemsSource="{Binding ConsoleLines}" ShowSource="False" Height="250" Margin="0,8,0,0"
                                                            Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}}"
                                                            ClearRequested="ClearServiceConsole" AutomationProperties.Name="{Binding Name, StringFormat=Console for {0}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                    <GridSplitter x:Name="ConsoleDivider" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{StaticResource BorderBrush}" ShowsPreview="True" DragCompleted="LayoutDivider_DragCompleted" LostKeyboardFocus="LayoutDivider_LostKeyboardFocus" ToolTip="Drag or use arrow keys to resize the console" AutomationProperties.Name="Resize console width"/>
                    <Border x:Name="ConsolePanel" Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Grid x:Name="ConsoleContent" Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="COMBINED CONSOLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource HideSectionButton}" Tag="Console" Click="HideSection_Click" AutomationProperties.Name="Hide console output"/>
                                    </StackPanel>
                                </Grid>
                                <controls:ConsoleOutput Grid.Row="1" ItemsSource="{Binding ConsoleLines}" ClearRequested="ClearProjectConsole" AutomationProperties.Name="Combined service output"/>
                                <TextBlock Grid.Row="2" Text="Latest 1,000 entries · each service also has its own console" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <GridSplitter x:Name="WorkspaceDivider" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{StaticResource BorderBrush}" ShowsPreview="True" DragCompleted="LayoutDivider_DragCompleted" LostKeyboardFocus="LayoutDivider_LostKeyboardFocus" ToolTip="Drag or use arrow keys to resize the database section" AutomationProperties.Name="Resize database height"/>
                <Grid x:Name="DatabaseSection" Grid.Row="2">
                    <local:DatabaseBrowser x:Name="DatabasePanel"/>
                </Grid>
                <StackPanel x:Name="EmptyWorkspace" Grid.RowSpan="3" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Room to focus" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Reopen a section above whenever you need it." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16"/>
                    <Button Content="Show all sections" Click="ResetLayout_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="4" Margin="0,14,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"/><TextBlock Grid.Column="1" Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="15,0,0,0"/></Grid>
        </Grid>
    </Grid>
</Window>
