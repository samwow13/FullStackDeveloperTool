                                                AutomationProperties.Name="{Binding Name, StringFormat=Expand console output for {0}}"/>
                                        <Button Content="Copy Errors" Click="CopyServiceErrors_Click" Style="{StaticResource DangerButton}" Padding="10,7" FontSize="12" Margin="0,0,8,6"
                                                Visibility="{Binding HasOutputError, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Copy retained errors and up to 10 console entries before each error. Overlapping context is copied once."
                                                AutomationProperties.Name="{Binding Name, StringFormat=Copy errors for {0}}"/>
                                        <Button Content="Open in… ▾" Click="OpenServiceTool_Click" Style="{StaticResource ServiceCardAction}"
                                                ToolTip="{Binding Directory, StringFormat=Open this service folder in File Explorer or an installed application: {0}}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Open {0} folder in another application}"/>
                                        <Button Content="API endpoints…" Click="ApiEndpoints_Click" Style="{StaticResource ServiceCardAction}"
                                                Visibility="{Binding ShowApiDatabaseLabel, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Count API endpoint operations by HTTP verb from source, or a local OpenAPI JSON file. View routes, controller actions and discovery limitations."
                                                AutomationProperties.Name="{Binding Name, StringFormat=Count API endpoints for {0}}"/>
                                        <Button Content="{Binding SourceLines.ButtonLabel}" Click="CountServiceLines_Click" Style="{StaticResource ServiceCardAction}"
                                                IsEnabled="{Binding SourceLines.CanCount}" ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="30000"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Count source code lines for {0}}">
                                            <Button.ToolTip><ToolTip><TextBlock Text="{Binding SourceLines.Details}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></Button.ToolTip>
                                        </Button>
                                        <CheckBox Content="Open after build" IsChecked="{Binding OpenAfterBuild, Mode=OneWay}" Click="OpenAfterBuild_Click"
                                                  IsEnabled="{Binding CanChangeOpenAfterBuild}" Visibility="{Binding IsFrontendService, Converter={StaticResource BoolToVisibility}}"
                                                  Style="{StaticResource LongRunningTaskCheckBox}" Margin="0,0,8,6" FontSize="12"
                                                  ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="30000"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Open {0} after build}"
                                                  AutomationProperties.HelpText="{Binding OpenAfterBuildDetails}">
                                            <CheckBox.ToolTip><ToolTip><TextBlock Text="{Binding OpenAfterBuildDetails}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></CheckBox.ToolTip>
                                        </CheckBox>
                                    </WrapPanel>
                                    </Border>
                                    <controls:ConsoleOutput ItemsSource="{Binding ConsoleLines}" ShowSource="False" Height="250" Margin="0,8,0,0"
                                                            Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}}"
                                                            ClearRequested="ClearServiceConsole" AutomationProperties.Name="{Binding Name, StringFormat=Console for {0}}"/>
                                     </StackPanel>
                                     </Expander>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8"
                                        Visibility="{Binding HasVerifiedDatabaseCard, Converter={StaticResource BoolToVisibility}}">
                                    <Expander Style="{StaticResource ServiceCardExpander}" Expanded="DatabaseCard_Expanded" AutomationProperties.Name="{Binding DatabaseCardName}"
                                              AutomationProperties.HelpText="{Binding DatabaseComparisonHeader}">
                                        <Expander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Database" FontSize="17" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding LastVerifiedDatabaseName}" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding Name, StringFormat=Discovered through {0}}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <Border Style="{StaticResource ServiceMetadata}" HorizontalAlignment="Left" ToolTip="{Binding DatabaseCardDetails}">
                                                        <TextBlock Text="{Binding DatabaseCardStatus}" Foreground="{Binding DatabaseCardStatusColor}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DatabaseComparisonHeader}" Foreground="{StaticResource AccentBrush}"
                                                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"
                                                               Visibility="{Binding HasSavedDatabaseComparisonSet, Converter={StaticResource BoolToVisibility}}"
                                                               AutomationProperties.LiveSetting="Polite"/>
                                                    <TextBlock Text="{Binding DatabaseComparisonCheckedAt}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="12" Margin="0,4,0,0"
                                                               Visibility="{Binding HasDatabaseComparisonCheck, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="29,8,0,0">
                                            <TextBlock Text="{Binding DatabaseCardDetails}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                                            <Button Content="Open database explorer…" Click="OpenDatabaseExplorer_Click" HorizontalAlignment="Left"
                                                    Margin="0,10,0,0" Padding="12,8"
                                                    ToolTip="Browse tables, rows, accounts, connections, and database comparison or migration tools"
                                                    AutomationProperties.Name="{Binding LastVerifiedDatabaseName, StringFormat=Open database explorer for {0}}"/>
                                            <local:DatabaseComparisonPanel Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                <StackPanel x:Name="EmptyWorkspace" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Room to focus" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Reopen a section above whenever you need it." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16"/>
                    <Button Content="Show services" Click="ShowServices_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="4" Margin="0,14,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"/><TextBlock Grid.Column="1" Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="15,0,0,0"/></Grid>
        </Grid>
        <GridSplitter x:Name="NextCommitSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,24,0,16"
                      Background="{StaticResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      Visibility="Collapsed" Focusable="True" AutomationProperties.Name="Resize next commit panel"/>
        <Border x:Name="NextCommitPanel" Grid.Column="3" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,24,22,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Next commit" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <ToggleButton x:Name="NextCommitSettingsToggle" Style="{StaticResource NextCommitSettingsButton}"
                                      PreviewKeyDown="NextCommitSettingsToggle_PreviewKeyDown" ToolTip="Next commit settings"
                                      AutomationProperties.Name="Next commit settings" AutomationProperties.HelpText="Choose repository and PR sound reminder. Click outside or press Escape to close."/>
                        <Popup x:Name="NextCommitSettingsMenu" PlacementTarget="{Binding ElementName=NextCommitSettingsToggle}" Placement="Bottom" VerticalOffset="6"
                               IsOpen="{Binding IsChecked, ElementName=NextCommitSettingsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="NextCommitSettingsMenu_Opened">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Width="320"
                                    PreviewKeyDown="NextCommitSettingsMenu_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle">
                                <StackPanel>
                                    <TextBlock Text="Next commit settings" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Label Content="_Repository" Target="{Binding ElementName=NextCommitRepositoryPicker}" Padding="0,0,0,5" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    <ComboBox x:Name="NextCommitRepositoryPicker" ItemsSource="{Binding NextCommitRepositories}" SelectedItem="{Binding SelectedNextCommitRepository, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedNextCommitRepository.RepositoryRoot}" AutomationProperties.Name="Next commit repository"/>
                                    <TextBlock Text="{Binding NextCommitStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                                    <TextBlock Text="{Binding NextCommitCharacterCount}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <CheckBox Content="_PR sound reminder" Style="{StaticResource LongRunningTaskCheckBox}"
                                              IsChecked="{Binding NextCommitPrReminderEnabled, Mode=TwoWay}" Margin="0,8,0,0"
                                              AutomationProperties.Name="Enable PR sound reminder for commit message length"
                                              ToolTip="Off by default for each launcher session. First sound after 5 minutes, then every 5 minutes while this panel is visible and the selected commit message exceeds 3,000 characters."/>
                                    <TextBlock Text="Sound every 5 minutes above 3,000 message characters to remind you to make a PR. Counts message text, not code diff size."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Grid.Column="2" Style="{StaticResource HideSectionButton}" Tag="NextCommit" Click="HideSection_Click" HorizontalAlignment="Right" AutomationProperties.Name="Hide next commit"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Git comparison" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DashboardGitComparisonLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Changed files" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitChangedFiles}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" ToolTip="Tracked text compared with the last fetched remote branch. Includes local commits and edits; untracked and binary contents excluded."><TextBlock Text="Lines added" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitAddedLines}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0" ToolTip="Tracked text compared with the last fetched remote branch. Includes local commits and edits; untracked and binary contents excluded."><TextBlock Text="Lines removed" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitRemovedLines}" Foreground="#FFACA9" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DashboardGitComparisonDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,10"/>
                            <WrapPanel>
                                <Button Content="Git-only conflict test" Click="DashboardGitConflictCheck_Click" IsEnabled="{Binding CanRequestDashboardGitCheck}" Padding="9,6" FontSize="11" Margin="0,0,6,4"
                                        ToolTip="Check committed history against the saved remote release branch. Waits until all local Codex agents finish. Uncommitted edits are excluded." AutomationProperties.Name="Queue Git-only conflict test"/>
                                <Button Content="Details…" Click="DashboardGitConflictDetails_Click" IsEnabled="{Binding HasDashboardGitConflictResult}" Padding="9,6" FontSize="11" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding DashboardGitConflictStatus}" Foreground="{Binding DashboardGitConflictStatusColor}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="{Binding DashboardGitConflictSchedule}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding NextCommitStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasNextCommitStatusNotice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding NextCommitDraftHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasNextCommitDraftHint, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="Commit message" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NextCommitLimitStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                   AutomationProperties.Name="{Binding NextCommitLimitStatus}" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers>
                                <DataTrigger Binding="{Binding NextCommitOverLimit}" Value="True"><Setter Property="Foreground" Value="#FFACA9"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <controls:CommitMessagePreview Grid.Row="2" Presentation="{Binding NextCommitPresentation}" ReadRequested="NextCommitMessage_ReadRequested"
                                                   MinHeight="80" AutomationProperties.Name="Next commit message"
                                                   ToolTip="Unread text is mint and underlined. Click the message or press Enter to mark displayed updates read."/>
                </Grid>
                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="Open _Git…" Click="GitWorkspace_Click" Padding="9,6" FontSize="11" Margin="0,0,6,4">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="_Copy message" Click="CopyNextCommit_Click" IsEnabled="{Binding HasNextCommitMessage}" Padding="9,6" FontSize="11" Margin="0,0,6,4"/>
                    <Button Content="Refresh" Click="RefreshNextCommit_Click" Padding="9,6" FontSize="11" Margin="0,0,0,4"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
