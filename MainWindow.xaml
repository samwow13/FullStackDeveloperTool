<Window x:Class="FullStackLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FullStackLauncher"
        xmlns:controls="clr-namespace:FullStackLauncher.Controls"
        Title="Full Stack Launcher" Icon="pack://application:,,,/Assets/launcher.ico" Width="1440" Height="980" MinWidth="1060" MinHeight="740"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="ProjectEditWindow_KeyDown">
    <Window.Resources>
        <DataTemplate x:Key="ProjectBranchTemplate">
            <Grid Margin="0,3,0,0" AutomationProperties.Name="{Binding DisplayText}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.ToolTip><ToolTip MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ToolTip></Grid.ToolTip>
                <TextBlock Text="GIT" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="ProjectEditField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#142D2B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="#202B3A"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="Indicator" Text="+" Width="16"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Frame" Property="Background" Value="#203C3B"/><Setter TargetName="Frame" Property="BorderBrush" Value="#397767"/><Setter TargetName="Indicator" Property="Text" Value="✓"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionsDropdownToggle" TargetType="ToggleButton" BasedOn="{StaticResource SectionToggle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#27364A"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Text="▾" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Frame" Property="Background" Value="#203C3B"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#397767"/>
                            <!-- Let an outside click on this button close the popup without reopening it. -->
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionMenuSwitch" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateText" Grid.Column="1" Text="Off" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="12,0,8,0" VerticalAlignment="Center"/>
                            <Border x:Name="SwitchFrame" Grid.Column="2" Width="34" Height="20" CornerRadius="10" Background="#111923" BorderBrush="#8295AF" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb" Width="12" Height="12" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="StateText" Property="Text" Value="On"/>
                            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="SwitchFrame" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="SwitchFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#0C2925"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#243444"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="NextCommitSettingsButton" TargetType="ToggleButton" BasedOn="{StaticResource SectionToggle}">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Frame" Property="Background" Value="#203C3B"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#397767"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="LongRunningTaskCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame" Width="18" Height="18" VerticalAlignment="Center" Background="#111923" BorderBrush="#8295AF" BorderThickness="1" CornerRadius="3">
                                <Path x:Name="CheckMark" Data="M 3,8 L 6,11 L 13,4" Stroke="#0C2925" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBoxFrame" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#243444"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HideSectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="− Hide"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="ToolTip" Value="Hide this section. Reopen it from the Sections dropdown."/>
        </Style>
        <Style x:Key="ProjectDisclosureToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="Chevron" Text="›" Foreground="{StaticResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/><Setter TargetName="Chevron" Property="Margin" Value="0,-7,0,0"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#314859"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceCardExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" Cursor="Hand" ToolTip="Expand or collapse details" AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}, StringFormat=Expand or collapse {0}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="HeaderFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="4,6">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Chevron" Text="›" Foreground="{StaticResource AccentBrush}" FontSize="22" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="#243444"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Grid.Row="1" Content="{TemplateBinding Tag}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <ContentPresenter x:Name="Details" Grid.Row="2" ContentSource="Content" TextElement.Foreground="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceCardAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ServiceMetadata" TargetType="Border">
            <Setter Property="Background" Value="#141D29"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,6,8,0"/>
        </Style>
        <Style x:Key="ServiceToolMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#293F50"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceToolMenuSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource BorderBrush}"/>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceToolContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Background="Transparent" BorderThickness="0" MaxHeight="520"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="245"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition x:Name="NextCommitSplitterColumn" Width="0"/><ColumnDefinition x:Name="NextCommitColumn" Width="0"/></Grid.ColumnDefinitions>
        <Border x:Name="SidebarPanel" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,24,16,18">
                <Grid.RowDefinitions><RowDefinition x:Name="ProjectsRow" Height="*"/><RowDefinition x:Name="ToolsRow" Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ProjectsPanel" Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                    <Grid>
                        <TextBlock Text="PROJECTS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ New project" Padding="7,4" FontSize="10" Click="AddProject_Click" IsEnabled="{Binding CanChangeProject}" ToolTip="Save or cancel edits before adding another project" Margin="0,0,5,0"/>
                            <Button Style="{StaticResource HideSectionButton}" Tag="Projects" Click="HideSection_Click" AutomationProperties.Name="Hide projects"/>
                        </StackPanel>
                    </Grid>
                    <ToggleButton Content="{Binding ArchivedProjectsLabel}" Style="{StaticResource SectionToggle}" IsChecked="{Binding ShowArchivedProjects, Mode=OneWay}" Click="ArchiveView_Click" IsEnabled="{Binding CanChangeProject}" Margin="0,10,0,0" AutomationProperties.Name="Show archived projects"/>
                    <TextBlock Text="{Binding ProjectListHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                <ListBox x:Name="ProjectList" Grid.Row="1" ItemsSource="{Binding VisibleProjectItems}" SelectedValuePath="Profile" SelectionChanged="ProjectList_SelectionChanged" IsEnabled="{Binding CanChangeProject}" ToolTip="Save or cancel edits before switching projects" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Saved projects">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Margin" Value="0,0,0,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ToggleButton Style="{StaticResource ProjectDisclosureToggle}" IsChecked="{Binding IsDetailsExpanded, Mode=TwoWay}"
                                              ToolTip="Show or hide this project's branches and service statuses"
                                              AutomationProperties.Name="{Binding Name, StringFormat=Expand or collapse {0} details}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Services}" Margin="5,0,0,0" VerticalAlignment="Center" IsTabStop="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="#69E2C0" Margin="3,0,0,0" ToolTip="{Binding Name, StringFormat={}{0} running}"
                                                 Visibility="{Binding ShowRunningDot, Converter={StaticResource BoolToVisibility}}"
                                                 AutomationProperties.Name="{Binding Name, StringFormat={}{0} running}"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="21,2,0,4" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Branches}" ItemTemplate="{StaticResource ProjectBranchTemplate}" IsTabStop="False"/>
                            <ItemsControl ItemsSource="{Binding Services}" Margin="0,5,0,0" IsTabStop="False">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,4,0,0" ToolTip="{Binding Detail}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{Binding StateColor}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StateColor}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No services configured" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Services.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,8,0,8">
                        <Button Content="{Binding ArchiveProjectLabel}" Click="ArchiveProject_Click" IsEnabled="{Binding CanArchiveProject}" Padding="8,7" FontSize="11" ToolTip="Move this project between Active and Archived while preserving its settings, notes and running apps"/>
                        <Button Content="Remove selected project" Click="RemoveProject_Click" IsEnabled="{Binding CanRemoveProject}" Padding="8,5" FontSize="10" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ToolsPanel" Grid.Row="1" Margin="0,14,0,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="DEVELOPER TOOLS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource HideSectionButton}" Tag="Tools" Click="HideSection_Click" AutomationProperties.Name="Hide developer tools" HorizontalAlignment="Right"/>
                    </Grid>
                    <ScrollViewer x:Name="ToolsScroller" Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DeveloperTools}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="OpenDeveloperTool_Click" IsEnabled="{Binding CanOpen}" ToolTip="{Binding Detail}" ToolTipService.ShowOnDisabled="True" Padding="11,10" Margin="0,0,0,8" Background="#223549" BorderBrush="#3A516C" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                    <Grid Width="166"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Normal" Margin="0,4,0,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Normal" Margin="0,3,0,0"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="↗" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Manage tools…" Click="ManageTools_Click" Padding="8,5" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left"/>
                </Grid>
                <StackPanel Grid.Row="2">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,14"/>
                    <TextBlock Text="MADE TO MOVE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Your layout and projects travel with your settings." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="22,24,22,16">
