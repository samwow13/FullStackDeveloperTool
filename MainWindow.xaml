<Window x:Class="FullStackLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FullStackLauncher"
        xmlns:controls="clr-namespace:FullStackLauncher.Controls"
        Title="Full Stack Launcher" Icon="pack://application:,,,/Assets/launcher.ico" Width="1440" Height="980" MinWidth="1060" MinHeight="740"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="ProjectEditWindow_KeyDown">
    <Window.Resources>
        <Style x:Key="SidebarExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarCompactOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProjectAgentCountBadge" TargetType="Border">
            <Setter Property="Background" Value="#13272B"/>
            <Setter Property="BorderBrush" Value="#365A5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding AgentActivityDescription}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding AgentActivityDescription}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunningAgentCount}" Value="0">
                    <Setter Property="Background" Value="#15202B"/>
                    <Setter Property="BorderBrush" Value="#354252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProjectAgentCountText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunningAgentCount}" Value="0">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ProjectBranchTemplate">
            <Grid Margin="0,3,0,0" AutomationProperties.Name="{Binding DisplayText}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.ToolTip><ToolTip MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ToolTip></Grid.ToolTip>
                <TextBlock Text="GIT" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
        <Style x:Key="ProjectEditField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#142D2B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="#202B3A"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,6,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="Indicator" Text="+" Width="16"/><ContentPresenter VerticalAlignment="Center"/></StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter TargetName="Frame" Property="Background" Value="#203C3B"/><Setter TargetName="Frame" Property="BorderBrush" Value="#397767"/><Setter TargetName="Indicator" Property="Text" Value="✓"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceUtilityToggle" TargetType="ToggleButton" BasedOn="{StaticResource SectionToggle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ServiceLaunchButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#303844"/>
            <Setter Property="BorderBrush" Value="#586270"/>
            <Setter Property="Foreground" Value="#C5CDD9"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LaunchHalo" CornerRadius="10" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Margin="-3" Opacity="0" IsHitTestVisible="False"
                                Tag="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}">
                            <Border.Effect><DropShadowEffect Color="#69E2C0" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                        </Border>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ButtonContent" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasLiveUrl}" Value="True"><Setter TargetName="LaunchHalo" Property="Opacity" Value="0.25"/></DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasLiveUrl}" Value="True"/>
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                <Condition Binding="{Binding Tag, ElementName=LaunchHalo}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="ServiceLaunchPulse"><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="LaunchHalo" Storyboard.TargetProperty="Opacity" From="0.18" To="0.72" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard></BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="ServiceLaunchPulse"/></MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.6"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="LaunchHalo" Property="Opacity" Value="0"/>
                            <Setter TargetName="Frame" Property="Background" Value="#202B3A"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#344154"/>
                            <Setter TargetName="Frame" Property="Opacity" Value="1"/>
                            <Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSwaggerUnavailable}" Value="True">
                    <Setter Property="Background" Value="#FFD27A"/>
                    <Setter Property="BorderBrush" Value="#FFD27A"/>
                    <Setter Property="Foreground" Value="#33250D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLiveUrl}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#0C2925"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionsDropdownToggle" TargetType="ToggleButton" BasedOn="{StaticResource SectionToggle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#27364A"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Text="▾" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Frame" Property="Background" Value="#203C3B"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#397767"/>
                            <!-- Let an outside click on this button close the popup without reopening it. -->
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionMenuSwitch" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StateText" Grid.Column="1" Text="Off" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="12,0,8,0" VerticalAlignment="Center"/>
                            <Border x:Name="SwitchFrame" Grid.Column="2" Width="34" Height="20" CornerRadius="10" Background="#111923" BorderBrush="#8295AF" BorderThickness="1" VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb" Width="12" Height="12" Fill="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="StateText" Property="Text" Value="On"/>
                            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="SwitchFrame" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="SwitchFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#0C2925"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#243444"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="NextCommitSettingsButton" TargetType="ToggleButton" BasedOn="{StaticResource SectionToggle}">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Frame" Property="Background" Value="#203C3B"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#397767"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="LongRunningTaskCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame" Width="18" Height="18" VerticalAlignment="Center" Background="#111923" BorderBrush="#8295AF" BorderThickness="1" CornerRadius="3">
                                <Path x:Name="CheckMark" Data="M 3,8 L 6,11 L 13,4" Stroke="#0C2925" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBoxFrame" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#243444"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HideSectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="− Hide"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="ToolTip" Value="Hide this section. Reopen it from the Sections dropdown."/>
        </Style>
        <Style x:Key="ProjectDisclosureToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="Chevron" Text="›" Foreground="{StaticResource AccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="⌄"/><Setter TargetName="Chevron" Property="Margin" Value="0,-7,0,0"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#314859"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="DeveloperToolLaunchButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="0,2">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#314859"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.6"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <SolidColorBrush x:Key="ApiServiceNameBrush" Color="#8AB4F8"/>
        <SolidColorBrush x:Key="FrontendServiceNameBrush" Color="#69E2C0"/>
        <SolidColorBrush x:Key="DatabaseServiceNameBrush" Color="#FFD27A"/>
        <Style x:Key="ServiceCard" TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,2,12,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HeaderTemplate"><Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </DataTemplate>
            </Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <ContentPresenter ContentSource="Header" Margin="12,4,12,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" ContentSource="Content"
                                              TextElement.Foreground="{StaticResource TextBrush}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="AppServiceCard" TargetType="GroupBox" BasedOn="{StaticResource ServiceCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsApiService}" Value="True"><Setter Property="Foreground" Value="{StaticResource ApiServiceNameBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsFrontendService}" Value="True"><Setter Property="Foreground" Value="{StaticResource FrontendServiceNameBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseServiceCard" TargetType="GroupBox" BasedOn="{StaticResource ServiceCard}">
            <Setter Property="Foreground" Value="{StaticResource DatabaseServiceNameBrush}"/>
        </Style>
        <Style x:Key="ServiceCardHeader" TargetType="Grid">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style x:Key="ServiceMetadata" TargetType="Border">
            <Setter Property="Background" Value="#141D29"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,6,8,0"/>
        </Style>
        <Style x:Key="ServiceToolMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#293F50"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceToolMenuSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource BorderBrush}"/>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ServiceToolContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Background="Transparent" BorderThickness="0" MaxHeight="520"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="245"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition x:Name="NextCommitSplitterColumn" Width="0"/><ColumnDefinition x:Name="NextCommitColumn" Width="0"/></Grid.ColumnDefinitions>
        <Border x:Name="SidebarPanel" Grid.ColumnSpan="2" Panel.ZIndex="10" Width="245" HorizontalAlignment="Left"
                Focusable="True" AutomationProperties.Name="Projects and tools sidebar"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave"
                GotKeyboardFocus="Sidebar_GotKeyboardFocus" LostKeyboardFocus="Sidebar_LostKeyboardFocus">
            <Grid x:Name="SidebarContent" Margin="16,24,16,18">
                <Grid.RowDefinitions><RowDefinition x:Name="ProjectsRow" Height="*"/><RowDefinition x:Name="ToolsRow" Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ProjectsPanel" Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12" Style="{StaticResource SidebarExpandedOnly}">
                    <Grid>
