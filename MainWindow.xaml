                        </Border>
                    </Popup>
                </Grid>
                <Button Content="Git…" Click="GitWorkspace_Click" Padding="10,7" FontSize="11" Margin="0,0,6,5" ToolTip="Open repository setup, remotes, branches and the working tree">
