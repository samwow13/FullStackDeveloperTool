                                                        <TextBlock Text="{Binding ServiceTypeLabel}" Foreground="#CCD7E7" FontSize="13" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Background="#3D202A" BorderBrush="#E96B78" BorderThickness="1"
                                                            Visibility="{Binding HasOutputError, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Error in output" Foreground="#FFACA9" FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Directory}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" Margin="0,8,0,0"
                                                   Visibility="{Binding ShowCommandFolder, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Service working folder"/>
                                        <Border Background="#121A25" CornerRadius="5" Padding="8,6" Margin="0,8,0,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConsoleApp}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasApiConfiguration}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFrontendService}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Command}" FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,2,0,7"
                                                   Visibility="{Binding HasCardDetail, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="{Binding ProcessTrackingHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"
                                                   Visibility="{Binding ShowProcessTrackingHint, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Resolve conflict &amp; restart" Click="ResolveConflict_Click" IsEnabled="{Binding CanResolveConflict}"
                                                Margin="0,0,0,8" Padding="8,7" FontSize="11"
                                                ToolTip="Review and stop the processes blocking this service's port, then restart the service.">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                     </StackPanel>
                                     </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel>
                                <ItemsControl ItemsSource="{Binding ApiDatabases}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                <GroupBox Header="{Binding Title}" Style="{StaticResource DatabaseServiceCard}" AutomationProperties.Name="{Binding Title}">
                                    <StackPanel AutomationProperties.Name="{Binding Title}" TextElement.Foreground="{StaticResource TextBrush}">
                                            <Grid Style="{StaticResource ServiceCardHeader}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <ToggleButton DataContext="{Binding Service}" Content="Change DB" Click="ChangeDatabase_Click" Style="{StaticResource ServiceUtilityToggle}" Padding="9,5" FontSize="11"
                                                                IsEnabled="{Binding CanChangeDatabase}" AutomationProperties.Name="Change API database"
                                                                ToolTip="Change the Local API connection and restart that API." ToolTipService.ShowOnDisabled="True"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#111923" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                                                </Border>
                                            </Grid>
                                        <TextBlock Text="{Binding CardDetails}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="4,8,4,0"
                                                   Visibility="{Binding HasCardDetails, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </GroupBox>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <GroupBox Header="Database" Style="{StaticResource DatabaseServiceCard}" AutomationProperties.Name="{Binding Name, StringFormat=Database for {0}}"
                                        Visibility="{Binding ShowChangeDatabaseRecovery, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel AutomationProperties.Name="{Binding Name, StringFormat=Database for {0}}" TextElement.Foreground="{StaticResource TextBrush}">
                                            <Grid Style="{StaticResource ServiceCardHeader}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <ToggleButton Content="Change DB" Click="ChangeDatabase_Click" Style="{StaticResource ServiceUtilityToggle}" Padding="9,5" FontSize="11"
                                                                  IsEnabled="{Binding CanChangeDatabase}" AutomationProperties.Name="{Binding Name, StringFormat=Change database for {0}}"
                                                                  ToolTip="Change the Local API connection and restart this API." ToolTipService.ShowOnDisabled="True"/>
                                                </WrapPanel>
                                                <Border Grid.Column="1" Background="#111923" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DatabaseCardStatus}" Foreground="#FFD27A" FontWeight="SemiBold" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                                                </Border>
                                            </Grid>
                                        <TextBlock Text="{Binding DatabaseCardDetails}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="4,8,4,0"
                                                   Visibility="{Binding HasDatabaseCardDetails, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </GroupBox>
                                <ItemsControl ItemsSource="{Binding FlutterDatabases}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <GroupBox Header="{Binding Name}" Style="{StaticResource DatabaseServiceCard}" AutomationProperties.Name="{Binding Name}">
                                            <StackPanel AutomationProperties.Name="{Binding Name}" TextElement.Foreground="{StaticResource TextBrush}">
                                                    <Grid Style="{StaticResource ServiceCardHeader}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Grid.Column="1" Background="#111923" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                                                        </Border>
                                                    </Grid>
                                                <TextBlock Text="{Binding CardDetails}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="4,8,4,0"
                                                           Visibility="{Binding HasCardDetails, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
            </Grid>
                    </Grid>
                </Border>
            </Grid>
            <controls:CodexActivityStrip x:Name="CodexCrewPanel" Grid.Row="4" Margin="0,14,0,0" VisibleAgents="{Binding CodexCrewVisibleAgents, Mode=TwoWay}"
                                         AccountUsage="{Binding CodexAccountUsage}"
                                         CanStartAgent="{Binding CanStartAgent}"
                                         StartAgentRequested="StartCodexAgent_Click"
                                         ThoughtBubblesEnabled="{Binding CodexCrewThoughtBubblesEnabled, Mode=TwoWay}"
                                         ThoughtBubbleSeconds="{Binding CodexCrewThoughtBubbleSeconds, Mode=TwoWay}"
                                         WatcherRequested="CodexAlerts_Click"/>
            <Grid Grid.Row="5" Margin="0,14,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}"/><TextBlock Grid.Column="1" Text="{Binding LastChecked}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="15,0,0,0"/></Grid>
        </Grid>
        <GridSplitter x:Name="NextCommitSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Margin="0,24,0,16" Background="{StaticResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" Visibility="Collapsed" Focusable="True" AutomationProperties.Name="Resize Git Commit panel"/>
        <Grid x:Name="NextCommitPanel" Grid.Column="3" Visibility="Collapsed" Margin="0,12,22,4">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Margin="0,14,0,14"/>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="8,0,8,0" MinHeight="28">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceBrush}" Padding="8,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Git Commit" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                        <ToggleButton x:Name="NextCommitSettingsToggle" Style="{StaticResource NextCommitSettingsButton}"
                                      PreviewKeyDown="NextCommitSettingsToggle_PreviewKeyDown" ToolTip="Git commit settings"
                                      AutomationProperties.Name="Git commit settings" AutomationProperties.HelpText="Set PR sound reminder. Click outside or press Escape to close."/>
                        <Popup x:Name="NextCommitSettingsMenu" PlacementTarget="{Binding ElementName=NextCommitSettingsToggle}" Placement="Bottom" VerticalOffset="6"
                               IsOpen="{Binding IsChecked, ElementName=NextCommitSettingsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="NextCommitSettingsMenu_Opened">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Width="320"
                                    PreviewKeyDown="NextCommitSettingsMenu_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle">
                                <StackPanel>
                                    <TextBlock Text="Git commit settings" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding NextCommitStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>
                                    <TextBlock Text="{Binding NextCommitCharacterCount}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    <CheckBox Content="_PR sound reminder" Style="{StaticResource LongRunningTaskCheckBox}"
                                              IsChecked="{Binding NextCommitPrReminderEnabled, Mode=TwoWay}" Margin="0,8,0,0"
                                              AutomationProperties.Name="Enable PR sound reminder for commit message length"
                                              ToolTip="Off by default for each launcher session. First sound after 5 minutes, then every 5 minutes while the docked panel is visible and the selected commit message exceeds 3,000 characters."/>
                                    <TextBlock Text="Sound every 5 minutes above 3,000 message characters to remind you to make a PR. Counts message text, not code diff size."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" Padding="6,0,0,0">
                        <Button Style="{StaticResource HideSectionButton}" Click="CloseGitCommit_Click" AutomationProperties.Name="Hide Git Commit" ToolTip="Hide this panel. Reopen it from Sections → Git Commit."/>
                    </Border>
                </Grid>
                <Grid Grid.Row="1" Margin="14,8,14,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12" Visibility="{Binding HasNextCommitRepositoryChoices, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Label Content="_Repo" Target="{Binding ElementName=NextCommitRepositoryPicker}" Padding="0,0,8,0"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox x:Name="NextCommitRepositoryPicker" Grid.Column="1" ItemsSource="{Binding NextCommitRepositories}"
                                  SelectedItem="{Binding SelectedNextCommitRepository, Mode=TwoWay}" DisplayMemberPath="DisplayName"
                                  ToolTip="{Binding SelectedNextCommitRepository.RepositoryRoot}" AutomationProperties.Name="Git commit repository">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem">
                                <Setter Property="ToolTip" Value="{Binding RepositoryRoot}"/>
                            </Style></ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Margin="0,12,0,0"/>
                            <Grid Margin="8,0,8,0" MinHeight="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource CardBrush}" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="Git Comparison" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding DashboardGitReleaseTargetLabel}" Foreground="{Binding DashboardGitReleaseTargetColor}"
                                           Background="{StaticResource CardBrush}" Padding="6,0" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,8,0" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DashboardGitReleaseTargetTooltip}" AutomationProperties.Name="{Binding DashboardGitReleaseTargetLabel}"/>
                                <Button Grid.Column="2" Click="DashboardGitOptions_Click" Padding="6,4" Background="{StaticResource CardBrush}"
                                        ToolTip="Git comparison options" AutomationProperties.Name="Git comparison options">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource ServiceToolContextMenu}">
                                            <MenuItem Header="Git-only conflict test" Style="{StaticResource ServiceToolMenuItem}" Click="DashboardGitConflictCheck_Click"
                                                      IsEnabled="{Binding CanRequestDashboardGitCheck}" ToolTipService.ShowOnDisabled="True"
                                                      ToolTip="{Binding DashboardGitConflictSchedule}" AutomationProperties.Name="Queue Git-only conflict test"/>
                                            <MenuItem Header="Details…" Style="{StaticResource ServiceToolMenuItem}" Click="DashboardGitConflictDetails_Click"
                                                      IsEnabled="{Binding HasDashboardGitConflictResult}" ToolTip="Exact compared commits, conflict paths, and Git diagnostics"/>
                                            <Separator Style="{StaticResource ServiceToolMenuSeparator}"/>
                                            <MenuItem Header="Manual only · committed history" Style="{StaticResource ServiceToolMenuItem}" IsEnabled="False"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                        <StackPanel Grid.Row="1" Margin="10,2,10,10">
                            <Grid MinHeight="80">
                                <StackPanel Visibility="{Binding IsDashboardGitComparisonLoaded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding DashboardGitComparisonLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Changed files" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitChangedFiles}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" ToolTip="{Binding DashboardGitLineTotalsTooltip}"><TextBlock Text="Lines added" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitAddedLines}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" ToolTip="{Binding DashboardGitLineTotalsTooltip}"><TextBlock Text="Lines removed" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding DashboardGitRemovedLines}" Foreground="#FFACA9" FontWeight="SemiBold" FontSize="17" Margin="0,3,0,0"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding DashboardGitComparisonDetail}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                               ToolTip="Untracked and binary contents are excluded from line totals. Ahead/behind counts appear when nonzero."/>
                                </StackPanel>
                                <StackPanel x:Name="DashboardGitComparisonLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsDashboardGitComparisonLoading, Converter={StaticResource BoolToVisibility}}"
                                            IsVisibleChanged="DashboardGitComparisonLoading_IsVisibleChanged"
                                            AutomationProperties.Name="Loading Git comparison" AutomationProperties.LiveSetting="Polite">
                                    <Grid Width="28" Height="28" HorizontalAlignment="Center" Margin="0,0,0,7">
                                        <Ellipse Stroke="#293B50" StrokeThickness="2.5"/>
                                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 14,1.25 A 12.75,12.75 0 0 1 26.75,14" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                                            <Path.Style><Style TargetType="Path"><Style.Triggers>
                                                <DataTrigger Binding="{Binding AnimateDashboardGitComparisonLoading}" Value="True">
                                                    <DataTrigger.EnterActions><BeginStoryboard x:Name="DashboardGitComparisonSpinAnimation"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="DashboardGitComparisonSpinAnimation"/></DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers></Style></Path.Style>
                                        </Path>
                                    </Grid>
                                    <TextBlock Text="Loading Git comparison…" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DashboardGitConflictStatus}" Foreground="{Binding DashboardGitConflictStatusColor}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding HasDashboardGitConflictStatus, Converter={StaticResource BoolToVisibility}}"
                                       ToolTip="{Binding DashboardGitConflictSchedule}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock Text="{Binding NextCommitStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasNextCommitStatusNotice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding NextCommitDraftHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding HasNextCommitDraftHint, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding NextCommitLimitStatus}" FontSize="11" TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding NextCommitLimitStatus}" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers>
                                <DataTrigger Binding="{Binding NextCommitOverLimit}" Value="True"><Setter Property="Foreground" Value="#FFACA9"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <controls:CommitMessagePreview x:Name="NextCommitMessagePreview" Presentation="{Binding NextCommitPresentation}" ReadRequested="NextCommitMessage_ReadRequested"
                                                       Margin="0,8,0,0" MinHeight="80" AutomationProperties.Name="Git commit message"
                                                       ToolTip="Unread text is mint and underlined. Click the message or press Enter to mark displayed updates read."/>
                        <Border Background="#0C131D" Padding="8,0" Margin="8,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                            <TextBlock Text="Commit message" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Grid>
                <WrapPanel Grid.Row="2" Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Left" Margin="8,0,8,0">
                    <Button Content="Open _Git" Click="OpenGit_Click" Padding="9,6" FontSize="11" Margin="0,0,6,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
