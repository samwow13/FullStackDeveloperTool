                                                AutomationProperties.Name="{Binding Name, StringFormat=Copy console output for {0}}"/>
                                        <Button Content="Clear output" Click="ClearServiceConsole" Style="{StaticResource ServiceCardAction}" IsEnabled="{Binding HasConsoleOutput}"
                                                ToolTip="Clear this service's retained output and error indicator. New output continues to be captured."
                                                AutomationProperties.Name="{Binding Name, StringFormat=Clear console output for {0}}"/>
                                        <Button Content="Expand output ↗" Click="ExpandServiceConsole_Click" Style="{StaticResource ServiceCardAction}"
