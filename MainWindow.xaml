                                  AutomationProperties.Name="Sections dropdown" AutomationProperties.HelpText="Switches keep the dropdown open. Click outside or press Escape to close."/>
                    <Popup x:Name="SectionsMenu" PlacementTarget="{Binding ElementName=SectionsMenuToggle}" Placement="Bottom" VerticalOffset="6"
                           IsOpen="{Binding IsChecked, ElementName=SectionsMenuToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="SectionsMenu_Opened">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Width="280"
                                PreviewKeyDown="SectionsMenu_PreviewKeyDown" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <StackPanel>
                                <TextBlock Text="Show sections" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,5,10,8"/>
                                <ToggleButton x:Name="ProjectsToggle" Content="Projects" Style="{StaticResource SectionMenuSwitch}" IsChecked="{Binding ProjectsVisible, Mode=TwoWay}" AutomationProperties.Name="Show projects" ToolTip="Show or hide the saved projects section"/>
                                <ToggleButton x:Name="ToolsToggle" Content="Tools" Style="{StaticResource SectionMenuSwitch}" IsChecked="{Binding ToolsVisible, Mode=TwoWay}" AutomationProperties.Name="Show developer tools" ToolTip="Show or hide developer tools"/>
                                <ToggleButton x:Name="ServicesToggle" Content="Services" Style="{StaticResource SectionMenuSwitch}" IsChecked="{Binding ServicesVisible, Mode=TwoWay}" AutomationProperties.Name="Show services" ToolTip="Show or hide services and batch controls"/>
                                <ToggleButton x:Name="NextCommitToggle" Content="{Binding NextCommitToggleLabel}" IsChecked="{Binding NextCommitVisible, Mode=TwoWay}"
                                              AutomationProperties.Name="Show next commit" ToolTip="Show the live next commit message, viewed AI updates, and the 4,000-character limit beside Services">
                                    <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource SectionMenuSwitch}"><Style.Triggers>
                                        <DataTrigger Binding="{Binding NextCommitOverLimit}" Value="True"><Setter Property="Foreground" Value="#FFACA9"/><Setter Property="BorderBrush" Value="#E96B78"/></DataTrigger>
                                    </Style.Triggers></Style></ToggleButton.Style>
                                </ToggleButton>
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="10,6,10,8"/>
                                <CheckBox Content="Long Running Task" IsChecked="{Binding LongRunningTaskEnabled, Mode=OneWay}" Click="LongRunningTask_Click"
                                          Style="{StaticResource SectionMenuSwitch}" ToolTipService.ShowDuration="30000"
                                          AutomationProperties.Name="Long Running Task" AutomationProperties.HelpText="{Binding LongRunningTaskDescription}">
                                    <CheckBox.ToolTip><ToolTip MaxWidth="440"><TextBlock Text="{Binding LongRunningTaskDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/></ToolTip></CheckBox.ToolTip>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Button Content="Git…" Click="GitWorkspace_Click" Padding="10,7" FontSize="11" Margin="0,0,6,5" ToolTip="Open repository setup, remotes, branches and the working tree">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                </Button>
                <Button Content="Notes &amp; queue ↗" Click="ProjectTasks_Click" Padding="10,7" FontSize="11" Margin="0,0,6,5" ToolTip="Open notes and the Codex task queue for the selected project"/>
            </WrapPanel>
            <Border x:Name="BatchControlsPanel" Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="9" Padding="14,10" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Live process and endpoint status" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                    <WrapPanel Grid.Row="1" Margin="0,10,0,-5">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,5">
                            <Button Content="▶  Start all" Style="{StaticResource PrimaryButton}" Click="StartAll_Click"
                                    IsEnabled="{Binding CanStartBatch}" ToolTip="{Binding StartAllDescription}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.HelpText="{Binding StartAllDescription}"/>
                            <Border Background="#173B34" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7"
                                    Padding="9,6" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding AllServicesRunning, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="● Running" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11"
                                           ToolTip="All services are running." AutomationProperties.Name="All services are running"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </Border>
                        </StackPanel>
                        <Button Content="Restart all" Click="RestartAll_Click" IsEnabled="{Binding CanBatch}" Margin="0,0,8,5"/>
                        <Button Content="■  Force stop all" Style="{StaticResource DangerButton}" Click="StopAll_Click" IsEnabled="{Binding CanStopBatch}" Margin="0,0,8,5"/>
                    </WrapPanel>
                </Grid>
                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <TextBlock Text="EDIT MODE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,5"/>
                        <Button Content="{Binding EditSaveLabel}" Click="SaveProjectEdits_Click" IsEnabled="{Binding CanSaveProjectEdits}" Style="{StaticResource PrimaryButton}" Padding="10,6" Margin="0,0,8,5"/>
                        <Button Content="Cancel" Click="CancelProjectEdits_Click" IsEnabled="{Binding CanCancelProjectEdits}" Padding="10,6" Margin="0,0,8,5"/>
                        <Button Content="Save &amp; more options…" Click="ProjectDetails_Click" IsEnabled="{Binding CanEditDetails}" ToolTip="Save these edits, then manage paths, commands and services. Stop all project services first." ToolTipService.ShowOnDisabled="True" Padding="10,6" Margin="0,0,0,5"/>
                    </WrapPanel>
                    <TextBlock Text="Highlighted fields are editable. API port edits require the API and affected Angular frontends stopped. Enter saves · Esc cancels." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasEditError, Converter={StaticResource BoolToVisibility}}" Margin="0,7,0,0">
                        <TextBlock Text="{Binding EditError}" Foreground="#FFACA9" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </ScrollViewer>
                </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="3">
                    <Grid x:Name="ServicesPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Services" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource HideSectionButton}" Tag="Services" Click="HideSection_Click" HorizontalAlignment="Right" AutomationProperties.Name="Hide services"/>
                        </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <ItemsControl ItemsSource="{Binding Services}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                    <Border Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="SERVICE NAME" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectEditField}" IsEnabled="{Binding DataContext.CanSaveProjectEdits, RelativeSource={RelativeSource AncestorType=Window}}" KeyDown="ProjectEditField_KeyDown" AutomationProperties.Name="Service name"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Width="90" Visibility="{Binding HasWebEndpoint, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="DESIRED PORT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding DraftPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ProjectEditField}" IsEnabled="{Binding CanEditPort}" KeyDown="ProjectEditField_KeyDown" MaxLength="5" AutomationProperties.Name="Desired port" ToolTip="{Binding PortEditHint}" ToolTipService.ShowOnDisabled="True"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding PortEditHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasWebEndpoint, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Stop service to edit port" Click="StopService_Click" IsEnabled="{Binding CanStop}" Style="{StaticResource DangerButton}" Padding="8,5" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding CanStopForPortEdit, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                     </Border>
                                     <Expander Style="{StaticResource ServiceCardExpander}" AutomationProperties.Name="{Binding Name}">
                                        <Expander.Tag>
                                            <Grid Margin="29,4,0,2" Visibility="{Binding HasLiveUrl, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button Click="OpenUrl_Click" IsEnabled="{Binding HasLiveUrl}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Padding="0,3"
                                                        ToolTip="{Binding LiveUrl}" AutomationProperties.Name="{Binding LiveUrl, StringFormat=Open {0}}">
                                                    <TextBlock Text="{Binding LiveUrl}" TextTrimming="CharacterEllipsis" TextAlignment="Left"/>
                                                </Button>
                                                <Button Grid.Column="1" Content="Copy" Click="CopyServiceUrl_Click" IsEnabled="{Binding HasLiveUrl}"
                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="10" Padding="5,3"
                                                        ToolTip="Copy this live service address" AutomationProperties.Name="{Binding Name, StringFormat=Copy live address for {0}}"/>
                                            </Grid>
                                        </Expander.Tag>
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Border Grid.Column="1" Background="#111923" CornerRadius="5" Padding="10,5" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding StateColor}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StateColor}" FontWeight="SemiBold" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                                                    <Border Style="{StaticResource ServiceMetadata}">
                                                        <TextBlock Text="{Binding DesiredPortLabel}" Foreground="#CCD7E7" FontSize="13" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Visibility="{Binding ShowApiDatabaseLabel, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding ApiDatabaseDetails}">
                                                        <TextBlock Text="{Binding ApiDatabaseLabel}" Foreground="{StaticResource AccentBrush}" FontSize="13" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Visibility="{Binding SourceLines.IsVisible, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTipService.ShowDuration="30000">
                                                        <Border.ToolTip><ToolTip><TextBlock Text="{Binding SourceLines.Details}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
                                                        <TextBlock Text="{Binding SourceLines.Summary}" Foreground="{Binding SourceLines.Foreground}" FontSize="13" TextWrapping="Wrap"
                                                                   AutomationProperties.LiveSetting="Polite"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Visibility="{Binding SourceLines.HasAverage, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTipService.ShowDuration="30000">
                                                        <Border.ToolTip><ToolTip><TextBlock Text="{Binding SourceLines.Details}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
                                                        <TextBlock Text="{Binding SourceLines.AverageSummary}" Foreground="{Binding SourceLines.Foreground}" FontSize="13" TextWrapping="Wrap"
                                                                   AutomationProperties.LiveSetting="Polite"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Visibility="{Binding ApiEndpoints.IsVisible, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTipService.ShowDuration="30000">
                                                        <Border.ToolTip><ToolTip><TextBlock Text="{Binding ApiEndpoints.Details}" MaxWidth="440" TextWrapping="Wrap"/></ToolTip></Border.ToolTip>
                                                        <TextBlock Text="{Binding ApiEndpoints.Summary}" Foreground="{Binding ApiEndpoints.Foreground}" FontSize="13" TextWrapping="Wrap"
                                                                   AutomationProperties.LiveSetting="Polite"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Background="{Binding ConfigurationBackground}" BorderBrush="{Binding ConfigurationBorder}" BorderThickness="1"
                                                            Visibility="{Binding HasApiConfiguration, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding ConfigurationStatus}" Foreground="{Binding ConfigurationColor}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Border Style="{StaticResource ServiceMetadata}" Background="#3D202A" BorderBrush="#E96B78" BorderThickness="1"
                                                            Visibility="{Binding HasOutputError, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Error in output" Foreground="#FFACA9" FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                                                    </Border>
                                                </WrapPanel>
                                            </Grid>
                                        </Expander.Header>
                                    <StackPanel>
                                        <Border Background="{Binding ConfigurationBackground}" BorderBrush="{Binding ConfigurationBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,2"
