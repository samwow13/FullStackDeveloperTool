                                <ToggleButton x:Name="ToolsToggle" Content="Tools" Style="{StaticResource SectionMenuSwitch}" IsChecked="{Binding ToolsVisible, Mode=TwoWay}" AutomationProperties.Name="Show developer tools" ToolTip="Show or hide developer tools"/>
                                <ToggleButton x:Name="ServicesToggle" Content="Services" Style="{StaticResource SectionMenuSwitch}" IsChecked="{Binding ServicesVisible, Mode=TwoWay}" AutomationProperties.Name="Show services" ToolTip="Show or hide services and batch controls"/>
                                <ToggleButton x:Name="NextCommitToggle" Content="{Binding NextCommitToggleLabel}" IsChecked="{Binding NextCommitVisible, Mode=TwoWay}"
