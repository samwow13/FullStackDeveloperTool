<Window x:Class="FullStackLauncher.DeveloperToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer tools" Icon="pack://application:,,,/Assets/launcher.ico" Width="930" Height="650" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ToolFieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="ToolHelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="Your development tools" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Keep pgAdmin, desktop apps, and useful websites available across every project."
                       Margin="0,7,0,0" Style="{StaticResource ToolHelpText}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SAVED TOOLS" FontSize="11" FontWeight="SemiBold"
                               Margin="2,0,0,12" Foreground="{DynamicResource MutedBrush}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Content="＋ Add desktop app" Click="AddApplication_Click" Margin="0,0,0,7" />
                        <Button Content="＋ Add website" Click="AddWebsite_Click" Margin="0,0,0,7" />
                        <Button Content="＋ Add pgAdmin" Click="AddPgAdmin_Click" Margin="0,0,0,12" />
                        <Button x:Name="RemoveToolButton" Content="Remove selected" Click="RemoveTool_Click" />
                    </StackPanel>
                    <ListBox x:Name="ToolsList" SelectionChanged="ToolsList_SelectionChanged"
                             AutomationProperties.Name="Saved developer tools" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="22,10,22,20"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <StackPanel x:Name="EmptyToolsHint" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="290">
                        <TextBlock Text="Everything in one place" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="Add a desktop app, a website, or pgAdmin to create your first shortcut."
                                   Style="{StaticResource ToolHelpText}" Margin="0,10,0,0" TextAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ToolForm" Margin="0,0,8,0">
                            <TextBlock Text="Shortcut name" Style="{StaticResource ToolFieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"
                                     AutomationProperties.Name="Tool shortcut name" LostFocus="ToolName_LostFocus" />
                            <TextBlock Text="Open as" Style="{StaticResource ToolFieldLabel}" />
                            <ComboBox x:Name="KindSelector" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="KindSelector_SelectionChanged" MinHeight="36"
                                      AutomationProperties.Name="Tool type">
                                <ComboBoxItem Content="Desktop app (.exe)" Tag="Application" />
                                <ComboBoxItem Content="Website" Tag="Website" />
                                <ComboBoxItem Content="pgAdmin 4 desktop" Tag="PgAdmin" />
                            </ComboBox>
                            <TextBlock x:Name="TargetLabel" Text="Application executable" Style="{StaticResource ToolFieldLabel}" />
                            <DockPanel>
                                <Button x:Name="BrowseTargetButton" DockPanel.Dock="Right" Content="Browse…"
                                        Click="BrowseTarget_Click" Margin="8,0,0,0" Padding="12,6" />
                                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"
                                         AutomationProperties.Name="Tool executable or website URL" />
                            </DockPanel>
                            <TextBlock x:Name="TargetHint" Style="{StaticResource ToolHelpText}" Margin="0,9,0,0" />
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Available in every project" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                    <TextBlock Text="These shortcuts are saved with your launcher settings and remain available when you switch projects."
                                               Style="{StaticResource ToolHelpText}" />
                                    <TextBlock x:Name="SettingsDirectoryHint" Style="{StaticResource ToolHelpText}" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Changes apply when you save." Style="{StaticResource ToolHelpText}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" MinWidth="95" Margin="0,0,10,0" />
                <Button Content="Save tools" Click="Save_Click" IsDefault="True" MinWidth="125"
                        Background="{DynamicResource AccentBrush}" Foreground="#0C2925" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
