<Window x:Class="FullStackLauncher.CodexMonitor.CodexMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex completion alerts" Icon="pack://application:,,,/Assets/launcher.ico"
        Width="1000" Height="850" MinWidth="760" MinHeight="690" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CODEX / COMPLETION ALERTS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/>
            <TextBlock Text="Follow work across your projects." FontSize="25" FontWeight="SemiBold" Margin="0,7,0,7"/>
            <TextBlock Text="Keep live progress in view, with an optional reminder sound when a watched project finishes." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
        <StackPanel>
        <Grid Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Codex project folder" Margin="0,0,0,6"/>
                <ComboBox x:Name="ProjectPicker" IsEditable="True" IsTextSearchEnabled="False" Padding="8" AutomationProperties.Name="Codex project folder"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Add project to watch" Click="Watch_Click" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="WatchedProjectList" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="Watched projects">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,5">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding ProjectPath}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="Remove" Click="RemoveWatch_Click" Tag="{Binding ProjectPath}" Padding="8,3" ToolTip="Stop watching this project" AutomationProperties.Name="{Binding ProjectName, StringFormat='Stop watching {0}'}"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Visibility="{Binding HasParentWorkspace, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ParentWorkspaceHint}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding ParentWorkspacePath}"/>
                                        <Button Grid.Column="1" Content="Watch workspace" Click="WatchWorkspace_Click" Tag="{Binding ParentWorkspacePath}" Padding="8,3" ToolTip="{Binding ParentWorkspacePath, StringFormat='Add a watch for the whole workspace: {0}'}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="WatchedProjectsEmpty" Text="No projects watched. Add a project folder above to start." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,3" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Connecting to local Codex status…" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="DetailText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="CheckedText" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button x:Name="OverlayToggleButton" Content="Show chat progress" Click="OverlayToggle_Click" Margin="0,0,8,5"/>
            <Button Content="Clear finished chats" Click="ClearFinished_Click" Margin="0,0,8,5"/>
            <Button Content="Dismiss reminder" Click="Dismiss_Click" Margin="0,0,8,5"/>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,0" Margin="0,0,8,5">
                <CheckBox x:Name="ReminderSoundCheckBox" Content="Enable Sounds" Click="ReminderSound_Click" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="3,7" ToolTip="Play a sound when watched work finishes, then every minute until dismissed. Turning this off keeps project monitoring and live progress active." AutomationProperties.Name="Enable Sounds"/>
            </Border>
            <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,5"/>
        </WrapPanel>
        <TabControl Grid.Row="3" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="Chat progress" Foreground="#15202E">
                <Grid Background="{StaticResource SurfaceBrush}">
                    <ListBox x:Name="ProgressChatList" Margin="8" Foreground="{StaticResource TextBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Chat progress and finished chats">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="5,7"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding DotColor}" VerticalAlignment="Center" ToolTip="{Binding Status}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectPath}" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" ToolTip="{Binding Title}"/>
                                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EstimateText}" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" ToolTip="{Binding EstimateDetail}"/>
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Clear" Click="ClearFinishedChat_Click" Tag="{Binding Id}" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}" Margin="10,0,0,0" Padding="8,4" ToolTip="Clear this finished chat indicator"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="ProgressEmpty" Text="New activity will appear here. Finished chats stay until you clear them." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22" IsHitTestVisible="False"/>
                </Grid>
            </TabItem>
            <TabItem Header="All tasks and agents" Foreground="#15202E">
        <ListView x:Name="AgentList" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Monitored Codex tasks">
            <ListView.View><GridView>
                <GridViewColumn Header="Task / agent" Width="380">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkingFolder}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Project" Width="190">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectPath}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Status" Width="105" DisplayMemberBinding="{Binding State}"/>
                <GridViewColumn Header="Rough estimate" Width="155">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EstimateText}" ToolTip="{Binding EstimateDetail}"/></DataTemplate></GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView></ListView.View>
        </ListView>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Estimates are rough timing guesses. Codex does not report a work percentage; estimates stay below 100% until completion is confirmed." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" ToolTip="A percentage estimates timing, not how much work an agent has completed. Task length can vary, so estimates may change and cannot promise a finish time. Only confirmed completion shows 100%."/>
            <TextBlock Text="Reads local Codex status only; remote and cloud tasks are not covered. Keep Codex open. Closing this window keeps the monitor in your system tray." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SourceText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hide to tray" Click="Hide_Click" Margin="0,0,8,0"/>
                    <Button Content="Exit monitor" Click="Exit_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
