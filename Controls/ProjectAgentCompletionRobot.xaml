<UserControl x:Class="FullStackLauncher.Controls.ProjectAgentCompletionRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="30" IsHitTestVisible="False" Focusable="False" IsTabStop="False"
             UseLayoutRounding="True" AutomationProperties.Name="Agent completed"
             AutomationProperties.HelpText="Select this project to acknowledge completed work.">
    <Viewbox Stretch="Uniform">
        <Canvas Width="42" Height="38">
            <Ellipse Canvas.Left="8" Canvas.Top="35" Width="27" Height="3" Fill="#0B121C"/>
            <Canvas Width="42" Height="38">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="DanceTilt" CenterX="21" CenterY="29"/>
                        <TranslateTransform x:Name="DanceBounce"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Path Data="M 21,7 L 21,4" Stroke="#7797A5" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="19" Canvas.Top="1" Width="4" Height="4" Fill="#72E5C3"/>
                <Rectangle Canvas.Left="7" Canvas.Top="12" Width="4" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#597887"/>
                <Rectangle Canvas.Left="31" Canvas.Top="12" Width="4" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#597887"/>
                <Border Canvas.Left="10" Canvas.Top="7" Width="22" Height="16" CornerRadius="5"
                        Background="#35505B" BorderBrush="#86BDBD" BorderThickness="1.1"/>
                <Border Canvas.Left="13" Canvas.Top="10" Width="16" Height="10" CornerRadius="3" Background="#111F2A"/>
                <Path Data="M 15,14 Q 17,10 19,14 M 23,14 Q 25,10 27,14 M 18,17 Q 21,20 24,17"
                      Stroke="#72E5C3" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 17,22 L 17,25 M 25,22 L 25,25" Stroke="#607A89" StrokeThickness="2.5"/>
                <Border Canvas.Left="15" Canvas.Top="24" Width="12" Height="8" CornerRadius="3"
                        Background="#293D49" BorderBrush="#86BDBD" BorderThickness="1"/>
                <Path Data="M 19,27 L 21,28 L 19,29 M 23,29 L 25,29" Stroke="#72E5C3" StrokeThickness="1"/>
                <Path Data="M 16,26 Q 9,25 6,18" Stroke="#86BDBD" StrokeThickness="2.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.RenderTransform><RotateTransform x:Name="LeftArmSwing" CenterX="16" CenterY="26" Angle="-8"/></Path.RenderTransform>
                </Path>
                <Path Data="M 26,26 Q 34,24 36,17" Stroke="#86BDBD" StrokeThickness="2.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.RenderTransform><RotateTransform x:Name="RightArmSwing" CenterX="26" CenterY="26" Angle="8"/></Path.RenderTransform>
                </Path>
                <Path Data="M 18,31 L 17,34 L 13,34" Stroke="#91C8C5" StrokeThickness="2.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                    <Path.RenderTransform><RotateTransform x:Name="LeftFootStep" CenterX="18" CenterY="31" Angle="-5"/></Path.RenderTransform>
                </Path>
                <Path Data="M 24,31 L 25,34 L 29,34" Stroke="#91C8C5" StrokeThickness="2.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                    <Path.RenderTransform><RotateTransform x:Name="RightFootStep" CenterX="24" CenterY="31" Angle="5"/></Path.RenderTransform>
                </Path>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
