<UserControl x:Class="FullStackLauncher.Controls.CommitMessagePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             Foreground="#EDF3FC" MinHeight="100">
    <Border Background="#0C131D" BorderBrush="#2E3D52" BorderThickness="1" CornerRadius="8" Padding="12">
        <RichTextBox x:Name="MessageText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                     IsUndoEnabled="False" Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="#EDF3FC" SelectionBrush="#367060" SelectionOpacity="0.7"
                     FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" SpellCheck.IsEnabled="False"
                     PreviewMouseLeftButtonDown="MessageMouseDown" PreviewMouseLeftButtonUp="MessageSelectionEnded"
                     LostMouseCapture="MessageSelectionEnded" PreviewKeyDown="MessageKeyDown"
                     AutomationProperties.Name="Git commit message"
                     AutomationProperties.HelpText="New AI text is mint and underlined. Click the message or press Enter to mark its displayed AI updates viewed."
                     ToolTip="Mint underlined text is new. Click the message or press Enter to mark displayed AI updates viewed.">
            <FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="13" LineHeight="21"/>
        </RichTextBox>
    </Border>
</UserControl>
