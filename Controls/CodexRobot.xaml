<UserControl x:Class="FullStackLauncher.Controls.CodexRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Robot" Width="68" Height="56"
             IsHitTestVisible="False" Focusable="False" IsTabStop="False"
             UseLayoutRounding="True" Foreground="#72E5C3"
             AutomationProperties.Name="Codex agent idle">
    <Viewbox Stretch="Uniform">
        <Canvas Width="76" Height="62">
            <!-- A little workstation keeps every pose grounded, even without motion. -->
            <Ellipse Canvas.Left="8" Canvas.Top="55" Width="63" Height="4" Fill="#0B121C"/>
            <Path Data="M 47,51 L 70,51" Stroke="#637387" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 60,45 L 60,50" Stroke="#637387" StrokeThickness="2"/>
            <Grid Canvas.Left="47" Canvas.Top="29" Width="24" Height="18" RenderTransformOrigin="0.5,1">
                <Grid.RenderTransform><RotateTransform Angle="-5"/></Grid.RenderTransform>
                <Border Background="#101A25" BorderBrush="#53677A" BorderThickness="1" CornerRadius="3"/>
                <Canvas Margin="4,4,3,3">
                    <Path Data="M 0,1 L 3,3 L 0,5" Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Path x:Name="ScreenCode" Data="M 6,1 L 11,1 M 6,4 L 14,4 M 0,8 L 8,8" Stroke="#7395A5" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Rectangle x:Name="ScreenCursor" Canvas.Left="11" Canvas.Top="7" Width="3" Height="1.5" Fill="{Binding Foreground, ElementName=Robot}"/>
                </Canvas>
            </Grid>

            <Path Data="M 25,30 L 25,35 M 35,30 L 35,35" Stroke="#607A89" StrokeThickness="3"/>
            <Border Canvas.Left="21" Canvas.Top="33" Width="20" Height="16" CornerRadius="5,5,3,3"
                    Background="#293D49" BorderBrush="#607A89" BorderThickness="1"/>
            <Path Data="M 26,38 L 29,40 L 26,42 M 32,42 L 36,42" Stroke="#78ACAC" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path Data="M 23,36 Q 16,39 18,47" Stroke="#597888" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path x:Name="RestingRightArm" Data="M 39,36 Q 45,40 42,47" Stroke="#597888" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <Path x:Name="RaisedRightArm" Visibility="Collapsed" Data="M 39,36 Q 53,34 55,20" Stroke="#597888" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

            <Path Data="M 13,49 Q 13,48 15,48 L 45,48 Q 47,48 48,50 L 51,54 Q 51,56 49,56 L 12,56 Q 10,56 11,54 Z"
                  Fill="#293745" Stroke="#617286" StrokeThickness="1"/>
            <Path Data="M 16,51 L 44,51 M 14,53 L 46,53 M 21,50 L 20,54 M 27,50 L 27,54 M 33,50 L 34,54 M 39,50 L 40,54"
                  Stroke="#A0B2C3" StrokeThickness="0.7" Opacity="0.72"/>
            <Rectangle Canvas.Left="23" Canvas.Top="54" Width="13" Height="1" RadiusX="0.5" RadiusY="0.5" Fill="#A0B2C3"/>

            <Ellipse x:Name="LeftHand" Canvas.Left="16" Canvas.Top="46" Width="9" Height="5" Fill="#91C8C5" Stroke="#365560" StrokeThickness="0.8">
                <Ellipse.RenderTransform><TranslateTransform x:Name="LeftHandMotion"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="RightHand" Canvas.Left="35" Canvas.Top="46" Width="9" Height="5" Fill="#91C8C5" Stroke="#365560" StrokeThickness="0.8">
                <Ellipse.RenderTransform><TranslateTransform x:Name="RightHandMotion"/></Ellipse.RenderTransform>
            </Ellipse>

            <Canvas x:Name="Head" Width="60" Height="36">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="HeadTilt" CenterX="30" CenterY="25"/>
                        <TranslateTransform x:Name="HeadMotion"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Path Data="M 30,8 L 30,4" Stroke="#7797A5" StrokeThickness="1.5"/>
                <Ellipse x:Name="Antenna" Canvas.Left="27.5" Canvas.Top="1" Width="5" Height="5"
                         Fill="{Binding Foreground, ElementName=Robot}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="16" Width="5" Height="9" RadiusX="2" RadiusY="2" Fill="#597887"/>
                <Rectangle Canvas.Left="45" Canvas.Top="16" Width="5" Height="9" RadiusX="2" RadiusY="2" Fill="#597887"/>
                <Border Canvas.Left="13" Canvas.Top="8" Width="34" Height="25" CornerRadius="8"
                        Background="#35505B" BorderBrush="#86BDBD" BorderThickness="1.2"/>
                <Border Canvas.Left="17" Canvas.Top="12" Width="26" Height="18" CornerRadius="5"
                        Background="#111F2A" BorderBrush="#294552" BorderThickness="0.7"/>
                <Canvas x:Name="OpenEyes">
                    <Rectangle Canvas.Left="22" Canvas.Top="17" Width="4" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Foreground, ElementName=Robot}"/>
                    <Rectangle Canvas.Left="34" Canvas.Top="17" Width="4" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Foreground, ElementName=Robot}"/>
                </Canvas>
                <Path x:Name="SleepEyes" Visibility="Collapsed" Data="M 21,20 Q 24,22.5 27,20 M 33,20 Q 36,22.5 39,20"
                      Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="WaitingEyes" Visibility="Collapsed" Data="M 21,18 L 27,18 M 33,18 L 39,18 M 24,18 L 24,21 M 36,18 L 36,21"
                      Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="ExcitedEyes" Visibility="Collapsed" Data="M 21,20 Q 24,15 27,20 M 33,20 Q 36,15 39,20"
                      Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="UnknownEyes" Visibility="Collapsed" Data="M 21,20 L 27,20 M 33,20 L 39,20"
                      Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="FailedEyes" Visibility="Collapsed" Data="M 22,17 L 26,21 M 26,17 L 22,21 M 34,17 L 38,21 M 38,17 L 34,21"
                      Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="RestingMouth" Data="M 28,24 Q 30,25.5 32,24"
                      Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Canvas x:Name="TalkingMouth" Canvas.Left="24" Canvas.Top="22.5" Width="12" Height="7" Visibility="Collapsed">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="MouthOpening" ScaleY="1" CenterX="6" CenterY="3.5"/>
                    </Canvas.RenderTransform>
                    <Rectangle Width="12" Height="7" RadiusX="3" RadiusY="3" Fill="#071019"
                               Stroke="{Binding Foreground, ElementName=Robot}" StrokeThickness="1.4"/>
                    <Rectangle Canvas.Left="3" Canvas.Top="4.4" Width="6" Height="1.3" RadiusX="0.6" RadiusY="0.6"
                               Fill="{Binding Foreground, ElementName=Robot}"/>
                </Canvas>
            </Canvas>

            <Canvas x:Name="RaisedHand" Canvas.Left="50" Canvas.Top="6" Width="12" Height="15" Visibility="Collapsed">
                <Canvas.RenderTransform><RotateTransform x:Name="RaisedHandWave" CenterX="5" CenterY="14"/></Canvas.RenderTransform>
                <Path Data="M 3,14 Q 0,11 1,8 L 0,6 Q 0,4 2,5 L 3,7 L 3,2 Q 3,0 5,2 L 5,6 L 6,1 Q 7,-1 8,1 L 8,6 L 9,3 Q 11,2 11,4 L 10,10 Q 10,13 7,14 Z"
                      Fill="#91C8C5" Stroke="#365560" StrokeThickness="0.8" StrokeLineJoin="Round"/>
                <Path Data="M 4,9 Q 6,7 8,9" Stroke="#597888" StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>

            <!-- A queued message uses a larger full-arm wave, distinct from the answer-request pose. -->
            <Canvas x:Name="QueuedMessageArm" Width="76" Height="62" Visibility="Collapsed">
                <Canvas.RenderTransform><RotateTransform x:Name="QueuedMessageWave" CenterX="39" CenterY="36" Angle="10"/></Canvas.RenderTransform>
                <Path Data="M 39,36 Q 49,33 54,22" Stroke="#86BDBD" StrokeThickness="3.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Canvas Canvas.Left="48" Canvas.Top="8" Width="12" Height="15">
                    <Canvas.RenderTransform><ScaleTransform ScaleX="1.4" ScaleY="1.4" CenterX="6" CenterY="14"/></Canvas.RenderTransform>
                    <Path Data="M 3,14 Q 0,11 1,8 L 0,6 Q 0,4 2,5 L 3,7 L 3,2 Q 3,0 5,2 L 5,6 L 6,1 Q 7,-1 8,1 L 8,6 L 9,3 Q 11,2 11,4 L 10,10 Q 10,13 7,14 Z"
                          Fill="#B2ECE3" Stroke="#365560" StrokeThickness="0.9" StrokeLineJoin="Round"/>
                    <Path Data="M 4,9 Q 6,7 8,9" Stroke="#597888" StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Canvas>

            <Canvas x:Name="SleepMarks" Visibility="Collapsed" Opacity="0.8">
                <Canvas.RenderTransform><TranslateTransform x:Name="SleepMotion"/></Canvas.RenderTransform>
                <TextBlock Canvas.Left="46" Canvas.Top="17" Text="z" FontSize="9" FontWeight="SemiBold" Foreground="#89B9C9"/>
                <TextBlock Canvas.Left="54" Canvas.Top="8" Text="z" FontSize="12" FontWeight="SemiBold" Foreground="#A7C9D5"/>
                <TextBlock Canvas.Left="64" Canvas.Top="1" Text="z" FontSize="8" FontWeight="SemiBold" Foreground="#6D94A6"/>
            </Canvas>
            <TextBlock x:Name="StateMark" Canvas.Left="64" Canvas.Top="6" FontSize="14" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, ElementName=Robot}" Visibility="Collapsed"/>
        </Canvas>
    </Viewbox>
</UserControl>
