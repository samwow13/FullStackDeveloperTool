<Window x:Class="FullStackLauncher.Controls.DesktopContextGathererWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Gatherer" Width="440" Height="230" MinWidth="340" MinHeight="200"
        WindowStyle="ToolWindow" ResizeMode="CanResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Assets/launcher.ico"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Text="Choose an area" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="Instructions" Text="Go to any app. Hold Ctrl, then left-drag around the area you want to capture."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,8"/>
        </StackPanel>
        <Border x:Name="PreviewPanel" Grid.Row="1" Visibility="Collapsed" Background="#0B1119"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" MinHeight="120">
            <Image x:Name="CapturePreview" Stretch="Uniform" AutomationProperties.Name="Screenshot preview"/>
        </Border>
        <StackPanel Grid.Row="2" x:Name="GalleryPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock x:Name="GallerySummary" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,6"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="126">
                <ItemsControl x:Name="Gallery">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="130" Padding="5" Margin="0,0,7,0" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <StackPanel>
                                    <Button Click="Thumbnail_Click" Tag="{Binding}" Padding="2" ToolTip="Review screenshot" Background="Transparent" BorderThickness="0">
                                        <Image Source="{Binding Preview}" Height="64" Width="108" Stretch="Uniform" AutomationProperties.Name="{Binding Caption}"/>
                                    </Button>
                                    <DockPanel Margin="2,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="×" Click="Remove_Click" Tag="{Binding}" Padding="5,0"
                                                ToolTip="Remove screenshot" AutomationProperties.Name="Remove screenshot"/>
                                        <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   FontSize="12" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <WrapPanel x:Name="Actions" HorizontalAlignment="Right">
                <Button x:Name="PauseButton" Content="Pause selection" Click="Pause_Click" Margin="0,0,7,5" Padding="11,7"/>
                <Button x:Name="RetakeButton" Content="Retake" Click="Retake_Click" Visibility="Collapsed" Margin="0,0,7,5" Padding="11,7"/>
                <Button x:Name="DiscardButton" Content="Discard this capture" Click="Discard_Click" Visibility="Collapsed" Margin="0,0,7,5" Padding="11,7"/>
                <Button x:Name="CaptureButton" Content="Add another" Click="Capture_Click" Visibility="Collapsed" Margin="0,0,7,5" Padding="11,7"/>
                <Button x:Name="ConfirmButton" Content="Confirm screenshot" Click="Confirm_Click" Style="{StaticResource PrimaryButton}"
                        Visibility="Collapsed" Margin="0,0,0,5" Padding="11,7"/>
                <Button x:Name="ContinueButton" Content="Continue to prompt" Click="Continue_Click" Style="{StaticResource PrimaryButton}"
                        Visibility="Collapsed" Margin="0,0,0,5" Padding="11,7"/>
            </WrapPanel>
            <DockPanel x:Name="ClosingActions" Margin="0,3,0,0">
                <Button x:Name="DiscardBatchButton" Content="Discard all…" Click="DiscardBatch_Click" Visibility="Collapsed"
                        HorizontalAlignment="Left" Padding="8,4" FontSize="11"/>
                <Button x:Name="CloseButton" Content="Cancel gather" Click="Close_Click" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Padding="8,4" FontSize="11"/>
            </DockPanel>
            <Border x:Name="DiscardConfirmation" Visibility="Collapsed" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Discard every confirmed screenshot in this gather?" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Keep screenshots" Click="KeepBatch_Click" Margin="0,0,7,0" Padding="9,5"/>
                        <Button Content="Discard batch" Click="ConfirmDiscardBatch_Click" Style="{StaticResource DangerButton}" Padding="9,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
