<UserControl x:Class="FullStackLauncher.Controls.CodexActivityStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FullStackLauncher.Controls"
             x:Name="Crew" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             AutomationProperties.Name="Codex crew, activity for selected project">
    <UserControl.Resources>
        <Style x:Key="DismissAgentButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#F2D7A3"/>
            <Setter Property="Background" Value="#182733"/>
            <Setter Property="BorderBrush" Value="#42546B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter x:Name="WaveHand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.7,0.9">
                            <ContentPresenter.RenderTransform><RotateTransform Angle="0"/></ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#293F50"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#72E6CB"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#315A57"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Animate}" Value="True"/>
                                <Condition Binding="{Binding Opacity, RelativeSource={RelativeSource Self}}" Value="1"/>
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="False"/>
                                <Condition Binding="{Binding GoodbyeWaveEnabled, RelativeSource={RelativeSource AncestorType={x:Type controls:CodexActivityStrip}}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="GoodbyeWave">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WaveHand"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="0:0:1.6">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="-16" KeySpline="0.4,0,0.2,1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.26" Value="14" KeySpline="0.4,0,0.2,1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="-14" KeySpline="0.4,0,0.2,1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.54" Value="11" KeySpline="0.4,0,0.2,1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.66" Value="-6" KeySpline="0.4,0,0.2,1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.8" Value="0" KeySpline="0.4,0,0.2,1"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="GoodbyeWave"/></MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanClear}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ChatCard}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReplyAgentButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#A6F2DE"/>
            <Setter Property="Background" Value="#182733"/>
            <Setter Property="BorderBrush" Value="#42546B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,10,7,0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#293F50"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#72E6CB"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#315A57"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanClear}" Value="True"><Setter Property="Margin" Value="0,10,38,0"/></DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=ChatCard}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ChatCard}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThoughtHistoryButton" TargetType="Button">
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="#21464C"/>
            <Setter Property="Background" Value="#DFEEE5"/>
            <Setter Property="BorderBrush" Value="#7FABA0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#C8E3D5"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#B4D5C5"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#516D61"/>
                            <Setter TargetName="Frame" Property="Background" Value="#E8F2EC"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#B6CABE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="ThoughtBubble">
            <DockPanel Margin="4,5,7,3" Background="Transparent" Focusable="False" KeyboardNavigation.TabNavigation="None"
                        AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding ThoughtBubbleText}">
                <Canvas Height="24" Width="36" HorizontalAlignment="Left" Background="Transparent"
                        Margin="{Binding ThoughtBubbleTailMargin}" DockPanel.Dock="{Binding ThoughtBubbleTailDock}"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform ScaleY="{Binding ThoughtBubbleTailScaleY}"/></Canvas.RenderTransform>
                    <Ellipse Width="12" Height="10" Canvas.Left="0" Canvas.Top="-2" Fill="#EFFBF4" Stroke="#21464C" StrokeThickness="2"/>
                    <Ellipse Width="8" Height="7" Canvas.Left="2" Canvas.Top="10" Fill="#EFFBF4" Stroke="#21464C" StrokeThickness="1.5"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="4" Canvas.Top="20" Fill="#EFFBF4" Stroke="#21464C" StrokeThickness="1"/>
                </Canvas>
                <Border CornerRadius="20,24,20,22" Background="#EFFBF4" BorderBrush="#21464C" BorderThickness="2" Padding="12,8">
                    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
                    <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="#31645F" FontSize="10" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                Visibility="{Binding HasModelSettings, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="#111A24" CornerRadius="3" Padding="5,1" Margin="0,0,5,0"
                                Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ModelLabel}" Foreground="#C7D0DE" FontSize="10"
                                       ToolTip="{Binding ModelDescription}"/>
                        </Border>
                        <Border Background="#111A24" CornerRadius="3" Padding="5,1"
                                Visibility="{Binding HasReasoningEffort, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ReasoningEffortLabel}" Foreground="{Binding ReasoningEffortColor}"
                                       FontSize="10" FontWeight="SemiBold" ToolTip="{Binding ReasoningEffortDescription}"/>
                        </Border>
                    </StackPanel>
                    <ScrollViewer MaxHeight="{Binding ThoughtBubbleMaxHeight}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent" Padding="0,0,5,0" PreviewMouseWheel="ThoughtScroll_PreviewMouseWheel"
                                  CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False"
                                  KeyboardNavigation.TabNavigation="None" KeyboardNavigation.ControlTabNavigation="None">
                        <TextBlock Text="{Binding ThoughtBubbleText, NotifyOnTargetUpdated=True}" TargetUpdated="ThoughtMessage_TargetUpdated"
                                   Foreground="#17343B" FontSize="12" FontWeight="Medium"
                                   LineHeight="17" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <DockPanel Margin="0,6,0,0" LastChildFill="False">
                        <Button Content="{Binding HistoryCopyButtonText}" Width="70" FontSize="11" Margin="0"
                                DockPanel.Dock="Left" Style="{StaticResource ThoughtHistoryButton}"
                                IsEnabled="{Binding CanCopyHistory}" Click="CopyAgentHistory_Click"
                                ToolTip="Copy this agent's saved chat text history" AutomationProperties.Name="Copy agent chat history"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="{Binding ThoughtMessagePosition}" Foreground="#31645F" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="‹" FontSize="18" Style="{StaticResource ThoughtHistoryButton}"
                                    IsEnabled="{Binding CanShowPreviousThought}" Click="PreviousThought_Click"
                                    ToolTip="Previous message" AutomationProperties.Name="Previous agent message"/>
                            <Button Content="›" FontSize="18" Style="{StaticResource ThoughtHistoryButton}"
                                    IsEnabled="{Binding CanShowNextThought}" Click="NextThought_Click"
                                    ToolTip="Next message" AutomationProperties.Name="Next agent message"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding HistoryCopyStatus}" Foreground="#31645F" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasHistoryCopyStatus, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </DataTemplate>
        <Style x:Key="CrewViewMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/>
                                <TextBlock x:Name="SubmenuArrow" Grid.Column="2" Text="›" HorizontalAlignment="Right" Visibility="Hidden"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="156">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#293F50"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="CrewForceClearMenuItem" TargetType="MenuItem" BasedOn="{StaticResource CrewViewMenuItem}">
            <Setter Property="Foreground" Value="#F0D6A5"/>
        </Style>
        <Style x:Key="CrewViewMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="156"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
    <Border CornerRadius="11" BorderThickness="1" BorderBrush="#42546B" Margin="0,10,0,0" Padding="12,22,12,10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#18272D" Offset="0"/>
                <GradientStop Color="#171E2A" Offset="0.55"/>
                <GradientStop Color="#161D28" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid DataContext="{Binding ElementName=Crew}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding ActivityError}" Foreground="#FFACA9" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding HasActivityError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite"/>
            <ScrollViewer x:Name="AgentScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PanningMode="HorizontalOnly" PreviewMouseWheel="AgentScroller_PreviewMouseWheel"
                          Visibility="{Binding HasAgents, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="Chat activity cards; scroll horizontally for more">
                <ItemsControl ItemsSource="{Binding Agents}" Margin="0,0,0,3">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="ChatCard" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:CodexActivityStrip}}}"
                                  MinHeight="88" Margin="0,0,8,0"
                                  AutomationProperties.Name="{Binding AccessibleDescription}" AutomationProperties.HelpText="{Binding Detail}">
                                <Border CornerRadius="8" BorderThickness="1" Margin="0,8,0,7"
                                        BorderBrush="{Binding CardBorder}" Background="#111A24" Padding="8,7,11,7">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="ChatRobot" Width="68" Height="56" Background="Transparent"
                                            MouseEnter="RobotHover_Enter" MouseLeave="RobotHover_Leave"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Focusable="True"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource CrewViewMenu}"
                                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{Binding HistoryCopyMenuText}" Style="{StaticResource CrewViewMenuItem}"
                                                          IsEnabled="{Binding CanCopyHistory}" Click="CopyAgentHistory_Click" StaysOpenOnClick="True"/>
                                                <MenuItem Style="{StaticResource CrewViewMenuItem}" IsEnabled="False"
                                                          Visibility="{Binding HasHistoryCopyStatus, Converter={StaticResource BoolToVisibility}}">
                                                    <MenuItem.Header><TextBlock Text="{Binding HistoryCopyStatus}" MaxWidth="260" TextWrapping="Wrap"
                                                                               AutomationProperties.LiveSetting="Polite"/></MenuItem.Header>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <controls:CodexRobot State="{Binding State}" Animate="{Binding Animate}"
                                                             IsWaitingToSpeak="{Binding IsWaitingToSpeak}"
                                                             IsHovered="{Binding IsMouseOver, ElementName=ChatRobot}"
                                                             IsSpeaking="{Binding IsOpen, ElementName=ChatThoughtPopup}"/>
                                    </Border>
                                    <Popup x:Name="ChatThoughtPopup" PlacementTarget="{Binding ElementName=ChatRobot}" Placement="Custom"
                                           AllowsTransparency="True" StaysOpen="True" PopupAnimation="None" Focusable="False"
                                           KeyboardNavigation.TabNavigation="None" Loaded="ThoughtPopup_Loaded" Unloaded="ThoughtPopup_Unloaded">
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ThoughtBubble}"
                                                        MouseEnter="ThoughtHover_Enter" MouseLeave="ThoughtHover_Leave"
                                                        Width="300" Focusable="False" KeyboardNavigation.TabNavigation="None"/>
                                    </Popup>
                                    <Grid Grid.Column="1">
                                        <ScrollViewer MaxHeight="62" VerticalAlignment="Center"
                                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="False" PanningMode="VerticalOnly"
                                                      Visibility="{Binding HasSubagents, Converter={StaticResource BoolToVisibility}}"
                                                      AutomationProperties.Name="{Binding SubagentSummary}">
                                        <ItemsControl ItemsSource="{Binding Subagents}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="SubagentRobot" Background="Transparent" Width="34" Height="28" Margin="0,0,3,2"
                                                            MouseEnter="RobotHover_Enter" MouseLeave="RobotHover_Leave"
                                                            AutomationProperties.Name="{Binding AccessibleDescription}" AutomationProperties.HelpText="{Binding Detail}"
                                                            Focusable="True">
                                                        <Border.ContextMenu>
                                                            <ContextMenu Style="{StaticResource CrewViewMenu}"
                                                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="{Binding HistoryCopyMenuText}" Style="{StaticResource CrewViewMenuItem}"
                                                                          IsEnabled="{Binding CanCopyHistory}" Click="CopyAgentHistory_Click" StaysOpenOnClick="True"/>
                                                                <MenuItem Style="{StaticResource CrewViewMenuItem}" IsEnabled="False"
                                                                          Visibility="{Binding HasHistoryCopyStatus, Converter={StaticResource BoolToVisibility}}">
                                                                    <MenuItem.Header><TextBlock Text="{Binding HistoryCopyStatus}" MaxWidth="260" TextWrapping="Wrap"
                                                                                               AutomationProperties.LiveSetting="Polite"/></MenuItem.Header>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <!-- Scale the complete native-size control, including every animated pose. -->
                                                            <Viewbox Width="34" Height="28" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Left">
                                                                <controls:CodexRobot Width="68" Height="56" State="{Binding State}" Animate="{Binding Animate}"
                                                                                     IsWaitingToSpeak="{Binding IsWaitingToSpeak}"
                                                                                     IsHovered="{Binding IsMouseOver, ElementName=SubagentRobot}"
                                                                                     IsSpeaking="{Binding IsOpen, ElementName=SubagentThoughtPopup}"/>
                                                            </Viewbox>
                                                            <Popup x:Name="SubagentThoughtPopup" PlacementTarget="{Binding ElementName=SubagentRobot}" Placement="Custom"
                                                                   AllowsTransparency="True" StaysOpen="True"
                                                                   PopupAnimation="None" Focusable="False" KeyboardNavigation.TabNavigation="None"
                                                                   Loaded="ThoughtPopup_Loaded" Unloaded="ThoughtPopup_Unloaded">
                                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ThoughtBubble}"
                                                                                MouseEnter="ThoughtHover_Enter" MouseLeave="ThoughtHover_Leave"
                                                                                Width="300" Focusable="False" KeyboardNavigation.TabNavigation="None"/>
                                                            </Popup>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                                </Border>
                                <Border Background="#111A24" Padding="6,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Margin" Value="12,0,44,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanClear}" Value="True"><Setter Property="Margin" Value="12,0,75,0"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                </Border>
                                <Grid Margin="12,0,12,0" VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#111A24" Padding="6,0,4,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{Binding StateColor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateColor}" FontSize="10"
                                                   MaxWidth="90" TextTrimming="CharacterEllipsis" ToolTip="{Binding StateText}"/>
                                    </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#111A24" Padding="4,0" Margin="2,0,0,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding HasModel, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ModelLabel}" Foreground="#C7D0DE" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelDescription}"
                                                   AutomationProperties.Name="{Binding ModelDescription}"/>
                                    </Border>
                                    <Border Grid.Column="2" Background="#111A24" Padding="3,0,6,0" Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasReasoningEffort, Converter={StaticResource BoolToVisibility}}">
                                        <Border Background="{Binding ReasoningEffortBackground}" BorderBrush="{Binding ReasoningEffortBorder}"
                                                BorderThickness="1" CornerRadius="3" Padding="4,0">
                                            <TextBlock Text="{Binding ReasoningEffortLabel}" Foreground="{Binding ReasoningEffortColor}"
                                                       FontSize="10" FontWeight="SemiBold" ToolTip="{Binding ReasoningEffortDescription}"
                                                       AutomationProperties.Name="{Binding ReasoningEffortDescription}"/>
                                        </Border>
                                    </Border>
                                </Grid>
                                <Button Style="{StaticResource ReplyAgentButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="ReplyAgent_Click" ToolTip="Reply to this chat" AutomationProperties.Name="Reply to chat"
                                        AutomationProperties.HelpText="Save a response to this exact chat's MCP inbox and follow its receipt status.">
                                    <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource DismissAgentButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,10,7,0" Click="DismissAgent_Click"
                                        IsEnabled="{Binding CanDismissCards, RelativeSource={RelativeSource AncestorType={x:Type controls:CodexActivityStrip}}}"
                                        ToolTip="Dismiss finished chat" AutomationProperties.Name="Dismiss finished chat"
                                        AutomationProperties.HelpText="Clear this finished chat and its subagents from Codex Crew. Chat and queue history are preserved.">
                                    <TextBlock Text="👋" FontFamily="Segoe UI Emoji" FontSize="16"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="1" Height="88" CornerRadius="8" Background="#101922" BorderBrush="#293A46" BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Grid HorizontalAlignment="Center" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <controls:CodexRobot State="{Binding EmptyRobotState}" Animate="False" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding EmptyMessage}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" MaxWidth="350" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
    <Grid Margin="16,0,12,0" VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Background="{StaticResource BackgroundBrush}" VerticalAlignment="Center">
            <TextBlock Text="Codex Crew" Foreground="#A6F2DE" FontSize="15" FontWeight="SemiBold"
                       Margin="8,0" VerticalAlignment="Center"/>
            <Button Content="Start Agent" Click="StartAgent_Click" Margin="2,0,8,0" Padding="10,4"
                    IsEnabled="{Binding CanStartAgent, ElementName=Crew}"
                    AutomationProperties.Name="Start Agent" ToolTip="Start a new Codex chat for the selected project"
                    ToolTipService.ShowOnDisabled="True"/>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" BorderBrush="#42546B" BorderThickness="1" CornerRadius="5"
                Padding="8,2" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
            <controls:CodexAccountUsageView Snapshot="{Binding AccountUsage, ElementName=Crew}"/>
        </Border>
        <Button x:Name="SettingsButton" Grid.Column="2" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                DataContext="{Binding ElementName=Crew}" Click="Settings_Click" PreviewKeyDown="Settings_PreviewKeyDown"
                Width="28" Height="24" Padding="0" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                Background="{StaticResource BackgroundBrush}" BorderBrush="#42546B"
                AutomationProperties.Name="Codex Crew settings" ToolTip="Codex Crew actions and settings">
            <Button.ContextMenu>
                <ContextMenu x:Name="SettingsMenu" Style="{StaticResource CrewViewMenu}" Placement="Bottom" MinWidth="240"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Opened="SettingsMenu_Opened" Closed="SettingsMenu_Closed" PreviewKeyDown="SettingsMenu_PreviewKeyDown">
                    <MenuItem x:Name="WatcherMenuItem" Header="Codex Watcher" Click="Watcher_Click" Style="{StaticResource CrewViewMenuItem}"
                              AutomationProperties.Name="Open Codex Watcher" ToolTip="Open Codex watcher, alerts, and watched-project settings."/>
                    <MenuItem x:Name="ViewOptionsItem" Header="View" Style="{StaticResource CrewViewMenuItem}"
                              AutomationProperties.Name="View, choose chats visible at once" AutomationProperties.HelpText="{Binding ViewDescription}"
                              ToolTip="{Binding ViewDescription}">
                        <MenuItem Header="Auto (fit panel)" Tag="0" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                        <MenuItem Header="1 chat" Tag="1" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                        <MenuItem Header="2 chats" Tag="2" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                        <MenuItem Header="3 chats" Tag="3" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                        <MenuItem Header="4 chats" Tag="4" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                        <MenuItem Header="6 chats" Tag="6" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Clear" Click="Clear_Click" IsEnabled="{Binding CanClear}" Style="{StaticResource CrewViewMenuItem}"
                              AutomationProperties.Name="Clear recent finished chats"
                              ToolTip="Dismiss recent finished or interrupted chat families from this view. Active chats and their subagents stay visible. Chats and queue history are preserved."
                              ToolTipService.ShowOnDisabled="True"/>
                    <MenuItem Header="Force Clear" Click="ForceClear_Click" IsEnabled="{Binding CanForceClear}" Style="{StaticResource CrewForceClearMenuItem}"
                              AutomationProperties.Name="Force clear all tracked chats and watch for new work"
                              AutomationProperties.HelpText="{Binding ActivityDetail}"
                              ToolTip="Reset this view, including entries marked running or waiting. Old turns stay hidden across launcher restarts; new chats and new turns can appear. This does not stop Codex tasks or change queues."
                              ToolTipService.ShowOnDisabled="True"/>
                    <Separator/>
                    <MenuItem x:Name="BubbleEnabledItem" Header="Automatic thought bubbles" IsCheckable="True" StaysOpenOnClick="True"
                              Style="{StaticResource CrewViewMenuItem}" Click="BubbleEnabled_Click"/>
                    <MenuItem x:Name="BubbleDurationItem" Header="Show each update for" Style="{StaticResource CrewViewMenuItem}">
                        <MenuItem Header="3 seconds" Tag="3" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="BubbleDuration_Click"/>
                        <MenuItem Header="5 seconds" Tag="5" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="BubbleDuration_Click"/>
                        <MenuItem Header="10 seconds" Tag="10" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="BubbleDuration_Click"/>
                        <MenuItem Header="15 seconds" Tag="15" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="BubbleDuration_Click"/>
                        <MenuItem Header="30 seconds" Tag="30" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="BubbleDuration_Click"/>
                        <MenuItem Header="60 seconds" Tag="60" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="BubbleDuration_Click"/>
                        <MenuItem Header="120 seconds" Tag="120" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="BubbleDuration_Click"/>
                    </MenuItem>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>
    </Grid>
</UserControl>
