<UserControl x:Class="FullStackLauncher.Controls.CodexActivityStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FullStackLauncher.Controls"
             x:Name="Crew" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             AutomationProperties.Name="Codex crew, activity across all local chats">
    <UserControl.Resources>
        <Style x:Key="CrewViewMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Frame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="✓" Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#293F50"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="CrewViewMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="156"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border CornerRadius="11" BorderThickness="1" BorderBrush="#34484E" Padding="14,11,14,10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#18272D" Offset="0"/>
                <GradientStop Color="#171E2A" Offset="0.55"/>
                <GradientStop Color="#161D28" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid DataContext="{Binding ElementName=Crew}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"
                            ToolTip="One card per local chat. Subagents appear under their chat title, sleep when finished, and do not add to chat counts. Codex must remain open; remote and cloud-only tasks are not covered.">
                    <TextBlock Text="CODEX CREW" FontSize="11" FontWeight="Bold" Foreground="#A6F2DE"/>
                    <TextBlock Text="All local chats" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompactHeader}" Value="True">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ActivitySummary}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivitySummary}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding ActivityHint}" Foreground="{StaticResource MutedBrush}" FontSize="10"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ActivityDetail}" Margin="0,2,0,0"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.HelpText="{Binding ActivityDetail}"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Grid.Column" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NarrowHeader}" Value="True">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.Row" Value="2"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                    <Setter Property="Margin" Value="0,8,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                <Button Content="Codex Watcher" Click="Watcher_Click"
                        Padding="9,5" FontSize="11" Margin="0,0,6,0" Background="#1A2831"
                        AutomationProperties.Name="Open Codex Watcher"
                        ToolTip="Open Codex watcher, alerts, and watched-project settings."/>
                <Button x:Name="ViewButton" Content="View ▾" Click="View_Click" PreviewKeyDown="View_PreviewKeyDown"
                        Padding="9,5" FontSize="11" Margin="0,0,6,0" Background="#1A2831"
                        AutomationProperties.Name="View, choose chats visible at once" AutomationProperties.HelpText="{Binding ViewDescription}"
                        ToolTip="{Binding ViewDescription}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ViewMenu" Style="{StaticResource CrewViewMenu}" Placement="Bottom"
                                     Opened="ViewMenu_Opened" PreviewKeyDown="ViewMenu_PreviewKeyDown">
                            <MenuItem Header="Auto (fit panel)" Tag="0" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                            <MenuItem Header="1 chat" Tag="1" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                            <MenuItem Header="2 chats" Tag="2" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                            <MenuItem Header="3 chats" Tag="3" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                            <MenuItem Header="4 chats" Tag="4" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                            <MenuItem Header="6 chats" Tag="6" IsCheckable="True" Style="{StaticResource CrewViewMenuItem}" Click="ViewCount_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="Clear" Click="Clear_Click" IsEnabled="{Binding CanClear}"
                        Padding="10,5" FontSize="11" Background="#1A2831" VerticalAlignment="Center"
                        AutomationProperties.Name="Clear recent finished chats"
                        ToolTip="Dismiss recent finished or interrupted chat families from this view. Active chats and their subagents stay visible. Chats and queue history are preserved."
                        ToolTipService.ShowOnDisabled="True"/>
                <Button Content="Force Clear" Click="ForceClear_Click" IsEnabled="{Binding CanForceClear}"
                        Padding="10,5" FontSize="11" Margin="6,0,0,0" Background="#302B24" BorderBrush="#62523A" Foreground="#F0D6A5"
                        AutomationProperties.Name="Force clear all tracked chats and watch for new work"
                        AutomationProperties.HelpText="{Binding ActivityDetail}"
                        ToolTip="Reset this view, including entries marked running or waiting. Old turns stay hidden across launcher restarts; new chats and new turns can appear. This does not stop Codex tasks or change queues."
                        ToolTipService.ShowOnDisabled="True"/>
                </WrapPanel>
            </Grid>
            <ScrollViewer x:Name="AgentScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PanningMode="HorizontalOnly" PreviewMouseWheel="AgentScroller_PreviewMouseWheel"
                          Visibility="{Binding HasAgents, Converter={StaticResource BoolToVisibility}}"
                          AutomationProperties.Name="Chat activity cards; scroll horizontally for more">
                <ItemsControl ItemsSource="{Binding Agents}" Margin="0,0,0,3">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:CodexActivityStrip}}}"
                                    MinHeight="88" Margin="0,0,8,0" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{Binding CardBorder}" Background="#111A24" Padding="8,7,11,7"
                                    AutomationProperties.Name="{Binding AccessibleDescription}">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="460">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:CodexRobot State="{Binding State}" Animate="{Binding Animate}"
                                                         VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <ScrollViewer Grid.Row="1" MaxHeight="62" Margin="0,3,0,1"
                                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="False" PanningMode="VerticalOnly"
                                                      Visibility="{Binding HasSubagents, Converter={StaticResource BoolToVisibility}}"
                                                      ToolTip="{Binding SubagentSummary}" AutomationProperties.Name="{Binding SubagentSummary}">
                                        <ItemsControl ItemsSource="{Binding Subagents}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="34" Height="28" Background="Transparent" Margin="0,0,3,2"
                                                            AutomationProperties.Name="{Binding AccessibleDescription}">
                                                        <Border.ToolTip>
                                                            <ToolTip MaxWidth="380">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding StateText}" Foreground="{Binding StateColor}" Margin="0,3,0,0"/>
                                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <!-- Scale the complete native-size control, including every animated pose. -->
                                                        <Viewbox Width="34" Height="28" Stretch="Uniform" StretchDirection="Both">
                                                            <controls:CodexRobot Width="68" Height="56" State="{Binding State}" Animate="{Binding Animate}"/>
                                                        </Viewbox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Grid.Row="2" Text="{Binding TaskSummary}" FontSize="11" LineHeight="14" MaxHeight="29"
                                                   Foreground="#AFBDCF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,3"/>
                                        <DockPanel Grid.Row="3" LastChildFill="True">
                                            <Ellipse Width="5" Height="5" Fill="{Binding StateColor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateColor}" FontSize="10"/>
                                            <TextBlock Text="{Binding ProjectLabel, StringFormat= · folder: {0}}" Foreground="#899AAF" FontSize="10" TextTrimming="CharacterEllipsis"
                                                       ToolTip="Workspace folder recorded by Codex. This may be a temporary or projectless folder, not a saved launcher project."/>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="1" Height="88" CornerRadius="8" Background="#101922" BorderBrush="#293A46" BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Grid HorizontalAlignment="Center" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <controls:CodexRobot State="Idle" Animate="False" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding EmptyMessage}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" MaxWidth="350" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
