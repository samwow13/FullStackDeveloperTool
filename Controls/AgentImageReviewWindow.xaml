<Window x:Class="FullStackLauncher.Controls.AgentImageReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review capture" Width="790" Height="670" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Assets/launcher.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="CaptureTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Border Background="#0B1119" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <Image x:Name="CaptureImage" MaxHeight="390" Stretch="Uniform" AutomationProperties.Name="Captured screenshot"/>
                </Border>
                <StackPanel x:Name="CaptureDetails" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="Captured context · JSON" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="CaptureContextJson" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="210"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                             FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextBrush}" Background="#0B1119"
                             AutomationProperties.Name="Captured screenshot context JSON"/>
                </StackPanel>
                <StackPanel x:Name="BrowserDetails" Margin="0,12,0,0">
                    <CheckBox x:Name="IncludeSourceChoice" Content="Include HTML and CSS in prompt" Foreground="{StaticResource TextBrush}"
                              Checked="SourceReview_Changed" Unchecked="SourceReview_Changed"/>
                    <TextBlock x:Name="CaptureSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                    <Expander x:Name="SourceDetails" Header="Page context" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"
                              Expanded="SourceReview_Changed">
                        <TextBox x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="230"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                 FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextBrush}"
                                 AutomationProperties.Name="Captured page source and location"/>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Done" IsDefault="True" Click="Done_Click" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
