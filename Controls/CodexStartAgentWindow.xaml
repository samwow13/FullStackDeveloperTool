<Window x:Class="FullStackLauncher.Controls.CodexStartAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FullStackLauncher.Controls"
        Title="Start Agent" Width="620" SizeToContent="Height" MinWidth="460" MinHeight="440"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Assets/launcher.ico" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SpeedToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Background" Value="#202C3B"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SpeedFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#FFDB79"/>
                            <Setter Property="Background" Value="#3A3220"/>
                            <Setter Property="BorderBrush" Value="#FFDB79"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SpeedFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SpeedFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemFrame" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#293F4B"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#244A45"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="ChoiceFrame" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderThickness="1" CornerRadius="4">
                                    <TextBlock Text="▾" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}"
                                          Margin="8,5,26,5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                            <Border Background="#111923" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" CanContentScroll="False">
            <StackPanel Margin="0,0,5,0" SizeChanged="ComposerContent_SizeChanged">
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="135"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="4" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox Width="40" Height="36" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                            <controls:CodexRobot State="Idle" Animate="False" Focusable="False"/>
                        </Viewbox>
                        <Border Grid.Column="1" Background="#EFFBF4" BorderBrush="#21464C" BorderThickness="2"
                                CornerRadius="14,16,14,4" Padding="11,8">
                            <StackPanel>
                                <TextBlock x:Name="ChatModeTitle" Text="New Codex chat" Foreground="#31645F" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ProjectTitle" Foreground="#17343B" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <Label Content="_Model" Target="{Binding ElementName=ModelChoice}" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,0,0,4"/>
                        <ComboBox x:Name="ModelChoice" DisplayMemberPath="DisplayName" SelectionChanged="Model_Changed"
                                  AutomationProperties.Name="Agent model" Padding="8,5"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <Label Content="_Thinking" Target="{Binding ElementName=EffortChoice}" Foreground="{StaticResource MutedBrush}" FontSize="11" Padding="0,0,0,4"/>
                        <ComboBox x:Name="EffortChoice" DisplayMemberPath="Id" SelectionChanged="Effort_Changed"
                                  AutomationProperties.Name="Agent thinking level" Padding="8,5"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <ToggleButton x:Name="FastChoice" Style="{StaticResource SpeedToggle}" Visibility="Collapsed"
                                      Checked="Speed_Changed" Unchecked="Speed_Changed"
                                      AutomationProperties.Name="Fast" AutomationProperties.HelpText="Use Fast for this chat.">
                            <Path Width="13" Height="21" Stretch="Fill" Data="M 9,0 L 0,12 L 5,12 L 3,21 L 13,8 L 8,8 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="UltraFastChoice" Style="{StaticResource SpeedToggle}" Visibility="Collapsed"
                                      Checked="Speed_Changed" Unchecked="Speed_Changed"
                                      AutomationProperties.Name="Ultrafast" AutomationProperties.HelpText="Use Ultrafast for this chat.">
                            <Grid Width="24" Height="21">
                                <Path Width="13" Height="21" HorizontalAlignment="Left" Stretch="Fill" Data="M 9,0 L 0,12 L 5,12 L 3,21 L 13,8 L 8,8 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                <Path Width="13" Height="21" HorizontalAlignment="Right" Stretch="Fill" Data="M 9,0 L 0,12 L 5,12 L 3,21 L 13,8 L 8,8 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </Grid>
                        </ToggleButton>
                        <Button x:Name="SettingsButton" Content="&#xE713;" Click="Settings_Click"
                            FontFamily="Segoe MDL2 Assets" FontSize="16" Width="36" Height="36" Padding="0"
                            Margin="8,0,0,0" VerticalAlignment="Bottom"
                            ToolTip="Agent settings" AutomationProperties.Name="Agent settings"/>
                    </StackPanel>
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                           VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Opened="SettingsPopup_Opened">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Width="330"
                                TextElement.Foreground="{StaticResource TextBrush}" KeyboardNavigation.TabNavigation="Cycle"
                                PreviewKeyDown="SettingsPopup_PreviewKeyDown">
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="×" Click="CloseSettings_Click" Padding="7,2" FontSize="14"
                                                AutomationProperties.Name="Close agent settings"/>
                                        <TextBlock Text="Agent settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Label Content="_Access" Target="{Binding ElementName=AccessChoice}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" Padding="0,0,10,0" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="AccessChoice" Width="150" HorizontalAlignment="Left" Padding="8,4"
                                                  SelectionChanged="Access_Changed" AutomationProperties.Name="Agent access"
                                                  ToolTip="Workspace limits file writes to this project. Full access allows commands and file access outside this project. Both run without approval prompts; choose the access you want before starting."/>
                                    </DockPanel>
                                    <CheckBox x:Name="KeepAwakeChoice" Content="_Keep awake" Margin="0,0,0,12" FontSize="12"
                                              Foreground="{StaticResource TextBrush}"
                                              AutomationProperties.Name="Keep agent awake"
                                              ToolTip="Send &quot;Keep Going&quot; after each successful turn until Keep awake is unchecked in Codex Crew. Pauses on requests for input, failure, or an uncertain outcome. Turning it off lets the current turn finish."/>
                                    <Expander x:Name="ContextExpander" Header="Project context" Foreground="{StaticResource TextBrush}">
                                        <StackPanel Margin="0,9,0,0">
                                            <TextBox x:Name="ContextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75" MaxHeight="160"
                                                     Foreground="{StaticResource TextBrush}"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="12"
                                                     TextChanged="Context_Changed" AutomationProperties.Name="Saved context for this project"
                                                     ToolTip="Saved for this project and included with every new agent message."/>
                                            <DockPanel Margin="0,7,0,0">
                                                <Button x:Name="SaveContextButton" DockPanel.Dock="Right" Content="Save context" Click="SaveContext_Click"
                                                        Padding="9,5" FontSize="11" Margin="8,0,0,0"/>
                                                <TextBlock x:Name="ContextStatus" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>
                                    <Button x:Name="RetryChoicesButton" Content="Retry loading choices" Click="RetryChoices_Click"
                                            Margin="0,12,0,0" HorizontalAlignment="Left" Padding="9,7" Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <Border MinHeight="170" CornerRadius="20,20,5,20" Padding="14,10"
                        Background="#162A2B" BorderThickness="1">
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#3B605B"/>
                        <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger></Style.Triggers>
                    </Style></Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <StackPanel x:Name="MicrophoneLevelPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Live input level from the default microphone">
                                    <TextBlock Text="Mic" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <ProgressBar x:Name="MicrophoneLevel" Width="64" Height="8" Minimum="0" Maximum="100"
                                                 Foreground="{StaticResource AccentBrush}" Background="#101D20" BorderThickness="0"
                                                 AutomationProperties.Name="Microphone input level">
                                        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
                                            <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                                                <Border x:Name="PART_Track"/>
                                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </ControlTemplate></ProgressBar.Template>
                                    </ProgressBar>
                                    <TextBlock x:Name="MicrophoneLevelText" Text="0%" Width="32" TextAlignment="Right" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="RecordButton" Content="_Record" Click="Record_Click" Padding="8,4" MinWidth="104"
                                        FontSize="11" MinHeight="28" ToolTip="Dictate with the default Windows microphone. Typing stays available."
                                        AutomationProperties.Name="Record dictation"/>
                            </StackPanel>
                            <Label Content="M_essage" Target="{Binding ElementName=PromptBox}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Padding="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl x:Name="MessageImages" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#101D20" BorderBrush="#3B605B" BorderThickness="1" CornerRadius="6"
                                        Padding="4" Margin="0,0,8,6" ToolTip="{Binding Caption}">
                                    <Grid Width="158">
                                        <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Button Click="ReviewMessageImage_Click" Tag="{Binding Id}" Padding="2" Background="#101D20"
                                                ToolTip="Review screenshot and page context" AutomationProperties.Name="{Binding Caption}">
                                            <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                        </Button>
                                        <Button Content="×" Click="RemoveMessageImage_Click" Tag="{Binding Id}" Width="22" Height="22"
                                                Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#E6101D20" Foreground="{StaticResource TextBrush}"
                                                IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                ToolTip="Remove image" AutomationProperties.Name="Remove attached image"/>
                                        <TextBlock Grid.Row="1" Text="{Binding ContextSummary}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10" Margin="2,5,2,1" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Grid.Row="2">
                            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent"
                                     Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                     BorderThickness="0" Padding="0" FontSize="13" MinHeight="130" MaxHeight="300"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="New agent message" TextChanged="Prompt_Changed"
                                     CommandManager.PreviewCanExecute="Message_PreviewCanExecute"
                                     CommandManager.PreviewExecuted="Message_PreviewExecuted"
                                     DataObject.Pasting="Message_Pasting"
                                     ToolTip="Write your message here. Paste images with Ctrl+V or Paste; attached images appear above your text.">
                                <TextBox.Template><ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
                                </ControlTemplate></TextBox.Template>
                            </TextBox>
                            <TextBlock Text="What should this agent work on?" Foreground="#91AAA7" IsHitTestVisible="False" TextWrapping="Wrap">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=PromptBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="DictationPreview" Grid.Row="3" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="64" Visibility="Collapsed"
                                   AutomationProperties.Name="Live dictation"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <TextBox x:Name="StatusText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                 Background="Transparent" Foreground="{StaticResource MutedBrush}" Padding="0" Margin="0,10,5,0"
                 MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 Visibility="Collapsed" AutomationProperties.Name="Agent start status" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="ContextGathererStatus" Grid.Row="2" Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Margin="0,8,5,0" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        <WrapPanel Grid.Row="3" Margin="0,0,5,0">
            <Button x:Name="CheckStatusButton" Content="Check status" Click="CheckStatus_Click" Visibility="Collapsed"
                    Padding="9,7" FontSize="11" Margin="0,10,0,0"/>
            <Button x:Name="ReviewButton" Content="Review submission…" Click="Review_Click" Visibility="Collapsed"
                    Padding="9,7" FontSize="11" Margin="6,10,0,0"/>
            <Button x:Name="NewChatButton" Content="New chat" Click="NewChat_Click" Visibility="Collapsed"
                    Padding="9,7" FontSize="11" Margin="6,10,0,0" ToolTip="Return to your new chat draft; the saved submission is kept"/>
        </WrapPanel>
        <Grid Grid.Row="4" Margin="0,12,5,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ContextGathererButton" Content="Context _Gatherer" Click="ContextGatherer_Click" Padding="9,7" FontSize="11"
                    MinHeight="36" HorizontalAlignment="Left" Margin="0,0,12,0"
                    Background="#203F61" BorderBrush="#5E9DCE" Foreground="#C3E5FF"
                    ToolTip="Capture any desktop app. Hold Ctrl and drag from the top-left corner, then release to review. Confirm, retake, or add more screenshots before writing your prompt."
                    AutomationProperties.Name="Context Gatherer"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Margin="0,0,8,0"/>
                <Button x:Name="WaitButton" Content="_Wait &amp; next" Click="Wait_Click" Margin="0,0,8,0"
                        IsEnabled="False" ToolTip="Save this prompt to Waiting and start writing the next one. Your agent choices stay selected. Use Go on the main screen when ready."
                        AutomationProperties.Name="Save prompt to Waiting and write the next prompt"/>
                <Button x:Name="StartButton" Content="_Start Agent" Style="{StaticResource PrimaryButton}"
                        Click="Start_Click" IsEnabled="False" ToolTip="Start a new Codex chat (Ctrl+Enter)"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
