<UserControl x:Class="FullStackLauncher.Controls.CommitHammerRobot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="96" Height="92"
             IsHitTestVisible="False" Focusable="False" IsTabStop="False"
             UseLayoutRounding="True"
             AutomationProperties.Name="Robot adding commit message">
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Artwork" Width="96" Height="92" Opacity="0">
            <Ellipse Canvas.Left="13" Canvas.Top="83" Width="51" Height="5" Fill="#0B121C" Opacity="0.75"/>

            <Canvas Width="70" Height="92">
                <Canvas.RenderTransform><TranslateTransform x:Name="BodyMotion"/></Canvas.RenderTransform>
                <Path Data="M 26,69 L 22,79 M 37,69 L 41,79"
                      Stroke="#597888" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Border Canvas.Left="16" Canvas.Top="78" Width="17" Height="7" CornerRadius="3,3,2,2"
                        Background="#293D49" BorderBrush="#86BDBD" BorderThickness="1"/>
                <Border Canvas.Left="35" Canvas.Top="78" Width="19" Height="7" CornerRadius="3,3,2,2"
                        Background="#293D49" BorderBrush="#86BDBD" BorderThickness="1"/>
                <Path Data="M 22,81 L 27,81 M 42,81 L 48,81" Stroke="#78ACAC" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <Path Data="M 27,48 L 27,56 M 36,48 L 36,56" Stroke="#607A89" StrokeThickness="3"/>
                <Path Data="M 23,54 Q 13,60 18,67" Stroke="#597888" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="15" Canvas.Top="64" Width="9" Height="7" Fill="#91C8C5" Stroke="#365560" StrokeThickness="1"/>
                <Border Canvas.Left="21" Canvas.Top="53" Width="23" Height="21" CornerRadius="6,6,4,4"
                        Background="#293D49" BorderBrush="#607A89" BorderThickness="1.2"/>
                <Border Canvas.Left="25" Canvas.Top="57" Width="15" Height="12" CornerRadius="3"
                        Background="#192C37" BorderBrush="#48636F" BorderThickness="0.8"/>
                <Path Data="M 28,61 L 31,63 L 28,65 M 34,65 L 37,65" Stroke="#72E5C3" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Rectangle Canvas.Left="29" Canvas.Top="71" Width="9" Height="2" RadiusX="1" RadiusY="1" Fill="#78ACAC"/>
                <Ellipse Canvas.Left="38" Canvas.Top="49" Width="9" Height="9" Fill="#35505B" Stroke="#86BDBD" StrokeThickness="1.2"/>
            </Canvas>

            <Canvas Width="70" Height="62">
                <Canvas.RenderTransform><RotateTransform x:Name="HeadTilt" CenterX="32" CenterY="49"/></Canvas.RenderTransform>
                <Path Data="M 30,25 L 30,19" Stroke="#7797A5" StrokeThickness="1.7"/>
                <Ellipse Canvas.Left="27.5" Canvas.Top="15" Width="5" Height="5" Fill="#72E5C3"/>
                <Rectangle Canvas.Left="11" Canvas.Top="33" Width="6" Height="10" RadiusX="2" RadiusY="2" Fill="#597887"/>
                <Border Canvas.Left="15" Canvas.Top="25" Width="38" Height="27" CornerRadius="8"
                        Background="#35505B" BorderBrush="#86BDBD" BorderThickness="1.2"/>
                <Path Data="M 20,29 L 24,29 M 19,33 L 19,43" Stroke="#78ACAC" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.7"/>
                <Border Canvas.Left="26" Canvas.Top="29" Width="26" Height="19" CornerRadius="5"
                        Background="#111F2A" BorderBrush="#294552" BorderThickness="0.8"/>
                <Rectangle Canvas.Left="32" Canvas.Top="34" Width="4" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="#72E5C3"/>
                <Rectangle Canvas.Left="44" Canvas.Top="34" Width="4" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="#72E5C3"/>
                <Path Data="M 38,42 Q 41,44 44,42" Stroke="#72E5C3" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>

            <!-- The hammer's leading face lands at (86,52), aligned with the dock edge. -->
            <Canvas Width="96" Height="92">
                <Canvas.RenderTransform><RotateTransform x:Name="HammerSwing" CenterX="43" CenterY="52" Angle="-25"/></Canvas.RenderTransform>
                <Path Data="M 43,52 Q 51,47 59,51" Stroke="#86BDBD" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 59,51 L 82,51" Stroke="#6E4C36" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 59,50 L 81,50" Stroke="#D6B276" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 63,49 L 63,53 M 67,49 L 67,53" Stroke="#B78D58" StrokeThickness="0.8"/>
                <Ellipse Canvas.Left="53" Canvas.Top="47" Width="11" Height="9" Fill="#B2ECE3" Stroke="#365560" StrokeThickness="1"/>
                <Path Data="M 57,50 L 60,50 M 57,53 L 60,53" Stroke="#597888" StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 79,43 L 84,43 L 86,45 L 86,59 L 79,59 Z"
                      Fill="#A8C2CE" Stroke="#536F7C" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                <Path Data="M 81,46 L 83,46 L 83,56" Stroke="#D9EEF2" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 79,44 L 74,43 L 71,46 L 75,46 L 79,48 Z"
                      Fill="#7E9AA7" Stroke="#536F7C" StrokeThickness="0.8" StrokeLineJoin="Round"/>
            </Canvas>

            <Canvas x:Name="Sparks" Width="96" Height="92" Opacity="0">
                <Canvas.RenderTransform><ScaleTransform x:Name="SparkExpansion" CenterX="86" CenterY="52" ScaleX="0.7" ScaleY="0.7"/></Canvas.RenderTransform>
                <Path Data="M 86,48 L 87,51 L 90,52 L 87,53 L 86,56 L 85,53 L 82,52 L 85,51 Z"
                      Fill="#FFF0BD"/>
                <Path Data="M 83,47 L 80,43 M 90,48 L 93,45 M 91,55 L 94,58 M 85,59 L 85,62"
                      Stroke="#E7C179" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 88,42 L 89,40 M 77,55 L 75,56" Stroke="#72E5C3" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
