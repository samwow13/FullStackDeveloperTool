<Window x:Class="FullStackLauncher.Controls.CodexWaitingAgentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waiting prompts" Width="900" Height="690" MinWidth="640" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="pack://application:,,,/Assets/launcher.ico" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemFrame" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#293F4B"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#244A45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Padding="9,5"/>
            <StackPanel>
                <TextBlock Text="Waiting prompts" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,8,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="WaitingList" SelectionChanged="WaitingList_SelectionChanged"
                         Background="#111923" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Saved waiting prompts across projects">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/>
                            <TextBlock Text="{Binding PromptTitle}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="No waiting prompts saved." Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DetailsPanel" Margin="0,0,5,0" Visibility="Collapsed">
                    <TextBlock x:Name="ProjectTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SavedAtText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,10"/>
                    <TextBlock Text="Message" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="PromptText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="145" MaxHeight="245" Foreground="{StaticResource TextBrush}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Saved prompt message"/>
                    <Expander Header="Saved project context" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0">
                        <TextBox x:Name="ContextText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="70" MaxHeight="160" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Project context saved with this prompt"/>
                    </Expander>
                    <TextBlock x:Name="SettingsText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
                    <TextBox x:Name="FolderText" IsReadOnly="True" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                             BorderThickness="0" Background="Transparent" Padding="0" Margin="0,5,0,0"
                             AutomationProperties.Name="Saved project folder"/>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <ItemsControl x:Name="ImageList" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Click="ReviewImage_Click" Tag="{Binding Attachment}" Padding="5" Margin="0,0,8,8"
                                    Background="#111923" ToolTip="Review saved screenshot and captured page context"
                                    AutomationProperties.Name="{Binding Caption}">
                                <StackPanel Width="128">
                                    <Image Source="{Binding Preview}" Height="78" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Caption}" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   FontSize="11" Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Click="Close_Click" MinWidth="75"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RemoveButton" Content="Remove selected" Click="Remove_Click" IsEnabled="False"/>
                <Button x:Name="ReviewButton" Content="Review submission…" Click="ReviewSubmission_Click" Margin="8,0,0,0"
                        Visibility="Collapsed" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
