<UserControl x:Class="FullStackLauncher.Controls.ConsoleOutput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="156" Foreground="#E0EBE8"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Border Background="#080F13" BorderBrush="#29483F" BorderThickness="1" CornerRadius="8">
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="72"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,7">
                <TextBlock Text="▌ CONSOLE" Foreground="#79E8B3" FontFamily="Consolas" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,18,3"/>
                <CheckBox x:Name="FollowToggle" Content="Follow output" IsChecked="True" Foreground="#C2D6CF"
                          VerticalAlignment="Center" Margin="0,0,16,3" Checked="FollowChanged" Unchecked="FollowChanged"
                          ToolTip="Scroll with new output. Scroll up to pause; re-enable to jump to the latest line."/>
                <Button x:Name="CopyButton" Content="Copy all" Padding="9,4" Margin="0,0,6,3"
                        FontSize="11" Background="#12221F" BorderBrush="#315449" Foreground="#D4E9E2"
                        Click="CopyAllClick" ToolTip="Copy the retained output with timestamps and labels"/>
                <Button Content="Clear" Padding="9,4" Margin="0,0,0,3"
                        FontSize="11" Background="#12221F" BorderBrush="#315449" Foreground="#D4E9E2"
                        Click="ClearClick" ToolTip="Clear this console's retained output"/>
            </WrapPanel>
            <WrapPanel Grid.Row="1" Margin="0,0,0,8" TextElement.FontFamily="Consolas" TextElement.FontSize="10.5">
                <TextBlock Text="&gt; COMMAND" Foreground="#79DEFF" Margin="0,0,14,2"/>
                <TextBlock Text="· OUTPUT" Foreground="#E0EBE8" Margin="0,0,14,2"/>
                <TextBlock Text="+ SUCCESS" Foreground="#79E8B3" Margin="0,0,14,2"/>
                <TextBlock Text="! WARNING" Foreground="#F3CD80" Margin="0,0,14,2"/>
                <TextBlock Text="× ERROR" Foreground="#FF929B" Margin="0,0,14,2"/>
                <TextBlock Text="i INFO" Foreground="#B9B1FF" Margin="0,0,0,2"/>
            </WrapPanel>
            <Grid Grid.Row="2">
                <RichTextBox x:Name="OutputText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             IsUndoEnabled="False" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="#E0EBE8" SelectionBrush="#367060" SelectionOpacity="0.65"
                             FontFamily="Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" ScrollViewer.ScrollChanged="OutputScrolled"
                             PreviewMouseWheel="OutputMouseWheel" PreviewKeyDown="OutputKeyDown"
                             AutomationProperties.Name="Console output" SpellCheck.IsEnabled="False">
                    <FlowDocument PagePadding="0" FontFamily="Consolas" FontSize="12.5" LineHeight="19"/>
                </RichTextBox>
                <TextBlock x:Name="EmptyState" Text="Waiting for output. Commands and their results appear here."
                           Foreground="#8AA59B" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           IsHitTestVisible="False" Margin="2,8,12,0" VerticalAlignment="Top"/>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#8AA59B" FontSize="10.5" Margin="0,7,0,0"
                       TextWrapping="Wrap" Text="0 lines · Following output"/>
        </Grid>
    </Border>
</UserControl>
